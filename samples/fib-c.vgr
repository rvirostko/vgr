#! python3 -m vgr

//---------------------------------------------------------------------
// Calculate and display Fibonacci numbers from fib(0) to fib(8)
// Derived from 'C' code, but not looking very much like it...
//---------------------------------------------------------------------

set fib0 = 0;
set fib1 = 0;
set i = 0;
while(i <= 8):
    set fib = (i > 0 && i <= 2) ? 1 : fib0 + fib1;
    printf "fib({}) = {}\n", i, fib;
    set fib0 = fib1;
    set fib1 = fib;
    set i += 1;
end;
