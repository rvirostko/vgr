//-----------------------------------------------------------------------------
// Tests program for
//   * Reset
//   * Source stack
//   * Terminal functions including size retrieval
//   * Terminal positioning
//   * ReverseStr(), TranslateStr(), Min()/Max()
//-----------------------------------------------------------------------------

# This is visual, so if it can't display anything...
If !vgr.stdout.isatty
    Print "stdout is not a TTY"
    Exit
End-If

Reset Data
Assert vgr.source.FirstItem() Is Not None
# ASCII art file should be stored in the same dir as this script
# so use the source name's directory to always find it
Load sse from vgr.source.FirstItem().DirectoryName() + "/NCC-1701A.txt" Type Is Text Lines
Set sse_max To sse.StringLen().Max()
Set sse To sse.LeftJustify(sse_max)

# Command line controllable options
# Apply default and contstrain range
Set fps To args.Item(0).DefaultTo(30).Max(1).Min(60)
Set loops To args.Item(1).DefaultTo(32).Max(1).Min(128)

# Clear the screen and start!
Terminal SetBackground "Gray15", SetForeground "Green3", ClearScreen, HideCursor
For scene = Zero To loops
    # We recalc line on every scene in case for when the window is resized
    Terminal GetTerminalSize
    Assert term.size Is Not None: "Can't determine screen size"
    Set line To ((term.size.rows - sse.Length()) / 3).ToInteger()
    If scene Is Positive
        # Flip the art
        Set sse To sse.ReverseStr().TranslateStr("/\\'`", "\\/`'")
        # Increase speed, but limit it
        Set fps To (fps * (5/4)).Min(600).ToInteger().Round(-1)
        # Pause for six frames
        Sleep 1 / (fps / 6) Second
    End-If
    Terminal HomeCursor
    Printf "Delay: 1/{}s", fps.ToInteger()
    Terminal EraseEOS
    If scene.Mod(2)
        # Right-to-Left movement
        For frame = 1 To (sse.FirstItem().Length() + term.size.cols)
            For j = Zero To sse.Length() - 1
                Set l to (2 * line) + j
                If frame <= sse_max
                    Terminal MoveCursorTo l:(term.size.cols - frame)
                    Printf sse.Item(j).LeftStr(frame)
                Else
                    Terminal MoveCursorTo l:1, DeleteChar 1
                End-If
            Next
            Sleep 1 / fps Second
        Next
    Else
        # Left-to-Right movement
        For frame = 1 To (sse.FirstItem().Length() + term.size.cols)
            For j = Zero To sse.Length() - 1
                Set l to line + j
                If frame <= sse_max
                    Terminal MoveCursorTo l:1
                    Printf sse.Item(j).RightStr(frame)
                Else
                    Terminal MoveCursorTo l:1, InsertChar 1
                End-If
            Next
            Sleep 1 / fps Second
        Next
    End-If
Next

Terminal SetBackground None, SetForeground None, ClearScreen, ShowCursor
