For-Each value In [ 0, 0.0, False, "0", 1, 1.0, True, "1"]
    Print "Value:", Repr(value)
    Print "-" * 60
    Print "\tToBoolean() ->", ToBoolean(value).Repr()
    Print "\tToInteger() ->", ToInteger(value).Repr()
    Print "\tToFloat()   ->", ToFloat(value).Repr()
    Print "\tToNumber()  ->", ToNumber(value).Repr()
    Print "\tToString()  ->", ToString(value).Repr()
    Print ""
End-For
