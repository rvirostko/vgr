
Echo On

// Equality
Assert 1 == 1
Assert 1 ⩵ 1
Assert 1 Equals 1
Assert 1 Is 1
Assert 1 Equal To 1
Assert 1 Is Equal To 1

// Inequality
Assert 1 != Zero
Assert 1 ≠ Zero
Assert 1 <> Zero
Assert 1 ¬= Zero
Assert 1 Is Not Zero
Assert 1 Not Equal To Zero
Assert 1 Is Not Equal To Zero

// Greater than
Assert 1 > Zero
Assert 1 ＞ Zero
Assert 1 Greater Than Zero
Assert 1 Is Greater Than Zero

// Greater than or equal to
Assert 1 >= 1
Assert 1 ≥ 1
Assert 1 ¬< 1
Assert 1 !< 1
Assert 1 Not Less Than 1
Assert 1 Is Not Less Than 1

// Less than
Assert Zero < 1
Assert Zero ＜ 1
Assert Zero Less Than 1
Assert Zero Is Less Than 1

// Less than or equal to
Assert 1 <= 1
Assert 1 ≤ 1
Assert 1 ¬> 1
Assert 1 !> 1
Assert 1 Not Greater Than 1
Assert 1 Is Not Greater Than 1

// Even/odd checks
Assert 1 Is Odd
Assert 1 Is Not Even
Assert 1 Not Even
Assert 2 Is Even
Assert 2 Is Not Odd
Assert 2 Not Odd

// Negative/Positive checks
Assert 1 Is Positive
Assert 1 Is Not Negative
Assert 1 Not Negative
Assert -1 Is Negative
Assert -1 Is Not Positive
Assert -1 Not Positive

# Zero is "weird"
Assert !(Zero Is Positive) And !(Zero Is Negative)
Assert !(Zero Is Not Negative) And !(Zero Is Not Positive)

// Defined/Undefined
Set x.is_defined To "yes"
Unset x.is_not_defined
Assert x Is Defined
Assert x.is_defined Is Defined
Assert x.is_defined Is Not Undefined
Assert x.is_not_defined Is Undefined
Assert x.is_not_defined Is Not Defined
// expressions that are not just a variable
// are always "defined"
Assert 5 Is Defined
Assert False Is Defined
Assert None Is Defined
Assert (2 + 3) Is Defined

// Null (or None) : see equality for other forms
Assert None Is Null
Assert "none" Is Not Null

// Empty/Not Empty
Assert [] Is Empty
Assert ["x"] Is Not Empty
Assert ["x"] Not Empty

// Matching (case sensitive)
Assert "a" ~ "a"
Assert "a" Matches "a"
Assert "A" !~ "a"
Assert "A" Not ~ "a"
Assert "A" Does Not Match "a"

// Multiple matching
Assert "Abc" Matches All ["^[Aa]", "[Cc]$"]

// Matching (case insenstive)
Assert "A" ~* "a"
Assert "A" IMatches "a"
Assert ("A" !~* "a") Is False
Assert ("A" Not ~* "a") Is False
Assert ("A" Does Not IMatch "a") Is False

// Contains
Set animals To ["cat", "dog", "fish"]
Assert animals Contains "cat"
Assert animals Contains ["bat", "cat", "rat"]
Assert animals Contains All ["cat", "dog"]
Assert animals Does Not Contain "frog"

// Is In
Assert "cat" Is In animals
Assert "dog" ∈ animals
Assert "bat" Is Not In animals
Assert "frog" ∉ animals

// Exact Equals
Assert True === True
Assert (True === 1) Is False

Echo Off
# TODO '>=' not supported between instances of 'dict' and 'int'
# TODO print 7 is True -> False; print 7 ? "t" : "f" -> "t"
For Each value In [-1, 0, False, 1, /*{}, [],*/ 7, 16]
    Choose All Using value
        When Is Defined             Pass // everything here is defined
        When Is Undefined           Assert False : "Can't be undefined here!"
        When Is Empty               Print value.Repr(), "is empty"
        When Is Not Empty           Print value.Repr(), "is not empty"
        When Is Positive            Print value.Repr(), "is positive"
        When Is Not Positive        Print value.Repr(), "is not positive"
        When Is Negative            Print value.Repr(), "is negative"
        When Is Not Negative        Print value.Repr(), "is not negative"
        When Is Even                Print value.Repr(), "is even"
        When Is Not Even            Print value.Repr(), "is not even"
        When Is Odd                 Print value.Repr(), "is odd"
        When Is Not Odd             Print value.Repr(), "is not odd"
        When Is True                Print value.Repr(), "is True-like"
        When Is False               Print value.Repr(), "is False-like"
        When Is Not False           Print value.Repr(), "is not False-like"
        // NB: we don't have a separate "Not ===" operation here or in expressions
        When === True, False        Print value.Repr(), "is a boolean"
        When == 6                   Print value.Repr(), "is 6"
        When != 6                   Print value.Repr(), "is not 6"
        When Is Greater Than 7      Print value.Repr(), "is > 7"
        When Is Less Than 7         Print value.Repr(), "is < 7"
        When Is Not Greater Than 7  Print value.Repr(), "is <= 7"
        When Is Not Less Than 7     Print value.Repr(), "is >= 7"
        When Is Equal To 7          Print value.Repr(), "is 7"
        When Is Not Equal To 7      Print value.Repr(), "is not 7"
        When Is 2,1,0               Print value.Repr(), "is a small number"
        When 1,2,3,5,7,11,13,17     Print value.Repr(), "is a prime < 20"
        When Not 2,4,8              Print value.Repr(), "is not an even number < 10"
        When 11 To 19               Print value.Repr(), "is between 10 and 20 (exclusive)"
        When 10 Through 20          Print value.Repr(), "is between 10 and 20 (inclusive)"
        When Not 1 Thru 10          Print value.Repr(), "isn't 1 to 10"
        Otherwise                   Print value.Repr(), "is something else"
    End-Choose
    Print ""
End-For

Choose All Using animals
    When Contains "cat"                   Print "We have a cat"
    When Does Not Contain "rat", "bat"    Print "We don't have a rat or a bat"
    When Contains "rat", "dog"            Printf "We have a {}\n", animals.Contains("rat") ? "rat" : "dog"
    When Contains All "cat", "dog"        Print "We have a cat and a dog"
End-Choose
Print ""

For Each animal In ["cat", "donkey"]
    Choose All Using animal
        When Is In animals                    Print animal.Repr(), "is included in", animals.Repr()
        When ∈ animals                        Print animal.Repr(), "is an element of", animals.Repr() // syntactic not semantic difference
        When Is Not In animals                Print animal.Repr(), "isn't included in", animals.Repr()
        When Not In animals                   Print animal.Repr(), "isn't included in", animals.Repr()
        When ∉ animals                        Print animal.Repr(), "not an element of", animals.Repr() // syntactic not semantic difference
        When Matches "^d", "t$"               Print animal.Repr(), "starts with 'd' or ends with 't"
        When ~ "y"                            Print animal.Repr(), "has an 'y' in it"
        When Does Not Match "^a", "^b"        Print animal.Repr(), "doesn't start with 'a' or 'b'"
        When Not ~ "x$", "y$", "z$"           Print animal.Repr(), "doesn't end with 'x', 'y', or 'z'"
        When !~ "[A-Z]"                       Print animal.Repr(), "has no capital letters"
        When Matches All "^[cd]", "[aeiouy]$" Print animal.Repr(), "starts with 'c' or 'd' and ends with a vowel"
        When IMatches "[AEIOU]"               Print animal.Repr(), "has a vowel in it"
        When ~* "Key", "At"                   Print animal.Repr(), "has 'At' or 'Key' in it"
        When Does Not IMatch "A", "B", "C"    Print animal.Repr(), "doesn't have 'a', 'b', or 'c' in it"
        When Not ~* "Z"                       Print animal.Repr(), "doesn't have 'z' in it"
        When !~* "X"                          Print animal.Repr(), "doesn't have 'x' in it"
    End-Choose
    Print ""
End-For

Unset not_set
Choose Using not_set
    When Is Defined   Assert False : "Should be undefined"
    When Is Undefined Exhibit not_set
    Otherwise         Assert False : "SNO"
End-Choose
Print ""

Set is_set To "set"
Choose Using is_set
    When Is Defined   Exhibit is_set
    When Is Undefined Assert False : "Should be undefined"
    Otherwise         Assert False : "SNO"
End-Choose
Print ""

For Each echo_setting In [False, True]
    Echo echo_setting
    // Edge conditions : No "When"s
    Choose Using True
        Otherwise ;
    End-Choose
    Choose All Using True
        Otherwise ;
    End-Choose
    Choose
        Otherwise ;
    End-Choose
    Choose All
        Otherwise ;
    End-Choose

    // Edge condition : No "When"s and no "Otherwise"
    Choose Using True
        // nothing
    End-Choose
    Choose All Using True
        // nothing
    End-Choose
    Choose
        // nothing
    End-Choose
    Choose All
        // nothing
    End-Choose

    Echo Off
End-For
