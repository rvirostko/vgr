Reset All

Set a To [1,2,3]
Set b To a

Echo On
Set c To a + 2
Echo Off
Exhibit a, c
Assert a == b && a != c && b != c
Print ""

Echo On
Set c To a + b
Echo Off
Exhibit a, b, c
Assert a == b && a != c && b != c
Print ""

Echo On
Set c To a - 2
Echo Off
Exhibit a, c
Assert a == b && a != c && b != c
Print ""

Echo On
Set c To a * b
Echo Off
Exhibit a, b, c
Assert a == b && a != c && b != c
Print ""

Echo On
Set c To a / 2
Echo Off
Exhibit a, c
Assert a == b && a != c && b != c
Print ""

Echo On
Set c To a.FloorDiv(2)
Echo Off
Exhibit a, c
Assert a == b && a != c && b != c
Print ""

Echo On
Set c To a.DivMod(2)
Echo Off
Exhibit a, c
Assert a == b && a != c && b != c
Print ""

Echo On
Set c To a % 2
Echo Off
Exhibit a, c
Assert a == b && a != c && b != c
Print ""

Echo On
Set c To a ** 2
Echo Off
Exhibit a, c
Assert a == b && a != c && b != c
Print ""

Echo On
Set c To a.Sum()
Echo Off
Exhibit a, c
Assert a == b && a != c && b != c
Print ""

Echo On
Set b To (a * 2 * Random(1, 100).Div(10)).Round(3)
Set c To [b.Min(), b.Mean().Round(3), b.Max()]
Set d To b.Variance().Round(3)
Set e To b.PVariance().Round(3)
Set f To b.StDev().Round(3)
Echo Off
Exhibit a, b, c, d, e, f
Print ""
