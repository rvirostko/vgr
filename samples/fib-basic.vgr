#----------------------------------------------------------------------
# Calculate and display Fibonacci numbers from fib(0) to fib(8)
# Since we don't use ";" between print params to
# indicate "no space", it has been converted to
# "," and ofs is set to nothing.
Set env.OFS To ""
#----------------------------------------------------------------------

SET fib0 TO 0
SET fib1 TO 0
SET i TO 0
WHILE i <= 8
    IF i > 0 AND i <= 2
        SET fib2 TO 1
    ELSE
        SET fib2 TO fib0 + fib1
    END
    SET fib0 TO fib1
    SET fib1 TO fib2
    PRINT "fib(", i, ") = ", fib2
    SET i TO i + 1
END
