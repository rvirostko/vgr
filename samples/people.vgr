Set filename To vgr.source.FirstItem().DirectoryName() + "/people.json"
Set limit To 10

Set env.OFS To ''
Set env.ORF To Newline

Print "Reading from ", filename, "..."
Load people From File filename
Print $load.records, " record", $load.records.Plural()

Print Newline, "Original, first ", limit
Select
    RightJustify($rec-index + 1, 2) As "",
    RightJustify(age.DefaultTo(Space), 3) As "Age",
    last_name.DefaultTo(Space) As "Last Name",
    first_name.DefaultTo(Space) As "First Name"
From people As person
Limit limit
For Batch Template

Sort people On age Giving people_by_age
Print Newline, "By Age, first ", limit, " (not null)"
Select
    RightJustify($rec-index + 1, 2) As "",
    RightJustify(age.DefaultTo(Space), 3) As "Age",
    last_name.DefaultTo(Space) As "Last Name",
    first_name.DefaultTo(Space) As "First Name"
From people_by_age As person
Where age Is Not None
Limit limit
For Batch Template

Sort people On last_name, first_name Giving people_by_names
Print Newline, "By Name, first ", limit
Select
    RightJustify($rec-index + 1, 2) As "",
    last_name.DefaultTo(Space) As "Last Name",
    first_name.DefaultTo(Space) As "First Name",
    RightJustify(age.DefaultTo(Space), 3) As "Age"
From people_by_names As person
Where last_name Is Not None
Limit limit
For Batch Template

Define Function ExtractAges(data_in):
    Set ages To []
    For-Each item In data_in
        Append item.age To ages
    End-For
    Return ages.StripNulls()
End-Function

Print Newline, "All ages from raw data", Newline, @ExtractAges(people)

// <list>.sort([<unique>[, <reverse>]])
Print Newline, "Unique ages using Sort()", Newline, @ExtractAges(people).Sort(True)

Sort people
    On age
    Unique On age
    Giving by_age
Print Newline, "Unique ages using Sort statement", Newline, @ExtractAges(by_age)
