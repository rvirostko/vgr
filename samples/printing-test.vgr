Reset All
Echo False
Verbose False
Debug False

Set a To 5
Set b To 10
Set c To 15

# Generates nothing
Print "---Nothing between these lines---"
Printf ""
Printf "", a
Printf "", a, b
Print "---Nothing between these lines---"

Print ""

Print "---Two blank lines---"
Printf "\n"
Printf "{}", "\n"
Print "---Two blank lines---"

Print ""

Print "---Two identical lines---"
Printf "{} > {}", a, b
Printf " && "
Printf "{} < {}", b, c
Printf "{}", env.ORS
Printf "{0} > {1} && {1} < {2}\n", a, b, c
Print "---Two identical lines---"

Set rs_fmt To "\n---{}\n---OFS={}, ORS={}\n"
Printf rs_fmt, "Defaults:", env.OFS.Repr(), env.ORS.Repr()
Print a, b, c
Print ""

Set env.OFS To " | "
Set env.ORS To " |\n"
Printf rs_fmt, "Overrides:", env.OFS.Repr(), env.ORS.Repr()
Print a, b, c
Unset env.OFS, env.ORS
Print ""

Printf rs_fmt, "Unset:", env.OFS.Repr(), env.ORS.Repr()
Print a, b, c
Print ""
