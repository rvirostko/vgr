ReSet All
Echo False
Verbose False
Debug False

Set a = 5
Set b = 10
Set c = 15

# Generates nothing
Print "---Nothing between these lines---"
Printf ""
Printf "", a
Printf "", a, b
Print "---Nothing between these lines---"

Print ""

Print "---Two blank lines---"
Printf "\n"
Printf "{}", "\n"
Print "---Two blank lines---"

Print ""

Print "---Two identical lines---"
Printf "{} > {}", a, b
Printf " && "
Printf "{} < {}", b, c
Printf "{}", arg.ors
Printf "{0} > {1} && {1} < {2}\n", a, b, c
Print "---Two identical lines---"

Set rs_fmt = "\n---{}\n---OFS={}, ORS={}\n"
Printf rs_fmt, "Defaults:", arg.ofs.Repr(), arg.ors.Repr()
Print a, b, c
Print ""

Set arg.ofs = " | "
Set arg.ors = " |\n"
Printf rs_fmt, "Overrides:", arg.ofs.Repr(), arg.ors.Repr()
Print a, b, c
Unset arg.ofs, arg.ors
Print ""

Printf rs_fmt, "Unset:", arg.ofs.Repr(), arg.ors.Repr()
Print a, b, c
Print ""
