# This is visual, so if it can't display anything...
If !vgr.stdout.isatty
    Print "stdout is not a TTY"
    Exit
End-If

# Simulate a seven segment display
# Demonstrates binary operations

# Segment names and layout
#  -- a --
# |       |
# f       b
# |       |
#  -- g --
# |       |
# e       c
# |       |
#  -- d --

# Bit masks for the segments
Set AMASK To 0b00000001
Set BMASK To 0b00000010
Set CMASK To 0b00000100
Set DMASK To 0b00001000
Set EMASK To 0b00010000
Set FMASK To 0b00100000
Set GMASK To 0b01000000

# Maps a digit to the segments
Set SEG To [
    0b0111111,  # 0
    0b0000110,  # 1
    0b1011011,  # 2
    0b1001111,  # 3
    0b1100110,  # 4
    0b1101101,  # 5
    0b1111101,  # 6
    0b0000111,  # 7
    0b1111111,  # 8
    0b1100111,  # 9
    0b1110111,  # A
    0b1111100,  # B
    0b0111001,  # C
    0b1011110,  # D
    0b1111001,  # E
    0b1110001   # F
]

# Converts a value to the segments which should be displayed
Define Function encode_7seg(n):
    Declare rc Local
    Set rc To List()
    If n.Type() != 'str'
        Set n To n.ToString()
    End-If
    For-Each d In n.Ord().BitAnd(0b1111)
        Append SEG.Item(d) To List rc
    End-For
    Return rc
End-Function

# Selects the box characters used to create the digits
Set C To term.box.lightrounded
Set VPART To [
    Space * 5,
    C.vbar + (Space * 4),
    (Space * 4) + C.vbar,
    C.vbar + (Space * 3) + C.vbar
]
Set HPART To [ Space * 3, C.hbar * 3 ]
Set LCORNER To [ Space, Space, Space, C.bl, Space, C.tl, C.vbar, C.lt ]
Set RCORNER To [ Space, Space, Space, C.br, Space, C.tr, C.vbar, C.rt ]

Function vpart(n, lmask, rmask) -> VPART.Item(n.BitAnd(lmask).ToBoolean() + n.BitAnd(rmask).ToBoolean().ShiftLeft(1))
Function hpart(n, mask) -> HPART.Item((n.BitAnd(mask).ToBoolean()))
Function cpart(n, pmask, umask, dmask, chars) ->
    chars.Item(n.BitAnd(pmask).ToBoolean() +
    n.BitAnd(umask).ToBoolean().ShiftLeft(1) +
    n.BitAnd(dmask).ToBoolean().ShiftLeft(2))

# Converts the segments into an array of strings
Define Function render_7seg(n):
    Declare rc Local
    Set rc To List()
    For row = 1 To 7
        Choose Using row
            When 1        Append n.@cpart(AMASK, 0, FMASK, LCORNER) + n.@hpart(AMASK) + n.@cpart(AMASK, 0, BMASK, RCORNER) To rc
            When 2 Thru 3 Append n.@vpart(FMASK, BMASK) To rc
            When 4        Append n.@cpart(GMASK, FMASK, EMASK, LCORNER) + n.@hpart(GMASK) + n.@cpart(GMASK, BMASK, CMASK, RCORNER) To rc
            When 5 Thru 6 Append n.@vpart(EMASK, CMASK) To rc
            When 7        Append n.@cpart(DMASK, EMASK, 0, LCORNER) + n.@hpart(DMASK) + n.@cpart(DMASK, CMASK, 0, RCORNER) To rc
        End-Choose
    Next
    Return rc
End-Function

For i = Zero To 99_999
    Set rows To None
    # Join the lines from the digits into single lines
    For-Each digit In @encode_7seg(i)
        Set enc To digit.@render_7seg()
        If $loop.first
            Set rows To enc
        Else
            For i = Zero To Length(enc) - 1
                Replace i In rows With rows.Item(i) + "  " + enc.Item(i)
            Next
        End-If
    End-For
    Terminal ClearScreen, HideCursor
    For-Each row In rows
        Print row No-Flush
    End-For
    Printf "" Flush
    Terminal ShowCursor
Next
