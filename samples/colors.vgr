# This is visual, so if it can't display anything...
If !vgr.stdout.isatty
    Print "stdout is not a TTY" To stderr
    Exit
End-If

Terminal GetTerminalSize
Assert term.size.cols ≥ 80 And term.size.rows ≥ 24 : "Window too small for demo"

Set iter To 3
Set sleep_time To 5
Set named_colors To term.color_names
Set max_len To named_colors.StringLen().Max()

Function StartTest(title)
    Terminal ResetAttrs, ClearScreen, SetTitle title
    If title Is Not None
        Terminal PrintDHigh title
    End-If
End-Function

Function EndTest()
    Terminal ResetAttrs
    Sleep sleep_time Seconds
End-Function

Terminal HideCursor
Repeat iter Times

    #-------------------------------------------------------------------------
    Call Function StartTest("Boxes and Lines")
    Terminal SetForeground "bright white", SetBackground "bright red"
    For i = 1 To 7
        Terminal MoveCursorTo 2+i:0,
                 DrawHLine i*10
        Terminal MoveCursorTo 3:(i*10)+1,
                 DrawVLine i
    Next
    For i = 2 To 8
        Terminal MoveCursorTo 10:(i - 2)*10,
                 DrawBox i:i
        Terminal BoldAttr True
        Printf "{0}x{0}", i
        Terminal BoldAttr False
    Next
    Set line To 19
    Set col To 1
    Set bwidth To term.box_styles.StringLen().Max() + 2
    Set bheight To 3
    Terminal SetForeground "bright white", SetBackground "bright green"
    For Each style In term.box_styles
        Terminal MoveCursorTo line:col,
                 DrawBox style:bheight:bwidth
        Printf style
        Add bwidth To col
        If col >= (80 - bwidth)
            Add bheight To line
            Set col To 1
        End-If
    End-For
    Call Function EndTest()
    #-------------------------------------------------------------------------

    #-------------------------------------------------------------------------
    Call Function StartTest("Font Styles")
    Terminal MoveCursorTo 3:1
    Set styles To [
        ["normal",             "Normal Text"],
        ["bold",               "Bold Text"],
        ["dim",                "Dim Text"],
        ["blink",              "Blinking Text"],
        ["italic",             "Italic Text"],
        ["underline",          "Underlined Text"],
        ["reverse",            "Reverse Text"],
        ["strikethrough",      "Strike-out Text"],
        ["hidden",             "Hidden Text"],
        ["bold blue reverse",  "Combined Settings"]
    ]
    For Each style In styles
        Terminal SetStyle style.FirstItem()
        Printf style.LastItem().Center(20)
        Terminal SetStyle "Normal",
                 SetForeground None,
                 SetBackground None
        Printf " {}\n", style.FirstItem()
    End-For
    Print Newline
    Terminal SetStyle "Reset wide"
    Print "Double Width Text"
    Call Function EndTest()
    #-------------------------------------------------------------------------

    #-------------------------------------------------------------------------
    Call Function StartTest("Numbered Colors")
    Terminal MoveCursorTo 3:1,
             SetBackground None,
             SetForeground "bright white"
    Printf "Standard "
    For color = Zero To 15
        Terminal SetBackground color
        Printf color.RightJustify(4).LeftJustify(5)
        If color == 7
            Terminal SetForeground None, SetBackground None
            Printf "\n Intense "
            Terminal SetForeground "black"
        End-If
    Next
    Terminal SetBackground None, SetForeground "bright white"
    Printf "\n\n   Grays "
    For gray = Zero To 23
        Set color To 232 + gray
        Terminal SetBackground color
        Printf color.RightJustify(4).LeftJustify(5)
        If !((gray + 1) % 12)
            Terminal SetBackground None, SetForeground "black"
            Printf "\n         "
        End-If
    Next
    Terminal SetBackground None, SetForeground "bright white"
    Printf "\n  Colors"
    Set start_line To 9
    Set line To start_line
    Set col To 10
    For green = Zero To (5 * 6) Step 6
        If green == 18
            Set line To start_line
            Add 35 To col
            Terminal SetForeground "black"
        End-If
        For red = Zero To (5 * 36) Step 36
            Terminal MoveCursorTo line:col
            For blue = Zero To 5 Step 1
                Set color To 16 + red + green + blue
                Terminal SetBackground color
                Printf color.RightJustify(4).LeftJustify(5)
            Next
            Add 1 To line
        Next
        Add 1 To line
    Next
    Call Function EndTest()
    #-------------------------------------------------------------------------

    #-------------------------------------------------------------------------
    Call Function StartTest("Named Colors")
    Terminal MoveCursorTo 3:1
    For i = Zero To named_colors.Length() - 1
        Set color_name To named_colors.Item(i)
        Terminal SetBackground color_name
        Printf " " + color_name.ShortenStr(max_len).LeftJustify(max_len) + " "
        If !((i + 1) % 4)
            # Need resume default background in case we scroll
            Terminal SetBackground None, MoveCursorToCol 1
            Print ""
        End-If
    Next
    Call Function EndTest()
    #-------------------------------------------------------------------------

End-Repeat

Terminal SetTitle None
Terminal ClearScreen, ResetAttrs, ShowCursor
