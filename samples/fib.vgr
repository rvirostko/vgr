//---------------------------------------------------------------------
// Calculate and display Fibonacci numbers from fib(0) to fib(8)
//---------------------------------------------------------------------

// Use a list as the "stack" for the last two Fibonacci values
Set fib_stack To []
Set i To Zero
While i <= 8
    If fib_stack.Length() < 2
        Set fib To i
    Else
        Set fib To fib_stack.Sum()
        Remove First From fib_stack
    End-If
    Append fib To fib_stack
    Printf "fib({}) = {}\n", i, fib
    Add 1 To i
End-While
