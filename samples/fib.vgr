//---------------------------------------------------------------------
// Calculate and display Fibonacci numbers from fib(0) to fib(8)
//---------------------------------------------------------------------

// Use a list as the "stack" for the last two Fibonacci values
Set fstack = []
Set i = 0
While i <= 8
    If fstack.Length() < 2
        Set fib = 0
    Else
        Set fib = (i > 0 && i <= 2) ? 1 : fstack.Sum()
        Remove First From fstack
    End-If
    Append fib To fstack
    Printf "fib({}) = {}\n", i, fib
    Set i += 1
End-While
