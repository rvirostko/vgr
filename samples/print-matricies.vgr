# In the Digiac-3060 tradition
# Printing math matricies

Set Zero To 0 # for readability

# Convert a value to a number, using zero as the default
# Since it is strictly transformational, use a arrow function
Set num_default(x) -> x.DefaultTo(Zero).ToNumber()

# Basic math operations in a dictionary
# These are short enough they could be defined as arrow functions
Define Function op.add(a, b):
    Return @num_default(a) + @num_default(b)
End-Function
Define Function op.sub(a, b):
    Return @num_default(a) - @num_default(b)
End-Function
Define Function op.mul(a, b):
    Return @num_default(a) * @num_default(b)
End-Function
Define Function op.div(a,b):
    Set b = @num_default(b)
    Return b Is Zero ? math.inf : (@num_default(a) / b)
End-Function

# Some more "advanced" math operations
Define Function adv_op.pow(a, b): return @num_default(a).Pow(@num_default(b)); End-Function
Define Function adv_op.gcd(a, b):
    Set a = @num_default(a)
    Set b = @num_default(b)
    While b != 0
        Set t = b
        Set b = a % b
        Set a = t
    End-While
    Return a
End-Function
Define Function adv_op.lcm(a, b):
    Declare i, limit, g, s As Local
    Set a = @num_default(a)
    Set b = @num_default(b)
    Set g = a.Max(b)  // Larger value
    Set s = a.Min(b)  // Smaller value
    Set i = g
    Set limit = a * b
    While i <= limit
        If (i % s) == 0 Return i End-If
        Set i += g
    End-While
    Return limit
End-Function

Define Function print_matricies(operations, matrix_min, matrix_max):
    Assert operations.IsDictionary()
    Assert operations.Length() > 0 : "No operations defined"
    Set matrix_min = matrix_min.ToInteger().DefaultTo(0).Clamp(0, 99)
    Set matrix_max = matrix_max.ToInteger().DefaultTo(9).Clamp(matrix_min, 99)
    For Each item in operations
        # operations is dictionary, so For Each returns a key-value pair for each item
        Set op_name To item.FirstItem()
        Set op_func To item.LastItem()
        Printf "\n{}:\n", op_name.TitleCase()
        For x = matrix_min To matrix_max
            # Print the header for the matrix
            If x == matrix_min
                Printf "   | "
                For y = matrix_min To matrix_max
                    Printf "{:>2d} ", y
                Next
                Printf "\n---+-{}\n", "-" * (((matrix_max - matrix_min) + 1) * 3)
            End-If
            # Print a row's worth of calculations
            Printf "{:>2d} | ", x
            For y = matrix_min To matrix_max
                Set rc = @op_func(x, y)
                If rc.IsFinite()
                    Printf "{:>2d} ", rc.ToInteger()
                Else
                    Printf " - "
                End-If
            Next
            Print ""
        Next
    End-For
End-Function

Call print_matricies(op, 0, 9)
Call print_matricies(adv_op, 3, 7)
