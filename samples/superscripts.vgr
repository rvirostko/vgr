Set x To 2

// Visual checks
Echo On
Print x¹
Print x¹⁰
Print x⁽¹⁾
Print x⁽¹⁰⁾
Print x⁺¹
Print x⁻¹⁰
Print x⁽⁺¹⁾
Print x⁽⁻¹⁰⁾

Print x¹·⁵
Print x¹⁰·⁵
Print x⁽¹·⁵⁾
Print x⁽¹⁰·⁵⁾
Print x⁺¹·⁵
Print x⁻¹⁰·⁵
Print x⁽⁺¹·⁵⁾
Print x⁽⁻¹⁰·⁵⁾

Print x·⁵
Print x⁽·⁵⁾
Print x⁺·⁵
Print x⁻·⁵
Print x⁽⁺·⁵⁾
Print x⁽⁻·⁵⁾
Echo Off

// Test against Pow()
Assert x¹ == x.Pow(1)
Assert x¹⁰ == x.Pow(10)
Assert x⁽¹⁾ == x.Pow(1)
Assert x⁽¹⁰⁾ == x.Pow(10)
Assert x⁺¹ == x.Pow(1)
Assert x⁻¹⁰ == x.Pow(-10)
Assert x⁽⁺¹⁾ == x.Pow(1)
Assert x⁽⁻¹⁰⁾ == x.Pow(-10)

Assert x¹·⁵ == x.Pow(1.5)
Assert x¹⁰·⁵ == x.Pow(10.5)
Assert x⁽¹·⁵⁾ == x.Pow(1.5)
Assert x⁽¹⁰·⁵⁾ == x.Pow(10.5)
Assert x⁺¹·⁵ == x.Pow(1.5)
Assert x⁻¹⁰·⁵ == x.Pow(-10.5)
Assert x⁽⁺¹·⁵⁾ == x.Pow(1.5)
Assert x⁽⁻¹⁰·⁵⁾ == x.Pow(-10.5)

Assert x·⁵ == x.Pow(.5)
Assert x⁽·⁵⁾ == x.Pow(.5)
Assert x⁺·⁵ == x.Pow(.5)
Assert x⁻·⁵ == x.Pow(-.5)
Assert x⁽⁺·⁵⁾ == x.Pow(.5)
Assert x⁽⁻·⁵⁾ == x.Pow(-.5)

// cast to any int if we don't loose precession
Set intify(x) -> x == x.ToInt() ? x.ToInt() : x

Define Function solve_quadratic(a, b, c):
    // Solve ax² + bx + c = 0
    Declare eqn, roots As Local
    If a == 0:
        Assert b != 0: "Not a valid quadratic or linear equation"
        # Linear case: bx + c = 0
        eqn = "{}x {} {} = 0".Format(
                b == 1 ? "" : b,
                c < 0 ? '-' : '+',  c.Abs())
        roots = [c.Negate() / b]
    Else:
        eqn = "{}x² {} {}x {} {} = 0".Format(
                a == 1 ? "" : a,
                b < 0 ? '-' : '+', b.Abs(),
                c < 0 ? '-' : '+', c.Abs())
        sqrt_disc = (b² - 4.Mul(a, c))·⁵
        b = b.Negate()
        roots = [b + sqrt_disc, b - sqrt_disc].Div(2 * a)
    End
    Return [eqn] + roots.@intify()
End

Print ""
ForEach v In @solve_quadratic(1, -5, 6):
    If $loop.first:
        // The equation
        Printf "{} →", v
    Else:
        // A root
        Printf "{} {}", $loop.index > 2 ? ',' : '', v
    End
    If $loop.last:
        Print ""
    End
End
