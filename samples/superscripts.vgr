Set x To 2

// Visual checks
Echo On
Print x¹
Print x¹⁰
Print x⁽¹⁾
Print x⁽¹⁰⁾
Print x⁺¹
Print x⁻¹⁰
Print x⁽⁺¹⁾
Print x⁽⁻¹⁰⁾

Print x¹·⁵
Print x¹⁰·⁵
Print x⁽¹·⁵⁾
Print x⁽¹⁰·⁵⁾
Print x⁺¹·⁵
Print x⁻¹⁰·⁵
Print x⁽⁺¹·⁵⁾
Print x⁽⁻¹⁰·⁵⁾

Print x·⁵
Print x⁽·⁵⁾
Print x⁺·⁵
Print x⁻·⁵
Print x⁽⁺·⁵⁾
Print x⁽⁻·⁵⁾
Echo Off

// Test against Pow()
Assert x¹ == x.Pow(1)
Assert x¹⁰ == x.Pow(10)
Assert x⁽¹⁾ == x.Pow(1)
Assert x⁽¹⁰⁾ == x.Pow(10)
Assert x⁺¹ == x.Pow(1)
Assert x⁻¹⁰ == x.Pow(-10)
Assert x⁽⁺¹⁾ == x.Pow(1)
Assert x⁽⁻¹⁰⁾ == x.Pow(-10)

Assert x¹·⁵ == x.Pow(1.5)
Assert x¹⁰·⁵ == x.Pow(10.5)
Assert x⁽¹·⁵⁾ == x.Pow(1.5)
Assert x⁽¹⁰·⁵⁾ == x.Pow(10.5)
Assert x⁺¹·⁵ == x.Pow(1.5)
Assert x⁻¹⁰·⁵ == x.Pow(-10.5)
Assert x⁽⁺¹·⁵⁾ == x.Pow(1.5)
Assert x⁽⁻¹⁰·⁵⁾ == x.Pow(-10.5)

Assert x·⁵ == x.Pow(.5)
Assert x⁽·⁵⁾ == x.Pow(.5)
Assert x⁺·⁵ == x.Pow(.5)
Assert x⁻·⁵ == x.Pow(-.5)
Assert x⁽⁺·⁵⁾ == x.Pow(.5)
Assert x⁽⁻·⁵⁾ == x.Pow(-.5)

// cast to any int if we don't loose precession
Define Function intify(x) -> x == x.ToInteger() ? x.ToInteger() : x

Define Function solve_quadratic(a, b, c):
    // Solve ax² + bx + c = 0
    Declare eqn, roots As Local
    If a == 0
        Assert b != 0: "Not a valid quadratic or linear equation"
        # Linear case: bx + c = 0
        Set eqn To "{}x {} {} = 0".Format(
                b == 1 ? "" : b,
                c Is Negative ? '-' : '+',  c.Abs())
        Set roots To [c.Negate() / b]
    Else
        Set eqn To "{}x² {} {}x {} {} = 0".Format(
                a == 1 ? "" : a,
                b Is Negative ? '-' : '+', b.Abs(),
                c Is Negative ? '-' : '+', c.Abs())
        Set sqrt_disc To (b² - 4.Mul(a, c))·⁵
        Set b To b.Negate()
        Set roots To [b + sqrt_disc, b - sqrt_disc].Div(2 * a)
    End-If
    Return [eqn] + roots.@intify()
End-Function

Print ""
For-Each v In @solve_quadratic(1, -5, 6)
    If $loop.first
        // The equation
        Printf "{} →", v
    Else
        // A root
        Printf "{} {}", $loop.index > 2 ? ',' : '', v
    End-If
    If $loop.last
        Print ""
    End-If
End-For
