// "main detection" in VGR

# Source a file relative to our location
Source vgr.source.FirstItem().DirectoryName() + os.sep + "main-2.vgr"

// Length() == 0 : run from REPL, -e on command line, or read from stdin
// Length() == 1 : sourced from REPL or -f on command line
// Length() > 1 : sourced from another file
If Length(vgr.source) <= 1
    Print vgr.source.FirstItem(), "is main"
End
