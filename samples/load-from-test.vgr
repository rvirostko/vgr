Reset All

# Some quick examples of comment style
# "Modern" style comments
// C style comments
/*
 * CPP style comments
 */

# Test end of line comments
Pass   # "Modern"
Pass   // C-style
Pass   /* CPP-style */

Set base To vgr.source.FirstItem().DirectoryName() + os.sep

Set bar To "//" + ("-" * 77)

# This file contains a single JSON object
# Select For JSON Root <root> can be used to produce a file like this
Print bar
Load test.json.obj From base + "in.json"
Exhibit test.json.obj
Assert test.json.obj.Type() == "dictionary"
Print bar
Print ""

# This file has a JSON array, suitable for use with LookupItem()
# The Select For JSON produces this by default
Print bar
Load test.json.arr From base + "array.json"
Exhibit test.json.arr
Assert test.json.arr.Type() == "list"
Print bar
Print ""

# This file has a JSON object per row.
# Select For JSON No Array Wrapper produces this
# The file can be used here or prefiltered by grep before being used
Print bar
Load test.json.objs From base + "objs.txt" JSON Object Per Line
Exhibit test.json.objs
Assert test.json.objs.Type() == "list"
Print bar
Print ""

# CSV is CSV...
# The lib used to load these files don't like extra spaces between
# columns and add those space (and quotes!) to the column data
# This also uses some syntactic sugar and using expressions
Print bar
Set csv_file_name To "objs"
Load test.csv.arr From File base + csv_file_name + ".csv" CSV
Exhibit test.csv.arr
Assert test.csv.arr.Type() == "list"
Print bar
Print ""

# Text allows you to read in text as a string
# Text is the default when the extension is not .csv or .json
Print bar
Load test.text From base + "objs.txt" Text
Exhibit test.text
Assert test.text.Type() == "string"
Print bar
Print ""

# Text allows you to read lines of text into an array
Print bar
Load test.text From base + "objs.txt" Text Lines
Exhibit test.text
Assert test.text.Type() == "list"
Assert test.text.FirstItem().Type() == "string"
Print bar
Print ""

# Lookup values are somewhat flexible as they use either "IsEqualTo()" or "Matches()"
Print bar
Set fmt To """test.{2}.arr.LookupItem({0!r}, {1!r}) -> {3!r}
test.{4}.arr.LookupItem({0!r}, {1!r}) -> {5!r}
"""
Set test_values To [["idx", 3], ["idx", 3.0], ["idx", " 3 "], ["fname", "Justin"], ["fname", "justin"], ["fname", CompilePattern("(?i)Justin")]]
For Each test_value in test_values
    Set lookup_key To test_value.FirstItem()
    Set value to test_value.LastItem()
    Printf fmt, lookup_key, value,
        "csv", test.csv.arr.LookupItem(lookup_key, value),
        "json", test.json.arr.LookupItem(lookup_key, value)
End-For
Print bar
Print ""

Print bar
Set fmt2 To "test.csv.arr.LookupItem({!r}, {!r}) -> {!r}\n"
Set lookup_key To "idx"
Set test_values To [[0], [0, 0], [0, 3], [3, 0], [3, 3], [3]]
For Each value in test_values
    Printf fmt2, lookup_key, value,
        test.csv.arr.LookupItem(lookup_key, value)
End-For
Print bar
Print ""

Print bar
# Chained lookup
Set jsmith To test.csv.arr.
    LookupItem("lname", CompilePattern("(?i)Smith")).
    LookupItem("fname", CompilePattern("(?i)Justin")).
    FirstItem()
Printf "{}, {} : ID {}\n", jsmith.lname, jsmith.fname, jsmith.idx
Print "|", jsmith.idx, "|", jsmith.lname, "|", jsmith.fname, "|"
# Dereferencing a result
Printf "Heap's idx = {}\n",
    test.csv.arr.LookupItem("lname", "Heap").FirstItem().idx
Print bar

Print "\nDone"
