
Tron

Assert Matches() Is False

Assert None.Matches() Is False
Assert None.Matches(None)
Assert None.Matches(False) Is False
Assert None.Matches(1) Is False
Assert None.Matches(1.0) Is False
Assert None.Matches("1") Is False
Assert None.Matches(["1"]) Is False

Assert False.Matches(None) Is False
Assert 1.Matches(None) Is False
Assert 1.0.Matches(None) Is False
Assert "1".Matches(None) Is False
Assert ["1"].Matches(None) Is False

Troff

For Each value In [True, False, Zero, Nan, Inf, "hello", ["world"]]
    Exhibit value
    Tron
    Assert value.Matches(value)
    Assert [value].Matches(value)
    Assert [value, "frog"].Matches(value) Is False
    Assert [value, "frog"] Not Matches value
    Assert value.Matches([value, "frog"])
    Assert value Matches All value
    Assert [value] Matches All value
    Assert [value, "frog"].MatchesAll(value) Is False
    Assert value Matches All [value]
    Assert value.MatchesAll([value, "frog"]) Is False
    Troff
End-For

Tron

# Pattern compilation is optional
Set a_or_b To CompilePattern("^(a|b)+$")
Set all_a To CompilePattern("^a+$")
Set all_b To CompilePattern("^b+$")

Assert "aaa" Matches a_or_b
Assert "bb" Matches a_or_b
Assert ["aaa", "bb"] Matches a_or_b
# Not all match the pattern so result is False
Assert (["aaa", "bb", "abba", "bad"] Matches a_or_b) Is False
Assert ["aaa", "bb", "abba", "bad"] Does Not Match a_or_b

# Functional form can take multiple patterns
# one of which must match
Assert "aaa".Matches(all_a, all_b)
Assert "bbb".Matches(all_a, all_b)
Assert "bbb".Matches([all_a], [all_b])
Assert "bbb".Matches([all_a, all_b])
Assert "abba".Matches(all_a, all_b) Is False

# Case insensitive matching
Assert ("A" ~ a_or_b) Is False # case sensitive
Assert "A" ~* a_or_b # case insensitive
