//-----------------------------------------------------------------------------
// Generates examples for function and expression documentation
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Remove parens around a string
//-----------------------------------------------------------------------------
Function deparen(s) -> s.StartsWith("(") and s.EndsWith(")") ? s.Slice(1,-1) : s
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Join strings with an arrow
//-----------------------------------------------------------------------------
Function arrow_join(x) -> x.Join(" → ")
//-----------------------------------------------------------------------------

Set rnd To Random(9999)
Set setup_file To "doc-gen-{:04d}-s.txt".Format(rnd)
Set out_file To "doc-gen-{:04d}-o.txt".Format(rnd)
Set err_file To "doc-gen-{:04d}-e.txt".Format(rnd)

Open Error File setup_file
Echo On
//-----------------------------------------------------------------------------
// Set up for examples go here
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
Echo Off
Close Error File

Open Output File out_file // Results go to this file
Open Error File err_file  // The echoed commands goes to this file
Echo On
//-----------------------------------------------------------------------------
// Documentation examples go here
//-----------------------------------------------------------------------------

Set d To {"a": 1, "b": 2}
Remove Key "a" From d
Print d.Repr()

Set a To [ {"a": 1}, {"b": 2} ]
Remove Key "b" From a
Print a.Repr()

//-----------------------------------------------------------------------------
Echo Off
Close Error File
Close Output File

// Load in the generated data and convert
Load s_in With File setup_file Text Lines
Load o_in With File out_file Text Lines
Set o_in To o_in.ReplaceStr("'", '"')
Load o_err With File err_file Text Lines
Set o_err To
    o_err.RemovePrefix("Print ").
    RemoveSuffix(".Repr()").
    Apply(deparen)

// Make a code example from
// - Any setup strings
// - The combined "echo" and sample output
Set example To
    MdCodeBlock("vgr",
                s_in +
                CombineLists(o_err, o_in).Apply(arrow_join)
    )

// Preview it for editing
Print example As Markdown
// And have it ready to paste
// NB: You probably need to install pyperclip for this to work
// We need to double up backslashes because the example are
// pasted into docstrings
Terminal SetClipboard example.ReplaceStr("\\", r"\\").AppendStr(NewLine)

// Clean up our temp files
For Each fn In [setup_file, out_file, err_file]
    Assert fn.RemoveFile().FirstItem() : "Could not delete {}", fn
End-For
