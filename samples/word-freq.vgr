# Demonstration of functions that work on dictionaries:
#   * GetKeyValue()
#   * SetKeyValue()

# This is interactive
If !vgr.stdout.isatty
    Print "stdout is not a TTY"
    Exit
End-If

Constant non-alpha Is r/[^A-Z]/i
Constant indent Is Space * 3
Constant word_header Is "Word"
Constant count_header Is "Count"
Constant fmt Is "{0} {1:<{3}} {2:>{4}}\n"

Print "\n--- Word Frequency Counter ---"
While True
    Set sentence To ""
    Printf "\nEnter a sentence: "
    Accept Input From stdin To sentence
    Set sentence To sentence.Strip()
    If sentence Equals ""
        Break
    End-If
    # Split the sentence into words and tally their count using a dictionary
    Set wordCounter To Dictionary()
    # Normalize the words: lowercase Ascii letters
    For Each word In sentence.RegexReplace(non-alpha, " ").Lower().Split()
        If Length(word) Is Positive
            Set wordCounter To wordCounter.SetKeyValue(word, wordCounter.GetKeyValue(word, 0).Add(1))
        End-If
    End-For
    # Print only if we found some words
    If wordCounter.Length() Is Zero
        Printf Newline
        Print indent, "Didn't find any words"
        Continue
    End-If
    # Using the keys and the values, along with the headers, determine the column widths
    Set word_col_width To Max(wordCounter.GetKeys().StringLen().Max(), word_header.StringLen()).Add(1)
    Set count_col_width To Max(wordCounter.GetValues().Max().ToString().StringLen(), count_header.StringLen()).Add(1)
    # Print a summary
    Set unique_wc To wordCounter.Length()
    Set wc To wordCounter.GetValues().Sum()
    Printf Newline
    Print indent, "Read", wc, wc.Plural("words", "word") No-Flush
    Print indent, "Found", unique_wc, "unique", unique_wc.Plural("words", "word"), Newline No-Flush
    # Print the headers
    Printf fmt, indent, word_header, count_header, word_col_width, count_col_width No-Flush
    Printf fmt, indent, term.box.heavy.hbar * word_col_width, term.box.heavy.hbar * count_col_width, word_col_width, count_col_width No-Flush
    Set wordList To List()
    # Convert the dictionary into a list of dictionaries we can sort
    For Each item In wordCounter
        Append { "word": item.FirstItem(), "count": item.LastItem() } To List wordList
    End-For
    # Sort by word within fequency
    Sort wordList On Descending Key count, Ascending Key word
    # Print the data
    For Each item In wordList
        Printf fmt, indent, item.word, item.count, word_col_width, count_col_width No-Flush
    End-For
    Printf "" Flush
End-While
Print "Goodbye"
