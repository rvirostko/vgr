#! /usr/bin/env bash

set -euo pipefail

PROG="install-vgr"
GLOBAL_INSTALL=0
REINSTALL=0
REQ_VERSION=""

usage() {
    cat <<EOF
Usage: $PROG [options] [x.y.z]

With no version specified, installs the newest wheel matching:
  vgr-<x>.<y>.<z>-*.whl

Options:
  --global        Install into the current Python environment
  --reinstall     Force reinstall (pip --force-reinstall)
  -h, --help      Show help
EOF
}

fail() {
    echo "$PROG: $*" >&2
    exit 1
}

# -------------------------
# Platform detection
# -------------------------
UNAME=$(uname -s)
IS_CYGWIN=0

case "$UNAME" in
    CYGWIN*) IS_CYGWIN=1 ;;
esac

if [[ $IS_CYGWIN -eq 1 && -n "${CURL_CA_BUNDLE:-}" ]]; then
    cat >&2 <<EOF
WARNING: CURL_CA_BUNDLE is set in this Cygwin environment.

This can interfere with TLS validation used by Python/pip and may cause
SSL failures during installation. Consider unsetting it:

    unset CURL_CA_BUNDLE
EOF
fi

# -------------------------
# Parse arguments
# -------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --global)
            GLOBAL_INSTALL=1
            shift
            ;;
        --reinstall)
            REINSTALL=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            if [[ -n "$REQ_VERSION" ]]; then
                fail "Multiple versions specified"
            fi
            REQ_VERSION="$1"
            shift
            ;;
    esac
done

select_latest_wheel() {
    ls vgr-*-*.whl 2>/dev/null \
        | sed -E 's/^vgr-([0-9]+\.[0-9]+\.[0-9]+)-.*$/\1 &/' \
        | sort -V \
        | tail -n1 \
        | cut -d' ' -f2-
}

select_specific_wheel() {
    local ver="$1"
    local file
    file=$(ls "vgr-${ver}-"*.whl 2>/dev/null || true)
    [[ -n "$file" ]] || fail "Wheel for version $ver not found"
    echo "$file"
}

if [[ -n "$REQ_VERSION" ]]; then
    WHEEL=$(select_specific_wheel "$REQ_VERSION")
else
    WHEEL=$(select_latest_wheel)
    [[ -n "${WHEEL:-}" ]] || fail "No vgr wheels found"
fi

VERSION=$(echo "$WHEEL" | sed -E 's/^vgr-([0-9]+\.[0-9]+\.[0-9]+)-.*$/\1/')
VENV_NAME="vgr-$VERSION"

PIP_ARGS=(install)
[[ $REINSTALL -eq 1 ]] && PIP_ARGS+=(--force-reinstall)
PIP_ARGS+=("$WHEEL")

# -------------------------
# Detect venv script dir
# -------------------------
detect_venv_bindir() {
    local venv="$1"
    if [[ -d "$venv/bin" ]]; then
        echo "$venv/bin"
        return
    fi
    if [[ -d "$venv/Scripts" ]]; then
        echo "$venv/Scripts"
        return
    fi
    fail "Cannot locate venv executable directory (bin/ or Scripts/)"
}

TEST_VGR="Print ''; Print 'VGR', vgr.version, 'installed!'; Print '';"

if [[ $GLOBAL_INSTALL -eq 1 ]]; then
    echo "Installing $WHEEL (v$VERSION) globally"
    python3 -m pip "${PIP_ARGS[@]}"
    vgr --execute --execute "$TEST_VGR"
else
    echo "Creating virtual environment $VENV_NAME"
    python3 -m venv "$VENV_NAME"
    BINDIR=$(detect_venv_bindir "$VENV_NAME")
    PY="$BINDIR/python"
    # Windows layouts may use python.exe
    if [[ ! -x "$PY" && -x "$BINDIR/python.exe" ]]; then
        PY="$BINDIR/python.exe"
    fi
    "$PY" -m pip install --upgrade pip >/dev/null
    echo "Installing $WHEEL (v$VERSION) in virtual environment"
    "$PY" -m pip "${PIP_ARGS[@]}"
    "$BINDIR/vgr" --execute "$TEST_VGR"
fi

if [[ $GLOBAL_INSTALL -eq 0 ]]; then
    ACTIVATE_PATH=""
    if [[ -f "$VENV_NAME/bin/activate" ]]; then
        ACTIVATE_PATH="$VENV_NAME/bin/activate"
    elif [[ -f "$VENV_NAME/Scripts/activate" ]]; then
        ACTIVATE_PATH="$VENV_NAME/Scripts/activate"
    fi
    echo "Use source $ACTIVATE_PATH to activate environment"
    echo "  or $BINDIR/gr to run without activation"
fi
