#! /usr/bin/env bash

# Must use 'source dev-setup' instead of just running it
# We can check in bash and zsh
# NB: zsh execution will sometimes emulate bash
if [ -n "${BASH_SOURCE[0]+set}" ]; then
    # Bash provides BASH_SOURCE array
    if [ "${BASH_SOURCE[0]}" == "$0" ]; then
        echo "Use: source $0" >&2
        exit 1
    fi
elif [ -n "${ZSH_VERSION:-}" ]; then
    # zsh provides $ZSH_EVAL_CONTEXT
    if [ -n "${ZSH_VERSION:-}" ]; then
        if [[ $ZSH_EVAL_CONTEXT != *:file ]]; then
            echo "Use: source $0" >&2
            exit 1
        fi
    fi
fi

# Now that we know we are being sourced, we want
# to avoid "exit". Each step is now protected
# with the OKAY check so that it is skipped
# if a previous step didn't work.

OKAY=1
if [ ! -d "./src/vgr" ]; then
    echo "You are not in the project root" >&2
    OKAY=0
fi

if [ "$OKAY" -eq 1 ]; then
    # Cygwin-specific fix for pip/requests SSL issues
    if uname -o 2>/dev/null | grep -qi "Cygwin"; then
        if [ -n "${CURL_CA_BUNDLE:-}" ]; then
            echo "Unsetting CURL_CA_BUNDLE"
            unset CURL_CA_BUNDLE
        fi
    fi
fi

# Do we have the venv created?
if [ "$OKAY" -eq 1 ]; then
    if [ ! -d "./.venv" ]; then
        python3 -m venv .venv
    fi
fi

if [ "$OKAY" -eq 1 ]; then
    # Activate venv if not already
    if [ "${VIRTUAL_ENV:-}" = "" ]; then
        if [ -d "./.venv/bin" ]; then
            source "./.venv/bin/activate"
        elif [ -d "./.venv/Scripts" ]; then
            source "./.venv/Scripts/activate"
        else
            echo "Don't know how to activate virtual environment" >&2
            OKAY=0
        fi
    fi
    if [ "${VIRTUAL_ENV:-}" != "" ]; then
        echo "VIRTUAL_ENV=${VIRTUAL_ENV}"
    fi
fi

if [ "$OKAY" -eq 1 ]; then
    python3 -m pip install --quiet --use-feature=in-tree-build -r requirements-dev.txt
fi

if [ "$OKAY" -eq 1 ]; then
    # Check which CA bundle would be in effect
    # Commentary/reminder only...
    if [ -n "${REQUESTS_CA_BUNDLE:-}" ]; then
        echo "REQUESTS_CA_BUNDLE=${REQUESTS_CA_BUNDLE}"
    elif [ -n "${CURL_CA_BUNDLE:-}" ]; then
        echo "CURL_CA_BUNDLE=${CURL_CA_BUNDLE}"
    fi
fi

# NB: This assumes that the Python is a "native" application
#     meaning that the path elements follow the OS conventions,
#     not the conventions of an environment like Cygwin or WSL.
#     Generally, "it should just work", but...
if [ "$OKAY" -eq 1 ]; then
    export PYTHONPATH=$(python3 - <<'EOF'
import os
src = os.path.abspath(os.path.join(os.getcwd(), 'src'))
existing = os.environ.get('PYTHONPATH', '')
if existing:
    if src in existing.split(os.pathsep):
        print(existing)
    else:
        print(src + os.pathsep + existing)
else:
    print(src)
EOF
)
    echo "PYTHONPATH=${PYTHONPATH}"
fi

if [ "$OKAY" -eq 1 ]; then
    export VGR_PATH="${VGR_PATH:=$(pwd)/samples}"
    echo "VGR_PATH=${VGR_PATH}"
fi

if [ "$OKAY" -eq 1 ]; then
    unset NO_COLOR
fi

add_to_path() {
    local dir="$1"
    # Expand ~ to $HOME
    dir="${dir/#\~/$HOME}"
    # Only add if not already in PATH
    case ":$PATH:" in
        *":$dir:"*) return ;;  # already in PATH
    esac
    PATH="$dir:$PATH"
}

if [ "$OKAY" -eq 1 ]; then
    add_to_path "$(pwd)/scripts"
fi

if [ "$OKAY" -eq 1 ]; then
    python3 -m vgr --version
fi
