#! /usr/bin/env bash
set -euo pipefail

# Like printf, but adds bold if permitted
msg() {
    if [[ -n "${NO_COLOR:-}" || ! -t 1 ]]; then
        printf "$@"
    else
        printf '\033[1m'
        printf "$@"
        printf '\033[0m'
    fi
}
if [[ $# -gt 1 ]]; then
    msg "ERROR:\nUsage: %s [TAG]\n" "$0" >&2
    exit 1
fi

if [ ! -d "./src/vgr" ]; then
    msg "ERROR:\nYou are not in the project root\n" >&2
    exit 1
fi

if ! python3 -m build --version >/dev/null 2>&1; then
    msg "ERROR:\n'build' is not installed\n" >&2
    exit 1
fi

# This is all cross checks with what the CI pipeline
# thinks is going to be built
SOURCE_VERSION=$(grep -m1 '^version' pyproject.toml | sed -E 's/version *= *"(.*)"/\1/')
if [[ $# -eq 1 ]]; then
    TAG="$1"
    if [[ "$TAG" != v* ]]; then
        msg "ERROR:\nInvalid tag '%s' — expected a tag beginning with 'v'\n" "${TAG}">&2
        exit 1
    fi
    VERSION="${TAG#v}"
    if [[ "$VERSION" != "$SOURCE_VERSION" ]]; then
        msg "ERROR:\nTag version '%s' does not match source version '%s'\n" "${VERSION}" "${SOURCE_VERSION}" >&2
        exit 1
    fi
else
    TAG="v${SOURCE_VERSION}"
    VERSION="$SOURCE_VERSION"
fi

msg "VERSION is %s\n" "${VERSION}"
msg "Release TAG is %s\n" "${TAG}"

PROJECT_ROOT=$(pwd)
DIST_DIR="${PROJECT_ROOT}/dist"
SAMPLES_DIR="${PROJECT_ROOT}/samples"
CHANGELOG="${PROJECT_ROOT}/CHANGELOG.md"
SAMPLES_FILE="${DIST_DIR}/vgr-${VERSION}-samples.zip"
RELEASE_NOTES="${DIST_DIR}/vgr-${VERSION}-RELEASE-NOTES.md"

# Ensure output directory exists and is empty
rm -rf "$DIST_DIR"
mkdir -p "$DIST_DIR"

python3 -m build --quiet --outdir "$DIST_DIR"

# Grab the changes for this version
RELEASE_SECTION="$VERSION"
if ! grep -q "^## \[$VERSION\]" "$CHANGELOG"; then
    if grep -q "^## \[Unreleased\]" "$CHANGELOG"; then
        RELEASE_SECTION="Unreleased"
        msg "WARNING:\nUsing '%s' for Release Notes\n" "${RELEASE_SECTION}" >&2
    fi
fi
awk -v section="$RELEASE_SECTION" '
    $0 ~ "^## \\[" section "\\]" {flag=1}
    flag {
        if ($0 ~ "^## \\[" && $0 !~ "^## \\[" section "\\]") exit
        if ($0 ~ "^## \\[" section "\\]") {
            sub("^## \\[" section "\\]", "## " section)
        }
        print
    }' "$CHANGELOG" > "$RELEASE_NOTES"
if [ ! -s "$RELEASE_NOTES" ]; then
    msg "ERROR:\n%s is missing or empty\n" "$(basename "${RELEASE_NOTES}")" >&2
    exit 1
fi
msg "Successfully created %s\n" "$(basename "${RELEASE_NOTES}")"

if [ ! -d "$SAMPLES_DIR" ]; then
    msg "ERROR:\n%s is missing\n" "$(basename "${SAMPLES_DIR}")" >&2
    exit 1
fi
(cd "$SAMPLES_DIR" && zip -q -r -9 "$SAMPLES_FILE" . \
    -x "*.DS_Store" \
    -x "__pycache__/*" \
    -x "*.pyc")
if [ ! -s "$SAMPLES_FILE" ]; then
    msg "WARNING:\n%s is missing or empty\n" "$(basename "${SAMPLES_FILE}")" >&2
else
    msg "Successfully created %s\n" "$(basename "${SAMPLES_FILE}")"
fi

if command -v sha256sum >/dev/null 2>&1; then
    SHA_BIN=(sha256sum)
else
    SHA_BIN=(shasum -a 256)
fi

SUMS=$(cd "$DIST_DIR" && "${SHA_BIN[@]}" -- *)
echo "$SUMS" > "${DIST_DIR}/SHA256SUMS"

msg "\n%s\n" "$SUMS"
