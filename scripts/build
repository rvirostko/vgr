#! /usr/bin/env bash
set -euo pipefail

# Usage: msg "some text"
msg() {
    if [[ -n "${NO_COLOR:-}" || ! -t 1 ]]; then
        echo "$1"
    else
        printf '\033[1m%s\033[0m\n' "$1"
    fi
}

if [[ $# -gt 1 ]]; then
    msg "ERROR: Usage: $0 [TAG]" >&2
    exit 1
fi

if [ ! -d "./src/vgr" ]; then
    msg "ERROR: You are not in the project root" >&2
    exit 1
fi

if ! python3 -m build --version >/dev/null 2>&1; then
    msg "ERROR: 'build' is not installed" >&2
    exit 1
fi

# This is all cross checks with what the CI pipeline
# thinks is going to be built
SOURCE_VERSION=$(grep -m1 '^version' pyproject.toml | sed -E 's/version *= *"(.*)"/\1/')
if [[ $# -eq 1 ]]; then
    TAG="$1"
    if [[ "$TAG" != v* ]]; then
        msg "ERROR: Invalid tag '${TAG}' — expected a tag beginning with 'v'" >&2
        exit 1
    fi
    VERSION="${TAG#v}"
    if [[ "$VERSION" != "$SOURCE_VERSION" ]]; then
        msg "ERROR: Tag version '${VERSION}' does not match source version '${SOURCE_VERSION}'" >&2
        exit 1
    fi
else
    TAG="v${SOURCE_VERSION}"
    VERSION="$SOURCE_VERSION"
fi

msg "VERSION is ${VERSION}"
msg "Release TAG is ${TAG}"

PROJECT_ROOT=$(pwd)
DIST_DIR="${PROJECT_ROOT}/dist"
SAMPLES_DIR="${PROJECT_ROOT}/samples"
CHANGELOG="${PROJECT_ROOT}/CHANGELOG.md"
SAMPLES_FILE="${DIST_DIR}/vgr-${VERSION}-samples.zip"
RELEASE_NOTES="${DIST_DIR}/vgr-${VERSION}-RELEASE-NOTES.md"

# Ensure output directory exists and is empty
rm -rf "$DIST_DIR"
mkdir -p "$DIST_DIR"

python3 -m build --quiet --outdir "$DIST_DIR"

# Grab the changes for this version
awk -v ver="$VERSION" '
    $0 ~ "^## \\[" ver "\\]" {flag=1; next}
    flag && /^## \[/ {exit}
    flag
' "$CHANGELOG" > "$RELEASE_NOTES"
if [ ! -s "$RELEASE_NOTES" ]; then
    msg "WARNING: $(basename "${RELEASE_NOTES}") is missing or empty — no CHANGELOG entry found for ${VERSION}?" >&2
else
    msg "Successfully created $(basename "${RELEASE_NOTES}")"
fi

if [ ! -d "$SAMPLES_DIR" ]; then
    msg "ERROR: $(basename "${SAMPLES_DIR}") is missing" >&2
    exit 1
fi
(cd "$SAMPLES_DIR" && git archive --format=zip --output="$SAMPLES_FILE" -9 HEAD -- .)
if [ ! -s "$SAMPLES_FILE" ]; then
    msg "WARNING: $(basename "${SAMPLES_FILE}") is missing or empty" >&2
else
    msg "Successfully created $(basename "${SAMPLES_FILE}")"
fi

if command -v sha256sum >/dev/null 2>&1; then
    SHA_BIN=(sha256sum)
else
    SHA_BIN=(shasum -a 256)
fi

SUMS=$(cd "$DIST_DIR" && "${SHA_BIN[@]}" -- *)
echo "$SUMS" > "${DIST_DIR}/SHA256SUMS"

msg "$SUMS"
