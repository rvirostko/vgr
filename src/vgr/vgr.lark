//----------------------------------------------------------
// VGR - A DSL for scripting reports
//----------------------------------------------------------

// Most of these are functionally named, but as terminals,
// you should use them anywhere the characters are required.
_CLAUSE_SEP:       ":" | "\uFF1A"   // Unicode ： (fullwidth colon)
_SEP:              "," | "\uFF0C"   // Unicode ， (fullwidth comma)
_STMT_END:         ";" | "\uFF1B"   // Unicode ； (fullwidth semicolon)
_PERIOD:           "." | "\uFF0E"   // Unicode ． (fullwidth period)
_EQ:               "=" | "\uFF1D"   // Unicode ＝ (fullwidth =)
_OPEN_SQ_BRACKET:  "[" | "\uFF3B"   // Unicode ［ (fullwidth [)
_CLOSE_SQ_BRACKET: "]" | "\uFF3D"   // Unicode ］ (fullwidth ])
_AT_SIGN:          "@" | "\uFF20"   // Unicode ＠ (fullwidth commercial at)

// Numeric values, non-decimal bases
// ASCII and fullwidth characters supported
HEX_NUMBER: /[＋+－-]?[0０][XxＸｘ](?:[_＿]?[0-9０-９A-Fa-fＡ-Ｆａ-ｆ])+/
OCT_NUMBER: /[＋+－-]?[0０][OoＯｏ](?:[_＿]?[0-7０-７])+/
BIN_NUMBER: /[＋+－-]?[0０][BbＢｂ](?:[_＿]?[0０1１])+/

// Numeric values, decimal
// All numbering systems supported, except for
// the "e" in scientific notation, where ASCII
// and fullwidth values are supported
DEC_NUMBER:   /[＋+－-]?\d(?:[_＿]?\d)*/
_SPECIAL_DEC: /\d(?:[_＿]?\d)*/
_EXP_PART:    /[EeＥｅ][＋+－-]?\d(?:[_＿]?\d)*/
_DEC_PT:      /[.．]/
// NB: slight difference from Python as this float can't end with a "."
// TODO can we make the first pattern optional?
_DECIMAL: _SPECIAL_DEC? _DEC_PT _SPECIAL_DEC
FLOAT_NUMBER: /[＋+－-]?/ (_SPECIAL_DEC _EXP_PART | _DECIMAL _EXP_PART?)

// This becomes either a FLOAT or INT (when no decimal referenced) at runtime
// NB: the "decimal point" is \u00B7
SUPERSCRIPT_FLOAT: /⁽[⁺⁻]?(?:[⁰¹²³⁴⁵⁶⁷⁸⁹]+(·[⁰¹²³⁴⁵⁶⁷⁸⁹]+)?|·[⁰¹²³⁴⁵⁶⁷⁸⁹]+)⁾|[⁺⁻]?(?:[⁰¹²³⁴⁵⁶⁷⁸⁹]+(·[⁰¹²³⁴⁵⁶⁷⁸⁹]+)?|·[⁰¹²³⁴⁵⁶⁷⁸⁹]+)/

// NB: This pattern is very long and tends to win out over keyword tokens
//     If it's priority is set lower, you need to adjust the priority on
//     ALL tokens
NAME: /{VAR_NAME}/

//----------------------------------------------------------
_all:                "All"i
_assignment:         _EQ | _to
_call_function:      "Call-Function"i | "Call"i _function?
_choose:             "Choose"i
_declare:            "Declare"i
_dictionary:         "Dictionary"i
_file_option:        "File"i
_files_option:       "File"i | "Files"i
_for_each:           "For-Each"i | _for "Each"i
_for:                "For"i
_function:           "Function"i
_headers_option:     "Header"i | "Headers"i
_list:               "List"i
_null_values_option: "Nulls"i | "Null"i "Values"i
_remove_key:         "Remove-Key"i | "Remove"i "Key"i
_repeat:             "Repeat"i
_right_arrow:        "->" | "\u2192"| "=>" | "\u21D2" // Unicode → (rightwards arrow) and ⇒ (rightwards double arrow)
_set_key:            "Set-Key"i | _set "Key"i
_set:                "Set"i
_times:              "Time"i | "Times"i
_to:                 "To"i
_unit_seconds:       "Second"i | "Seconds"i
_unless:             "Unless"i
_until:              "Until"i
_using:              "Using"i
_when:               "When"i
_while:              "While"i
//----------------------------------------------------------

//----------------------------------------------------------
// Templates
//----------------------------------------------------------
// Comma separated list
_csep_list{t_type}: t_type (_SEP t_type)*
// Used for a list of options in a statement
_options_list{t_type}: (_SEP? t_type (_SEP? t_type)*)?
//----------------------------------------------------------

opt_statements: statement*

// NB: this is the only place where we have to reference the optional statement ender
?statement: (simple_statement | select | control_statements | define_statements {EXTN_STATEMENTS}) _STMT_END?
    | _STMT_END -> pass // blank statement synonymous with "pass"

?simple_statement: abort
    | accept_input
    | add_giving
    | add_to
    | assert
    | assign
    | break
    | call
    | close
    | const
    | continue
    | debug
    | declare
    | div_by
    | echo
    | exhibit
    | exit
    | include
    | list_append
    | list_insert
    | list_prepend
    | list_remove
    | list_remove_first
    | list_remove_last
    | list_replace
    | load_from
    | log
    | mul_by
    | open
    | pass
    | print
    | printf
    | remove_key
    | reset
    | return
    | set
    | set_key_value
    | sleep
    | sort
    | source
    | sub_from
    | sub_giving
    | swap
    | unset
    | verbose
    | zip

?control_statements: block_statement
    | choose_statement
    | for_next
    | foreach_statement
    | if_statement
    | repeat_statement
    | unless_statement
    | until_statement
    | while_statement

// Some common patterns
?giving_clause: "Giving"i var_name
?option_value: "Is"i? expr
stderr: ("Error"i | "stderr"i)
stdout: ("Output"i | "stdout"i)
stdin: ("Input"i | "stdin"i)
encoding: "Encoding"i option_value

block_statement: "Begin"i _CLAUSE_SEP? statement+ "End"i -> block

call: _call_function var_name ("(" _csep_list{expr}? ")")?
    | _call_function var_name ("(" _csep_list{expr}? ")")? giving_clause -> call_giving
    | _call_function var_name _using _csep_list{expr}
    | _call_function var_name _using _csep_list{expr} giving_clause -> call_giving

declare: _declare _csep_list{var_name}
    |    _declare _csep_list{var_name} "As"i? "Local"i  -> declare_local
    |    _declare _csep_list{var_name} "As"i? "Global"i -> declare_global

function_def: "Define"i? func_modifier* _function
func_modifier: ("Constant"i | "Const"i)               -> mod_const
    |          ("Cached"i | "Cache"i) ("(" expr ")")? -> mod_cached
define_statements: function_def var_name func_params? _CLAUSE_SEP? func_body ("End-Function"i | "End"i)     -> def_function
    |              function_def var_name func_params? _right_arrow expr                                     -> def_arrow
    |              function_def var_name func_params? _right_arrow "Compile"i "(" expr ")" -> compile_arrow
// NB: doesn't work with template; probably should be changed to use var_name anyway
func_params: "(" (NAME (_SEP NAME)*)? ")" -> params
func_body: statement+ -> body

foreach_statement: _for_each var_name "In"i expr _CLAUSE_SEP? statement+ _end_for -> foreach
    |              _for_each var_name "In"i expr _right_arrow statement           -> foreach

for_next: _for var_name _EQ expr _to expr _CLAUSE_SEP? statement+ _end_for
    |     _for var_name _EQ expr _to expr "Step"i expr _CLAUSE_SEP? statement+ _end_for -> for_next_by
_end_for: "End-For"i | "Next"i | "End"i

if_statement: if_immediate | if else_if* else? ("End-If"i | "End"i)
if: "If"i expr _then_sep? statement+
if_immediate: "If"i expr _right_arrow statement -> if
else_if: ("Else-If"i | "ElseIf"i) expr _then_sep? statement+
else: "Else"i _CLAUSE_SEP? statement+
_then_sep: ("Then"i | _CLAUSE_SEP)

unless_statement: _unless expr _CLAUSE_SEP? statement+ ("End-Unless"i | "End"i) -> unless
    |             _unless expr _right_arrow statement                           -> unless

repeat_statement: _repeat expr _times? _CLAUSE_SEP? statement+ ("End-Repeat"i | "End"i) -> repeat
    |             _repeat expr _times? _right_arrow statement                           -> repeat

until_statement: _until expr _CLAUSE_SEP? statement+ ("End-Until"i | "End"i) -> until
    |            _until expr _right_arrow statement                          -> until

while_statement: _while expr _CLAUSE_SEP? statement+ ("End-While"i | "End"i) -> while
    |            _while expr _right_arrow statement                          -> while

break: "Break"i
continue: "Continue"i

return: "Return"i expr?

_eq_operators: ("==" | "\uFF1D\uFF1D" | "\u2A75" | "Equals"i | "Is"i | "Is"i? "Equal"i _to)         // Unicode ＝ (fullwidth =) and ⩵ (two consecutive equals signs)
_neq_operators: ("!=" | "\u2260" | "<>" | "\u00AC=" | "Is"i "Not"i | "Is"i? "Not"i "Equal"i _to)    // Unicode ≠ (not eq) and ¬ (not)
_exact_eq_operators: "===" | "\uFF1D\uFF1D\uFF1D" | "\u2A76" | "\u2261"                             // Unicode ＝ (fullwidth =), ⩶ (three consecutive equals signs) and ≡ (identical to)
_lt_operators: ("<" | "\uFF1C" | "Is"i? "Less"i "Than"i)                                            // Unicode ＜ (fullwidth <)
_gt_operators: (">" | "\uFF1E" | "Is"i? "Greater"i "Than"i)                                         // Unicode ＞ (fullwidth >)
_le_operators: ("<=" | "\u2264" | "\u00AC>" | "!>" | "Is"i? "Not"i "Greater"i "Than"i)              // Unicode ≤ (less than or equal to) and ¬ (not)
_ge_operators: (">=" | "\u2265" | "\u00AC<" | "!<" | "Is"i? "Not"i "Less"i "Than"i)                 // Unicode ≥ (greater than or equal to) and ¬ (not)
_matches_operators: "~" | "Matches"i
_not_matches_operators: "!~" | "Not"i "~" | "Does"i "Not"i "Match"i
_matches_all_operators: "Matches"i _all
_contains_operators: "Contains"i
_not_contains_operators: "Does"i "Not"i "Contain"i
_contains_all_operators: "Contains"i _all
_is_in_operators: ("Is"i "In"i) | "\u2208"                                                          // Unicode ∈ (element of)
_not_is_in_operators: ("Is"i? "Not"i "In"i) | "\u2209"                                              // Unicode ∉ (not an element of)
_is_empty_operators: "Is"i "Empty"i
_is_not_empty_operators: "Is"i? "Not"i "Empty"i
_is_positive_operators: ("Is"i "Positive"i | "Is"i? "Not"i "Negative"i)
_is_negative_operators: ("Is"i "Negative"i | "Is"i? "Not"i "Positive"i)
_is_even_operators: ("Is"i "Even"i | "Is"i? "Not"i "Odd"i)
_is_odd_operators: ("Is"i "Odd"i | "Is"i? "Not"i "Even"i)
_is_defined_operators: "Is"i ("Defined"i | "Not"i "Undefined"i)
_is_undefined_operators: "Is"i ("Undefined"i | "Not"i "Defined"i)
_is_const_operators: "Is"i ("Constant"i | "Const"i)
_is_not_const_operators: "Is"i "Not"i ("Constant"i | "Const"i)

_slice_operator: _OPEN_SQ_BRACKET slice_arg _CLAUSE_SEP slice_arg (_CLAUSE_SEP slice_arg)? _CLOSE_SQ_BRACKET
slice_arg: expr?

choose_statement: _choose choose_all?             _CLAUSE_SEP? choice_block* otherwise_block? ("End-Choose"i | "End"i) -> choose
    |             _choose choose_all? _using expr _CLAUSE_SEP? values_block* otherwise_block? ("End-Choose"i | "End"i) -> choose_using
choice_block: _when expr _CLAUSE_SEP? statement+
values_block: _when _is_empty_operators _CLAUSE_SEP? statement+                   -> is_empty_block
    |         _when _is_not_empty_operators _CLAUSE_SEP? statement+               -> is_not_empty_block
    |         _when _is_positive_operators _CLAUSE_SEP? statement+                -> is_pos_block
    |         _when _is_negative_operators _CLAUSE_SEP? statement+                -> is_neg_block
    |         _when _is_even_operators _CLAUSE_SEP? statement+                    -> is_even_block
    |         _when _is_odd_operators _CLAUSE_SEP? statement+                     -> is_odd_block
    |         _when _is_defined_operators _CLAUSE_SEP? statement+                 -> is_defined_block
    |         _when _is_undefined_operators _CLAUSE_SEP? statement+               -> is_undefined_block
    |         _when _is_const_operators _CLAUSE_SEP? statement+                   -> is_const_block
    |         _when _is_not_const_operators _CLAUSE_SEP? statement+               -> is_not_const_block
    |         _when expr _through expr _CLAUSE_SEP? statement+                    -> range_block
    |         _when "Not"i expr _through expr _CLAUSE_SEP? statement+             -> not_range_block
    // These operators work with a single value
    |         _when (op_lt | op_gt | op_ge | op_le) expr _CLAUSE_SEP? statement+  -> ineq_block
    // This is a specialized version of "Not Equals"
    |         _when "Not"i value_list _CLAUSE_SEP? statement+                     -> not_values_block
    // These operators work with one or more values
    // Note that the "op"s are optional, with the default being op_eq
    |         _when (op_eq | op_ne | op_xeq | op_contains | op_not_contains | op_contains_all | op_is_in | op_not_is_in | op_matches | op_not_matches | op_matches_all)? value_list _CLAUSE_SEP? statement+
value_list: _csep_list{expr}
otherwise_block: "Otherwise"i _CLAUSE_SEP? statement+
choose_all: _all
_through: "Through"i | "Thru"i | _to
op_eq: _eq_operators
op_ne: _neq_operators
op_xeq: _exact_eq_operators
op_lt: _lt_operators
op_gt: _gt_operators
op_le: _le_operators
op_ge: _ge_operators
op_matches: _matches_operators
op_not_matches: _not_matches_operators
op_matches_all: _matches_all_operators
op_contains: _contains_operators
op_not_contains: _not_contains_operators
op_contains_all: _contains_all_operators
op_is_in: _is_in_operators
op_not_is_in: _not_is_in_operators

// simple boolean on/off, true/false
debug:   "Debug"i    "On"i  -> debug_on
    |    "Debug"i    "Off"i -> debug_off
    |    "Debug"i    expr?
echo:    "Echo"i     "On"i  -> echo_on
    |    "Echo"i     "Off"i -> echo_off
    |    "Echo"i     expr?
verbose: "Verbose"i  "On"i  -> verbose_on
    |    "Verbose"i  "Off"i -> verbose_off
    |    "Verbose"i   expr?

pass: ("Pass"i | "Nop"i)

accept_input: ("Accept-Input"i | "Accept"i "Input"i) ("From"i stdin)? _to? var_name accept_input_option?
?accept_input_option: "Echo"i        -> echo
    | ("No-Echo"i | ("No"i "Echo"i)) -> no_echo
    | "Secure"i                      -> secure

sleep: "Sleep"i _for? expr _unit_seconds?

// NB: This is one of the parsing start points which is used for --assign.
//     It is effectively "set" without the leading statement
//     and only simple assignment can be performed.
cmd_line_assign: var_name _assignment expr -> set

_set_var: var_name (_assignment | SET_OP) expr
set:  _set _csep_list{_set_var}
    | _set var_name "Up"i   "By"i expr                        -> set_up
    | _set var_name "Down"i "By"i expr                        -> set_down
    | _set "Corresponding"i expr "In"i _dictionary? var_name  -> set_corresponding
SET_OP: ("+=" | "-=" | "*=" | "/=" | "%=" | "**=" | "&=" | "|=" | "^=" | "<<=" | ">>=" )
// Alternate to "Set" to get around conflicts
_assign_var: expr _to var_name
assign: "Assign"i _csep_list{_assign_var}

const_set: var_name ((_EQ | "Is"i) expr)?
const: ("Constant"i | "Const"i) _csep_list{const_set}

add_to:     "Add"i _csep_list{expr} _to var_name
add_giving: "Add"i _csep_list{expr} _to expr "Giving"i var_name

sub_from:   "Subtract"i _csep_list{expr} "From"i var_name
sub_giving: "Subtract"i _csep_list{expr} "From"i expr "Giving"i var_name

mul_by: "Multiply"i var_name "By"i _csep_list{expr}
div_by: "Divide"i   var_name "By"i _csep_list{expr}

set_key_value: _set_key    expr "In"i   _dictionary? var_name (_assignment expr)?
remove_key:    _remove_key expr "From"i _dictionary? var_name

swap: "Swap"i var_name ("With"i | "And"i) var_name

unset: "Unset"i _csep_list{var_name}

reset: "Reset"i _options_list{reset_opt}
?reset_opt: _all         -> all
    |       "Args"i      -> args
    |       "Constants"i -> consts
    |       "Caches"i    -> caches
    |       "Data"i      -> data
    |       "Includes"i  -> includes
    |       "Output"i    -> output

source: "Source"i _files_option? _csep_list{expr}
include: "@Include"i _files_option? _csep_list{expr}

load_from: "Load"i var_name ("From"i | "With"i) _file_option? expr _options_list{load_from_opts}
?load_from_opts: encoding
    |            ("Type"i "Is"i?)? load_source_type
    |            "Giving"i var_name -> giving
load_source_type: "CSV"i                            -> csv_file
    |             "HCL"i                            -> hcl_file
    |             "INI"i                            -> ini_file
    |             "JSON"i "Object"i?                -> json_object
    |             "JSON"i "Object"i? "Per"i "Line"i -> json_objects
    |             "Text"i                           -> text_file
    |             "Text"i? "Lines"i                 -> text_lines
    |             "YAML"i                           -> yaml_file

abort: "Abort"i _csep_list{expr}?
assert: "Assert"i expr (_CLAUSE_SEP _csep_list{expr})?

print:  "Print"i  _csep_list{expr} print_channel? _options_list{print_option}
printf: "Printf"i _csep_list{expr} print_channel? _options_list{printf_option}
?print_channel: _to (stderr | stdout) // -> stderr or stdout
    |           "As"i "Markdown"i          -> markdown
?print_sep_opt: (("Field"i "Separator"i) | "OFS"i) option_value  -> ofs
    |           (("Record"i "Separator"i) | "ORS"i) option_value -> ors
?print_flush_opt: ("Flush"i) option_value?                       -> flush
    |             ("No-Flush"i) option_value?                    -> no_flush
?print_option: print_sep_opt | print_flush_opt
?printf_option: print_flush_opt

exhibit: "Exhibit"i "*" // exhibit all
    |    "Exhibit"i var_name (_SEP? var_name)*

log: "Log"i log_level _csep_list{expr}
   | "Log"i "Level"i log_level -> log_setlevel
?log_level: "Debug"i -> debug
    | "Info"i -> info
    | ("Warn"i | "Warning"i) -> warn
    | "Error"i -> error
    | "Critical"i -> critical
    | "Off"i -> off

open: "Open"i (stderr | stdout | stdin) _file_option? expr _options_list{open_option}
?open_option: encoding | open_mode
?open_mode: ("Append"i | "Extend"i) -> a
    |       "Overwrite"i            -> w
    |       "No"i "Overwrite"i      -> x
    |       "Read"i                 -> r
close: "Close"i (stderr | stdout | stdin) _file_option?

zip: ("Create-Zip"i | "Create"i "Zip"i) _file_option? expr _options_list{zip_option}
?zip_option: open_mode
    | "Comment"i option_value -> comment
    | "Keep"i? "Paths"i       -> keep_paths
    | "Junk"i "Paths"i        -> junk_paths
    | "Include"i expr         -> include
    | "Exclude"i expr         -> exclude

exit: "Exit"i expr?

sort: "Sort"i sort_source sort_keys? unique_clause? sort_giving?
sort_source: sort_obj -> source
sort_giving: "Giving"i sort_obj -> target
?sort_obj: _file_option expr (_SEP? load_from_opts)* -> file
    | var_name -> var
sort_keys: ("On"i | "By"i) _csep_list{sort_key} -> keys
sort_key: sort_dir? "Key"i? expr -> key
?sort_dir: ("Ascending"i | "Asc"i) -> sort_asc
    | ("Descending"i | "Des"i) -> sort_des
unique_clause: "Unique"i ("On"i _csep_list{expr})? -> unique

list_append:       "Append"i  list_all? expr _to _list? var_name
list_prepend:      "Prepend"i list_all? expr _to _list? var_name
list_insert:       "Insert"i  list_all? expr "Into"i _list? var_name "At"i ("Position"i | "Index"i)? expr
list_remove:       "Remove"i ("Position"i | "Index"i)? expr "From"i _list? var_name giving_clause?
list_remove_first: "Remove"i "First"i "Item"i? "From"i _list? var_name giving_clause?
list_remove_last:  "Remove"i "Last"i "Item"i? "From"i _list? var_name giving_clause?
list_replace:      "Replace"i ("Position"i | "Index"i)? expr "In"i _list? var_name "With"i expr giving_clause?
list_all: _all

_records: ("Record"i | "Records"i)
_columns: ("Column"i | "Columns"i)

select: "Select"i _records? select_outputs from_clause where_clause? product_clause? limit_clause? for_clause? into_clause?

?select_outputs: _csep_list{select_output} _SEP?
select_output: "*"   -> output_all
    | expr as_clause -> output_as
    | expr           -> output
?as_clause: "As"i expr

?from_clause: "From"i (expr_from | file_from)
expr_from: expr as_clause?
file_from: _file_option expr (_SEP? (load_from_opts | as_clause))*

where_clause: "Where"i _csep_list{expr}

product_clause: "Cartesian"i? "Product"i "Of"i? _columns? product_cols
product_cols: (_all | "*") -> product_all
    |         _csep_list{expr}

limit_clause: "Limit"i "Input"i option_value _records? (_SEP? "Offset"i option_value)? -> limit_input
    |         "Limit"i          option_value _records? (_SEP? "Offset"i option_value)? -> limit_output

?for_clause: _for (for_json | for_csv | for_markdown | for_text | for_template)

into_clause: "Into"i var_name
    | "Into"i (stdout | stderr)
    | "Into"i _file_option expr _options_list{open_option}

for_json: "JSON"i _options_list{json_option}
?json_option: exclude_nulls | include_nulls
    | "Root"i option_value?                        -> root
    | "Indent"i option_value?                      -> indent
    | "Compact"i option_value?                     -> compact
    | "Array"i "Wrapper"i option_value?            -> array_wrapper
    | ("Sort"i "Keys"i? | "Sorted"i) option_value? -> sort_keys

for_csv: "CSV"i _options_list{csv_option}
?csv_option: include_headers | exclude_headers
    | "Delimiter"i _character_option? option_value -> delimiter
    | "Quote"i _character_option option_value      -> quotechar
    | "Escape"i _character_option option_value     -> escapechar
    | "Line"i "Terminator"i option_value           -> lineterminator
    | "Quoting"i "Style"i option_value             -> quoting
_character_option: "Char"i | "Character"i

for_markdown: "MarkDown"i _options_list{markdown_option}
?markdown_option: include_headers | exclude_headers

for_template: template_type? ("Template"i | "Jinja"i | "Jinja2"i) (template_filename | "Default"i)? _options_list{template_option}
?template_type: "Record"i -> record
    |           "Batch"i  -> batch
template_filename: _file_option? expr
?template_option: include_headers | exclude_headers
    | "Auto"i "Escape"i option_value?                   -> auto_escape
    | "Trim"i "Blocks"i? option_value?                  -> trim_blocks
    | "Left"i "Strip"i "Blocks"i? option_value?         -> lstrip_blocks
    | "Keep"i "Last"i "Newline"i option_value?          -> keep_last_newline
    | "Chain"i "Undefined"i "Variables"i? option_value? -> chain_undefined

for_text: "Text"i _options_list{for_text_option}
?for_text_option: include_headers | exclude_headers
    | "Field"i "Separator"i option_value  -> field_sep
    | "Header"i "Separator"i option_value -> header_sep
    | "Record"i "Separator"i option_value -> record_sep

include_headers: "Include"i _headers_option option_value?
exclude_headers: "Exclude"i _headers_option option_value?
exclude_nulls: "Exclude"i _null_values_option option_value?
include_nulls: "Include"i _null_values_option option_value?

?expr: ternary | and_expr

// NB: Python style has multiple grammar issues
//     and while we diferentiate the style by name,
//     it is unlikely that anything other than a
//     'C'/Java style will be supported.
ternary: expr ("?" | "\uFF1F") expr _CLAUSE_SEP expr -> c_ternary              // Unicode ？(fullwidth ?)

?and_expr: or_expr
    | or_expr (("&&" | "\uFF06\uFF06" | "\u2227" | "And"i) or_expr)+ -> and_op // Unicode ＆ (fullwidth &) and ∧ (conjunction)

?or_expr: expr2
    | expr2 (("||" | "\uFF5C\uFF5C" | "\u2228" | "Or"i) expr2)+ -> or_op       // Unicode ｜ (fullwidth vertical bar) and ∨ (disjunction)

// Flattening operations out here allows the parse tree to hold
// the operation type explicitly instead of a generic "OP" where
// we need to deal with aliases.
// NB: subscripts cannot be used with var_name, thus they
//     cannot be used when invoking user functions
?expr2: atom
    # Reserved: not working
    #| (var_name ":=" expr)                       -> assignment_expr
    | "(" expr ")"
    // must be expr2 not expr else it binds across and/or
    | ("!" | "\uFF01" | "\u00AC") expr2 -> unary_not // Unicode ！(fullwidth excl) and ¬ (logical not)
    | expr2 _PERIOD dotfunction                        -> dotfunction_call
    | expr2 _PERIOD NAME                               -> deref
    | expr2 (_OPEN_SQ_BRACKET expr _CLOSE_SQ_BRACKET)+ -> subscript
    | expr2 _slice_operator                            -> slice
    | expr2 _PERIOD _AT_SIGN var_name "(" _csep_list{expr}? ")" -> invoke_func_inline
    | _AT_SIGN var_name "(" _csep_list{expr}? ")"               -> invoke_func
    | function                                         -> function_call
    | expr2 _is_negative_operators                     -> is_negative_op
    | expr2 _is_positive_operators                     -> is_positive_op
    | expr2 _is_even_operators                         -> is_even_op
    | expr2 _is_odd_operators                          -> is_odd_op
    | expr2 _is_defined_operators                      -> is_defined_op
    | expr2 _is_undefined_operators                    -> is_undefined_op
    | expr2 _is_const_operators                        -> is_const_op
    | expr2 _is_not_const_operators                    -> is_not_const_op
    | expr2 _is_empty_operators                        -> is_empty_op
    | expr2 _is_not_empty_operators                    -> is_not_empty_op
    // Binary operators
    | expr2 ("+" | "\uFF0B") expr2                     -> add_op     // Unicode ＋ (fullwidth plus)
    | expr2 ("-" | "\uFF0D" | "\u2212") expr2          -> sub_op     // Unicode － (fullwidth minus) and − (minus sign)
    | expr2 ("*" | "\uFF0A" | "\u00D7") expr2          -> mul_op     // Unicode ＊ (fullwidth asterisk) and × (multiplication)
    | expr2 ("/" | "\uFF0F" | "\u00F7") expr2          -> div_op     // Unicode ／ (fullwidth solidus) and ÷ (division)
    | expr2 ("%" | "\uFF05") expr2                     -> mod_op     // Unicode ％ (fullwidth percent sign)
    | expr2 ("**" | "\uFF0A\uFF0A") expr2              -> pow_op     // Unicode ＊ (fullwidth asterisk)
    | expr2 ("&" | "\uFF06") expr2                     -> bit_and_op // Unicode ＆ (fullwidth ampersand)
    | expr2 ("|" | "\uFF5C") expr2                     -> bit_or_op  // Unicode ｜ (fullwidth vertical bar)
    | expr2 ("^" | "\uFF3E") expr2                     -> bit_xor_op // Unicode ＾ (fullwidth circumflex)
    | expr2 ("<<" | "\uFF1C\uFF1C") expr2              -> shl_op     // Unicode ＜ (fullwidth less than)
    | expr2 (">>" | "\uFF1E\uFF1E") expr2              -> shr_op     // Unicode ＞ (fullwidth greater than)
    // Relation operators bools
    | expr2 _exact_eq_operators expr2                  -> exact_eq_op
    | expr2 _eq_operators expr2                        -> eq_op
    | expr2 _neq_operators expr2                       -> neq_op
    | expr2 _lt_operators expr2                        -> lt_op
    | expr2 _gt_operators expr2                        -> gt_op
    | expr2 _le_operators expr2                        -> le_op
    | expr2 _ge_operators expr2                        -> ge_op
    | expr2 _is_in_operators expr2                     -> in_op
    | expr2 _not_is_in_operators expr2                 -> not_in_op
    | expr2 _contains_operators expr2                  -> contains_op
    | expr2 _not_contains_operators expr2              -> not_contains_op
    | expr2 _contains_all_operators expr2              -> contains_all_op
    | expr2 _matches_operators expr2                   -> matches_op
    | expr2 _not_matches_operators expr2               -> not_matches_op
    | expr2 _matches_all_operators expr2               -> matches_all_op
    // Misc operators
    | "\u2308" expr "\u2309"                            -> ceil_op      // Unicode ceiling ⌈ x ⌉
    | "\u230A" expr "\u230B"                            -> floor_op     // Unicode floor ⌊ x ⌋
    | expr2 SUPERSCRIPT_FLOAT                           -> pow_op
    // NB: neither of the following work with trailing commas if you use the template
    | _OPEN_SQ_BRACKET (expr (_SEP expr)*)? _SEP? _CLOSE_SQ_BRACKET -> array        // [], [x], [x,y], [x,y,]
    | "{" (_dict_entry (_SEP _dict_entry)*)? _SEP? "}"  -> dict                     // {}, {x:y}, {a:b,x:y}, {a:b,x:y,}

_dict_entry: expr _CLAUSE_SEP expr // key and value

?atom: ("None"i  | "\u2205" | "Null"i) -> vnone         // Unicode ∅ (Empty set)
    // Boolean constants
    | "True"i               -> vtrue
    | "False"i              -> vfalse
    // Numeric figurative constants
    | "Nan"i                -> vnan
    | "Zero"i               -> vzero                    // becomes int 0
    | ("Inf"i   | "\u221E") -> vinf                     // Unicode ∞ (infinity)
    // Character figurative constants
    // These are here to support structured text formats (CSV, JSON, et al)
    // and is intentionally NOT a "punctuation catalog"
    | "Colon"i              -> vcolon                   // becomes ':'
    | "Comma"i              -> vcomma                   // becomes ','
    | "Newline"i            -> vnewline                 // becomes '\n'
    | "Period"i             -> vperiod                  // becomes '.'
    | "Quote"i              -> vquote                   // becomes '"'
    | "Space"i              -> vspace                   // becomes " "
    | "Tab"i                -> vtab                     // becomes '\t'
    | "Escape"i             -> vescape                  // becomes '\x1b'
    | "Backslash"i          -> vbackslash               // becomes '\\'
    // Values that closely follow Python and other lanuages
    | HEX_NUMBER | BIN_NUMBER | OCT_NUMBER | DEC_NUMBER // becomes INT at runtime
    | FLOAT_NUMBER                                      // becomes FLOAT at runtime
    | REGEX                                             // becomes Pattern at runtime
    | STRING
    | NAME -> var_ref

var_name: NAME (_PERIOD NAME)*

{EXTN_GRAMMAR}

{FUNCTIONS}

// Regex contents:
//   * Cannot be empty (ie "r//" : that's a comment!)
//   * \[/\] : an escaped "/" or "\"
//   * [^/, [/, and /] : "/" escaped by a character group (but only first/last)
//   * [^\x00-\x1f\x7f\/] : not a control character or a "/"
//   * flags: optional, must be lowercase and immediately follow the closing "/"
//   * locale flag not supported because it only works with bytes
//   * unicode flag not supported because it is redundant
//   * template flag not supported as obsolete
REGEX.2: /r\/(?:(?:\\[\/\\])|(?:\[^\/)|(?:\[\/)|(?:\/\])|(?:[^\x00-\x1f\x7f\/]))+\/[adimsx]*/

_RAW_STRING:          /[Rr]("(?!"").*?"|'(?!'').*?')/
_RAW_TRIPLE_STRING:   /[Rr](""".*?"""|'''.*?''')/s
_RAW_T_DQUOTE_STRING: /[Rr]\u201C.*?\u201D/
_RAW_T_SQUOTE_STRING: /[Rr]\u2018.*?\u2019/

_ESC_STRING:          /("(?!"").*?(?<!\\)(\\\\)*?"|'(?!'').*?(?<!\\)(\\\\)*?')/
_ESC_TRIPLE_STRING:   /(""".*?(?<!\\)(\\\\)*?"""|'''.*?(?<!\\)(\\\\)*?''')/s
_ESC_T_DQUOTE_STRING: /\u201C.*?(?<!\\)(\\\\)*?\u201D/
_ESC_T_SQUOTE_STRING: /\u2018.*?(?<!\\)(\\\\)*?\u2019/

STRING: _RAW_STRING
    |   _RAW_TRIPLE_STRING
    |   _RAW_T_DQUOTE_STRING
    |   _RAW_T_SQUOTE_STRING
    |   _ESC_STRING
    |   _ESC_TRIPLE_STRING
    |   _ESC_T_DQUOTE_STRING
    |   _ESC_T_SQUOTE_STRING

SH_COMMENT.4: /#[^\n]*/
CPP_COMMENT.4: /\/\/[^\n]*/
C_COMMENT.4: "/*" /(.|\n)*?/ "*/"

%import common.WS
%ignore WS
%ignore SH_COMMENT
%ignore C_COMMENT
%ignore CPP_COMMENT
