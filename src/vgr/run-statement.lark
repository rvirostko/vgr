// Experimental

// Questions:
// What is the impact on multi threading on parts of the DD?

// Submit is similar in structure to "Call Function"
// TODO make improvements to the arg construction and re-use
//      the whole pattern here for the call
submit_statement: _submit var_name ("(" _csep_list{expr}? ")")? giving_clause?
    |             _submit var_name "Using"i _csep_list{expr} giving_clause?

// First variant is for parallel tasks
// Second is for a single task invoked multiple times
parallel: _run_parallel giving_clause? _CLAUSE_SEP? submit_statement+ _end_parallel
    |     _run_parallel _for_each var_name "In"i expr giving_clause? _CLAUSE_SEP? submit_statement _end_parallel

// TODO reuse these where possible
_for_each: ("For-Each"i | "For"i "Each"i)
_end_parallel: ("End-Parallel"i | "End"i)
_run_parallel: ("Run-Parallel"i | "Run"i "Parallel"i)
_run_shell: ("Run-Shell"i | "Run"i "Shell"i)
_run_command: ("Run-Command"i | "Run"i "Command"i)
_submit: ("Submit-Function"i | "Submit"i "Function"i?)

// Run Parallel Pool Size Is 30 Giving results
//   Submit Foo(a,b,c) Giving f_results
//   Submit Bar(d,e) Giving b_results
// # On-Error # part of standard block events
// On-Finish # part of standard block events
//   # f_results and b_results are defined here as locals
//   # results is define in parent frame and available here
//   # size is two: [f_results + b_results]
//   Print f_results, b_results
// End-Parallel
//
// Run Parallel Pool(n) For Each v In values Giving results
//   Submit Foo(v,a) # Giving clause here is meaningless but allowed
// End-Parallel
// # results is a list with returned values in order submitted

