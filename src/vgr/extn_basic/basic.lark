?basic_statements: basic_continue
    | basic_do_until
    | basic_do_while
    | basic_for_next_by
    | basic_for_next
    | basic_for_each
    | basic_exit
    | basic_let
    | basic_troff
    | basic_tron

// Note:
// An optional ":" is allowed following control statements.
// While not part of the BASIC syntax, most VGR syntax uses it, so it is
// optional here to prevent excessive syntax errors. The same goes with "End".

// The defining BASIC-ness is the Do/Loop bracketing, which affects the
// Exit/Continue that can be used within them.
// Note that the "Do ... While/Until expr" variants are not supported.
basic_do_while: "Do"i "While"i expr ":"? statement+ ("Loop"i | "End"i) _SEMICOLON?
basic_do_until: "Do"i "Until"i expr ":"? statement+ ("Loop"i | "End"i) _SEMICOLON?

basic_for_next_by: "For"i var_name "=" expr "To"i expr "Step"i expr ":"? statement+ ("Next"i | "End"i) _SEMICOLON?
basic_for_next: "For"i var_name "=" expr "To"i expr ":"? statement+ ("Next"i | "End"i) _SEMICOLON?
# Note: this is just an alias to VGR's statement
basic_for_each: "For"i "Each"i var_name "In"i expr ":"? statement+ ("Next"i | "End"i) _SEMICOLON? -> foreach

// Note that these patterns can span across lines and possibly
// incorrectly associate statements. While unlikely, as the code
// following an Exit/Continue should be dead code, it is possible.
basic_exit: "Exit"i "Do"i _SEMICOLON? -> basic_exit_do
    | "Exit"i "For"i _SEMICOLON? -> basic_exit_for
    | "Exit"i "While"i _SEMICOLON? -> basic_exit_while
basic_continue: "Continue"i "Do"i _SEMICOLON? -> basic_continue_do
    | "Continue"i "For"i _SEMICOLON? -> basic_continue_for
    | "Continue"i "While"i _SEMICOLON? -> basic_continue_while

basic_let: "Let"i var_name "=" expr _SEMICOLON?

basic_troff: "Troff"i _SEMICOLON?
basic_tron: "Tron"i _SEMICOLON?
