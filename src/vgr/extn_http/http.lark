// Grammar for the Http statement family
//
// Three top-level statements:
//   http_connect    — establishes a named httpx.Client connection (connection pool)
//   http_disconnect — tears down a named connection
//   http_request     — performs a single HTTP interaction (GET, POST, etc.)
//
// Options are grouped into reusable rule sets:
//   http_conn_opt   — options valid only at connect time (connection-level concerns)
//   http_auth_opt   — authentication options, valid for both connect and request
//   http_req_opt    — request-level options, valid for both connect and request
//   http_request_opt — options valid only on an request (body, giving, using)
//
// General conventions:
//   - Options are separated by optional commas (linguistic alignment)
//   - Semicolons optionally terminate statements
//   - "Is"/"Are" are optional softening words throughout
//   - Boolean options follow a trinary model: bare = True, "Is <expr>" = explicit,
//     absent = None (httpx default applies). Conflicts are bind-time errors.
//   - Last-write for non-bool options is a bind-time conflict error to prevent
//     non-astonishing behavior in failing scripts.

?http_statements: "Http"i -> http_help // acts as a "pass", providing a help anchor
    //----------------------------------------------------------------------------
    // Connect
    // Establishes a named httpx.Client with a base URL and shared defaults.
    // The base URL must resolve to a string with a valid scheme (http/https).
    // Handler enforces trailing slash on base URL before passing to httpx.Client.
    // Named via "As <expr>" for reference in subsequent http_request statements.
    //----------------------------------------------------------------------------
    | "Http"i "Connect"i ("To"i | "URL"i "Is"i?)? expr _options_list{http_conn_arg} -> http_connect
    //----------------------------------------------------------------------------
    // Disconnect
    // Tears down a named connection, closing the underlying httpx.Client and
    // releasing pooled connections.
    //----------------------------------------------------------------------------
    | "Http"i "Disconnect"i "From"i? expr -> http_disconnect
    //----------------------------------------------------------------------------
    // Request
    // Performs a single HTTP interaction against an optional named connection.
    // Method is either a keyword or a dynamic expr (validated at execution time).
    // URL rules:
    //   - With "Using": expr is a path appended to the connection base URL.
    //     Handler enforces no double-slash at the join point.
    //   - Without "Using": expr must be a fully qualified URL including scheme.
    //     A missing or invalid URL is a bind-time error — it cannot be defaulted.
    //----------------------------------------------------------------------------
    | "Http"i (("Method"i | "Request"i) "Is"i?)? http_method _SEP? ("URL"i "Is"i?)? expr _options_list{http_request_arg} -> http_request

?http_conn_arg: http_conn_opt
    | http_auth_opt
    | http_req_opt
    | "As"i expr -> hopt_connection_name // names the connection

// Method as keyword (preferred — unambiguous, readable) or dynamic expr.
// Dynamic expr resolved to a HTTP method string at execution time.
// NB: Connect (in RFC9110) conflicts with the connect statement; quote it
?http_method: "Delete"i -> hmethod_delete
    | "Get"i            -> hmethod_get
    | "Head"i           -> hmethod_head
    | "List"i           -> hmethod_list # not RFC9110 but common
    | "Options"i        -> hmethod_options
    | "Patch"i          -> hmethod_patch
    | "Post"i           -> hmethod_post
    | "Put"i            -> hmethod_put
    | "Trace"i          -> hmethod_trace
    | expr              -> hmethod_dynamic # can be any value

?http_request_arg: http_auth_opt
    | http_req_opt
    | http_request_opt

//----------------------------------------------------------------------------
// http_conn_opt — connection-level options (connect only)
// These govern the httpx.Client itself, not individual requests.
// SSL options apply to all requests made on this connection.
// HTTP version constrains the entire connection pool.
//
// * Verify SSL : SSL verification — trinary bool. Bare form implies True.
//   "Is False" disables verification (use with caution).
//   Conflicts with CA Certificate Is (which implies verification on) are bind-time errors.
// * CA Certificate :in-memory PEM string, NOT a file path.
//   Passed to ssl.SSLContext.load_verify_locations(cadata=...).
//   Implies Verify SSL Is True. Conflicts with Verify SSL Is False.
// * Connect Timeout : governs connection establishment only.
//   Separated from read/write timeouts as it is a pool-level concern.
// * HTTP Version : protocol version — constrains the entire connection pool.
//   Constrained values: 1, 1.1, 2 — other values are bind-time errors.
// * Maximum redirect : only meaningful when Follow Redirects is True.
//----------------------------------------------------------------------------
?http_conn_opt: ("Verify"i "SSL"i) option_value?         -> hopt_verify_ssl       // bool
    | "Connect"i "Timeout"i option_value _unit_seconds?  -> hopt_connect_timeout  // int/float: seconds
    | "HTTP-Version"i option_value                       -> hopt_http_version     // constrained: 1, 1.1, 2
    | ("Maximum"i | "Max"i) ("Redirect"i | "Redirects"i) option_value -> hopt_max_redirects // int

// Disable until we have a proper usecase to test...
//    | "CA"i ("Certificate"i | "Cert"i) option_value -> hopt_ca_cert         // string: PEM content

// ---------------------------------------------------------------------------
// http_auth_opt — authentication options (connect and request)
// User, Password, and Authentication Is work together.
// Authentication Is is constrained to "basic" and "digest".
// User and Password without Authentication Is defaults to "basic".
// Handler composes httpx auth object from the three at execution time.
// ---------------------------------------------------------------------------
?http_auth_opt: "User"i option_value                         -> hopt_user     // string
    | "Password"i option_value                               -> hopt_password // string
    | ("Authentication"i | "Auth"i) "Is"i? http_auth_method -> hopt_authentication

?http_auth_method: "Basic"i -> hauth_basic
    | "Digest"i             -> hauth_digest
    | expr                  -> hauth_dynamic

// ---------------------------------------------------------------------------
// http_req_opt — request-level options (connect and request)
// At connect level these become httpx.Client defaults, merged with
// per-request values at request time (request-level takes priority).
//
// * Header/Headers : string "name:value", list[string], dict
// * Parameter/Parameters : string "name=value", list[string], dict
// * Timeout : Total timeout — covers the full request lifecycle.
//   A missing timeout is acceptable — httpx default applies.
// * Read/Write Timeout : Read and write timeouts — per-request data
//   transfer concerns.
// * Follow Redirect : Redirect following — trinary bool. httpx defaults
//   to False (does not follow redirects). Bare form implies True.
// ---------------------------------------------------------------------------
?http_req_opt: ("Header"i | "Headers"i) ("Is"i | "Are"i)? expr -> hopt_headers // by type
    | ("Param"i | "Parameter"i | "Parameters"i) ("Is"i | "Are"i)? expr -> hopt_parameters // by type
    | "Timeout"i option_value _unit_seconds?               -> hopt_timeout          // int/float: seconds
    | "Read"i "Timeout"i option_value _unit_seconds?       -> hopt_read_timeout     // int/float: seconds
    | "Write"i "Timeout"i option_value _unit_seconds?      -> hopt_write_timeout    // int/float: seconds
    | "Follow"i ("Redirect"i | "Redirects"i) option_value? -> hopt_follow_redirects // bool

//----------------------------------------------------------------------------
// http_request_opt — request-only options
//
// * Using : Named connection reference — the expr must resolve to a
//   known connection name.
// * Body : Body content.
//   Type-driven defaulting rules
//     * dict, list → JSON serialized,
//       Content-Type: application/json
//     * str → UTF-8 encoded,
//       Content-Type: text/plain; charset=utf-8
//     * int, float, bool → str() then UTF-8,
//       Content-Type: text/plain; charset=utf-8
//     * None → no body transmitted,
//       Content-Type set only if Header clause present
// * Giving : Result binding — stores the full result (status, headers, body)
//   in the given variable path. HTTP errors (4xx, 5xx) and transport failures
//   are stored as failure results, not raised as exceptions.
//   Scripts determine error handling.
//----------------------------------------------------------------------------
?http_request_opt: "Using"i "Connection"i? expr -> hopt_connection_name // string
    | ("Data"i | "Body"i) option_value          -> hopt_body   // see type rules above
    | "Giving"i var_name                        -> hopt_giving // variable path
