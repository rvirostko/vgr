//----
// Allows singe and double quoted strings
//----
STRING: SINGLE_QUOTE_STRING | DOUBLE_QUOTE_STRING
SINGLE_QUOTE_STRING: /'([^'\\]*(\\.[^'\\]*)*)'/
DOUBLE_QUOTE_STRING: /"([^"\\]*(\\.[^"\\]*)*)"/

//----
// Adding a "range" ala Python, but with limits
//----
expr: range
?range: expr "<" expr "<" expr -> range_lt
    | expr "<=" expr "<" expr -> range_le_lt
    | expr "<" expr "<=" expr -> range_lt_le
    | expr "<=" expr "<=" expr -> range_le
    | expr ">" expr ">" expr -> range_gt
    | expr ">=" expr ">" expr -> range_ge_gt
    | expr ">" expr ">=" expr -> range_gt_ge
    | expr ">=" expr ">=" expr -> range_ge

//----
// Ternary operations
//----
expr: c_ternary | python_ternary
c_ternary: expr "?" expr ":" expr // condition, true_value, false_value
python_ternary: expr "If"i expr "Else"i expr // true_value, condition, false_value

//----
// Control flow
//----
start: (statement | procedure_definition)*

statement: foo
         | bar
         | control_structure
         | break
         | continue

procedure_definition: "procedure"i var "(" (var ("," var)*)? ")" "begin"i? statement* "end"i

foo: "foo"i
bar: "bar"i

?control_structure: if_statement
                | unless_statement
                | while_statement
                | until_statement
                | foreach_statement
                | procedure_call

if_statement: "if"i expression (break | continue) -> if
    | "if"i expression "then"i? statement+ else_clause? "end"i -> if
unless_statement: "unless"i expression "do"i? statement+ else_clause? "end"i -> unless
while_statement: "while"i expression "do"? statement+ "end"i -> while
until_statement: "until"i expression "do"? statement+ "end"i -> until
foreach_statement: "foreach"i var "in"i expression "do"i? statement+ "end"i -> foreach
procedure_call: "call"i var "(" (expression ("," expression)*)? ")" -> call

else_clause: "else"i statement+ -> else
break: "break"i
continue: "continue"i

expression: comparison
          | var

comparison: var ("=" | "!=") var

var: /[a-zA-Z_][a-zA-Z0-9_]*/
