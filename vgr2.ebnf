// Omitted from the parse tree
_DOT: "."
_COMMA: ","
_LPAREN: "("
_RPAREN: ")"
_SEMICOLON: ";"
_OSB: "["
_CSB: "]"

// Converted to their literal values after parsing
TRUE.90: "true"i
FALSE.90: "false"i
NONE.90: "none"i | "null"i
INF.90: "inf"i
NAN.90: "nan"i

// Numeric values
// NB: octal and binary regexs are shorter than the length
//     of the decimal regex, so we need to boost their
//     priorities so the former's leading zero doesn't get
//     prematurely matched by the latter.
HEX_NUMBER.2: /0[xX](_?[0-9a-fA-F])+/
OCT_NUMBER.2: /0[oO](_?[0-7])+/
BIN_NUMBER.2: /0[bB](_?[01])+/
DEC_NUMBER: /[+-]?[0-9](_?[0-9])*/
_SPECIAL_DEC: /[0-9](_?[0-9])*/
_EXP_PART: /[eE][+-][0-9](_?[0-9])*/
// NB: slight difference from Python as floats can't end with a "."
_DECIMAL: _DOT _SPECIAL_DEC | _SPECIAL_DEC _DOT _SPECIAL_DEC
FLOAT_NUMBER: /[+-]/? (_SPECIAL_DEC _EXP_PART | _DECIMAL _EXP_PART?)

// "snake case", "kabab case", and mixed version of the two
// For "kabab", it cannot start with a hyphen and an alpha character must follow a hyphen
// This is an attempt to prevent some subtraction operations from looking like identifiers
NAME: /[A-Za-z_]([A-Za-z0-9_]|-+[A-Za-z])*/

statements: statement+
?statement: add
    | assert
    | close
    | debug
    | display_on
    | divide
    | echo
    | exhibit
    | exit
    | load_from
    | move_to
    | mul_by
    | open
    | print
    | printf
    | select
    | set_var
    | subtract
    | unset
    | verbose
    | zip

// simple boolean on/off, true/false
// these are "proper statements" as they control the behavior of other statements
debug: "Debug"i (("=" | ":=" | "Is"i)? expr)? _SEMICOLON?
echo: "Echo"i (("=" | ":=" | "Is"i)? expr)? _SEMICOLON?
verbose: "Verbose"i (("=" | ":=" | "Is"i)? expr)? _SEMICOLON?

?set_var: "Set"i (set | inc | dec) _SEMICOLON?
    | "Let"i var_name ("=" | ":=") expr _SEMICOLON? -> set
    | "Compute"i var_name ("=" | "Equals"i) expr _SEMICOLON? -> set
set: var_name ("=" | ":=" | "To"i) expr
inc: var_name "Up"i "By"i expr
dec: var_name "Down"i "By"i expr

unset: "Unset"i var_name _SEMICOLON?

load_from: "Load"i var_name ("From"i | "With"i) "File"i? expr load_source_type? _SEMICOLON?
load_source_type: "JSON"i "Object"i? -> json_object
    | "JSON"i "Object"i? "Per"i "Line"i -> json_objects
    | "CSV"i -> csv_file
    | "TEXT"i -> text_file

assert: "Assert"i (expr (":" expr (_COMMA expr)*)?)? _SEMICOLON?

printf: "Printf"i (expr (_COMMA expr)*)? _SEMICOLON?

print: "Print"i (expr (_COMMA expr)*)? _SEMICOLON?

exhibit: "Exhibit"i (var_name (_COMMA var_name)*)? _SEMICOLON?

open: "Open"i io_type "File"i? expr open_ext? _SEMICOLON?
close: "Close"i io_type "File"i? _SEMICOLON? -> close
?io_type: ("Error"i | "stderr"i) -> stderr
    | ("Output"i | "stdout"i) -> stdout
?open_ext: ("Append"i | "Extend"i | "a"i) -> a
    | ("Overwrite"i | "w"i) -> w
    | ("No"i "Overwrite"i | "x"i) -> x

zip: "Create"i "Zip"i "File"i? expr (_COMMA? zip_option (_COMMA zip_option)*)? _SEMICOLON?
?zip_option: "Password"i expr -> password
    | "Comment"i ("=" | ":=")? expr -> comment
    | "Include"i ("=" | ":=")? expr+ -> include
    | "Exclude"i ("=" | ":=")? expr+ -> exclude

exit: "Exit"i expr? _SEMICOLON?

?add: "Add"i expr (_COMMA expr)* "To"i var_name _SEMICOLON? -> add_to
    | "Add"i expr (_COMMA expr)* "To"i expr "Giving"i var_name _SEMICOLON? -> add_giving

?subtract: "Subtract"i expr (_COMMA expr)* "From"i var_name _SEMICOLON? -> sub_from
    | "Subtract"i expr (_COMMA expr)* "From"i expr "Giving"i var_name _SEMICOLON? -> sub_giving

mul_by: "Multiply"i expr "By"i (expr "Giving"i)? var_name _SEMICOLON?

?divide: "Divide"i (div_into | div_by) _SEMICOLON?
div_into: expr "Into"i (expr "Giving"i)? var_name
div_by: expr "By"i expr "Giving"i var_name

move_to: "Move"i CORR? expr "To"i var_name _SEMICOLON?
CORR.80: ("Corresponding"i | "Corr"i)

display_on: "Display"i (expr (_COMMA? expr)*)? (("Upon"i | "On"i) io_type)? _SEMICOLON?

select: "Select"i outputs? from_clause where_clause? product_clause? limit_clause? for_clause? _SEMICOLON?

?outputs: output (_COMMA output)*

output: expr
    | expr "As"i (NAME | ESCAPED_STRING) -> output_as

?from_clause: "From"i (from_var | from_file | from_vault)
from_var: ("Variable"i | "Var"i) var_name "As"i NAME
from_file: "File"i expr load_source_type? "As"i NAME
from_vault: "Vault"i? VAULT_TARGET

where_clause: "Where"i expr (_COMMA expr)*

?for_clause: "For"i (for_json | for_csv | for_markdown | for_template)

for_json: "JSON"i (_COMMA? json_option (_COMMA json_option)*)?
?json_option: "Encode"i? "Ascii"i (("=" | ":=") expr)? -> encode_ascii
    | "Encode"i? ("Unicode"i | "UTF8"i | "UTF-8"i) (("=" | ":=") expr)? -> encode_unicode
    | "Root"i (("=" | ":=") expr)? -> root
    | "Indent"i (("=" | ":=") expr)? -> indent
    | "Compact"i (("=" | ":=") expr)? -> compact
    | "Exclude"i ("Nulls"i | "Null"i "Values"i) (("=" | ":=") expr)? -> exclude_nulls
    | "Include"i ("Nulls"i | "Null"i "Values"i) (("=" | ":=") expr)? -> include_nulls
    | "With"i? "Array"i "Wrapper"i (("=" | ":=") expr)? -> array_wrapper
    | ("Without"i | "No"i) "Array"i "Wrapper"i (("=" | ":=") expr)? -> no_array_wrapper
    | ("Sort"i "Keys"i? | "Sorted"i) (("=" | ":=") expr)? -> sort_keys

for_csv: "CSV"i (_COMMA? csv_option (_COMMA csv_option)*)?
?csv_option: "Encode"i? "Ascii"i (("=" | ":=") expr)? -> encode_ascii
    | "Encode"i? ("Unicode"i | "UTF8"i | "UTF-8"i) (("=" | ":=") expr)? -> encode_unicode
    | "Delimiter"i ("=" | ":=") expr -> delimiter
    | "Quote"i ("Char"i | "Character"i) ("=" | ":=") expr -> quotechar
    | "Escape"i ("Char"i | "Character"i) ("=" | ":=") expr -> escapechar
    | "Line"i ("Ender"i | "Terminator"i) ("=" | ":=") expr -> lineterminator
    | "Quote"i ("=" | ":=") CSV_QUOTE_TYPE -> quoting
    | "Include"i "Headers"i (("=" | ":=") expr)? -> include_headers
    | ("No"i | "Omit"i) "Headers"i (("=" | ":=") expr)? -> omit_headers
CSV_QUOTE_TYPE: "Minimal"i | "All"i | "Nonnumeric"i | "None"i

for_markdown: "MarkDown"i (_COMMA? markdown_option (_COMMA markdown_option)*)?
?markdown_option: "Encode"i? "Ascii"i (("=" | ":=") expr)? -> encode_ascii
    | "Encode"i? ("Unicode"i | "UTF8"i | "UTF-8"i) (("=" | ":=") expr)? -> encode_unicode
    | "Include"i "Headers"i (("=" | ":=") expr)? -> include_headers
    | ("No"i | "Omit"i) "Headers"i (("=" | ":=") expr)? -> omit_headers

for_template: TEMPLATE_TYPE? ("Template"i | "Jinja"i | "Jinja2"i) "File"i? expr (_COMMA? template_option (_COMMA template_option)*)?
TEMPLATE_TYPE: "Record"i | "Batch"i
?template_option: "Encode"i? "Ascii"i (("=" | ":=") expr)? -> encode_ascii
    | "Encode"i? ("Unicode"i | "UTF8"i | "UTF-8"i) (("=" | ":=") expr)? -> encode_unicode
    | "Auto"i "Escape"i (("=" | ":=") expr)? -> auto_escape
    | "Trim"i "Blocks"i? (("=" | ":=") expr)? -> trim_blocks
    | "Left"i "Strip"i "Blocks"i? (("=" | ":=") expr)? -> lstrip_blocks
    | "Keep"i "Last"i "Newline"i (("=" | ":=") expr)? -> keep_last_newline
    | "Chain"i "Undefined"i "Variables"i? (("=" | ":=") expr)? -> chain_undefined
    | "Include"i "Headers"i (("=" | ":=") expr)? -> include_headers
    | ("No"i | "Omit"i) "Headers"i (("=" | ":=") expr)? -> omit_headers

// Either LIMIT <number> (OFFSET <number>)?
// or FETCH FIRST <number> ROWS ONLY
limit_clause: _limit_offset | _fetch_first
_limit_offset: "Limit"i ("=" | ":=")? expr (_COMMA? "Offset"i ("=" | ":=")? expr)?
_fetch_first: "Fetch"i "First"i expr "Rows"i "Only"i

product_clause: "Cartesian"i? "Product"i product_cols
product_cols: "All"i -> all
    | "None"i -> none
    | col_spec (_COMMA col_spec)*
?col_spec: DEC_NUMBER // One based
    | NAME
    | ESCAPED_STRING
// TODO: option to say before or after limits

//---
?expr: ternary
    | and_expr

?ternary: and_expr "?" expr ":" expr -> c_ternary
    | and_expr "If"i expr "Else"i expr -> py_ternary

?and_expr: or_expr
    | or_expr (("&&" | "And"i) or_expr)+ -> and_op

?or_expr: comparison
    | comparison (("||" | "Or"i) comparison)+ -> or_op

?comparison: sum
    | sum ("==" | "Equals"i | "Is"i | "Is"i? "Equal"i "To"i) sum -> eq_op
    | sum ("!=" | "<>" | "\u2260" | "Is"i "Not"i | "Is"i? "Not"i "Equal"i "To"i | (("Doesnt"i | "Does"i? "Not"i) "Equal"i)) sum -> neq_op
    | sum ("<" | "Is"i? "Less"i "Than"i) sum -> lt_op
    | sum (">" | "Is"i? "Greater"i "Than"i) sum -> gt_op
    | sum ("<=" | "\u2264" | "Is"? "Not"i "Greater"i "Than"i) sum -> le_op
    | sum (">=" | "\u2265" | "Is"i? "Not"i "Less"i "Than"i) sum -> ge_op

?sum: product
    | product ("+" | "\uFF0B") product -> add_op
    | product ("-" | "\u2212") product -> sub_op
    | product ("%" | "Mod"i) product -> mod_op
    | product ("**" | "Pow"i) product -> pow_op
    | product "&" product -> bit_and_op
    | product "|" product -> bit_or_op
    | product ("^" | "Xor"i) product -> bit_xor_op
    | product ("<<" | "LShift"i) product -> shl_op
    | product (">>" | "RShift"i) product -> shr_op

?product: atom
    | atom ("*" | "\u00D7") atom -> mul_op
    | atom ("/" | "\u00F7") atom -> div_op

?atom: deref
    | "!" expr -> unary_not
    | _OSB (expr (_COMMA expr)*)? _CSB -> array         // may become CARRAY at runtime
    | TRUE | FALSE
    | NONE
    | INF | NAN                                         // becomes FLOAT at runtime
    | ESCAPED_STRING                                    // becomes STRING at runtime
    | HEX_NUMBER | BIN_NUMBER | OCT_NUMBER | DEC_NUMBER // becomes INT at runtime
    | FLOAT_NUMBER                                      // becomes FLOAT at runtime
    | NAME -> var_ref
    | _LPAREN expr _RPAREN

deref: atom _DOT NAME
    | atom _DOT function -> function_call

//---

// Flattening operations out here allows the parse tree to hold
// the operation type explicitly instead of a generic "OP" where
// we need to deal with aliases
