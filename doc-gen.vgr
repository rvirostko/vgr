//-----------------------------------------------------------------------------
// Generates examples for function and expression documentation
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Prototype for a "distribute a function" feature
//-----------------------------------------------------------------------------
Define Function dist(lst, fn):
    If lst.IsList():
        Declare t Local
        Set t To []
        ForEach x in lst:
            Set t += @fn(x)
        End
        Return t
    End
    Return @fn(lst)
End
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Remove parens around a string
//-----------------------------------------------------------------------------
Define Function deparen(s):
    If s.StartsWith("(") and s.EndsWith(")"):
        Return s.Slice(1,-1)
    End
    Return s
End
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Join strings with an arrow
//-----------------------------------------------------------------------------
Set arrow_join(x) -> x.Join(" → ")
//-----------------------------------------------------------------------------

Set rnd = math.random100
Set setup_file = "doc-gen-{}-s.txt".Format(rnd)
Set out_file = "doc-gen-{}-o.txt".Format(rnd)
Set err_file = "doc-gen-{}-e.txt".Format(rnd)

Open Error File setup_file
Tron
//-----------------------------------------------------------------------------
// Set up stuff
//-----------------------------------------------------------------------------
#Set fruits To ["apple", "banana", "orange"]
#Set fruit_colors To {"apple": "red", "banana": "yellow"}
#Set point1 To {"x": 5, "y": 7, "meta": {"type": "2d", "name": "p1"}}
#Set point2 To {"x": 7, "y": 29, "meta": {"type": "2d", "name": "p2"}}

Set point1 To {"x": 5, "y": 7, "space": 2, "name": "p1"}
Set point2 To {"x": 7, "y":29, "space": 2, "name": "p2"}
Set point3 To {"x": 9, "y":31, "z": -7, "space": 3, "name": "p3"}
Set point4 To {"x":11, "y":37, "z": None, "space": 3, "name": "p4"}
Set points To [point1, point2, point3, point4]
//-----------------------------------------------------------------------------
Troff
Close Error File

// Results of examples go to this file
Open Output File out_file
// The echo output goes to this file
Open Error File err_file
Tron
//-----------------------------------------------------------------------------
// Behavior tests go here
//-----------------------------------------------------------------------------

Print points.LookupItem("x", 5).Repr()
Print points.LookupItem("z", None).GetKeyValue("name").Repr()
Print points.LookupItem("space", 1).GetKeyValue("name").Repr()
Print points.LookupItem("space", [1, 2]).GetKeyValue("name").Repr()
Print points.LookupItem("space", [2, 1]).GetKeyValue("name").Repr()
Print points.LookupItem("space", 3).LookupItem("z", None).GetKeyValue("name").Repr()
Print points.LookupItem("name", CompilePattern("p[24]")).GetKeyValue("name").Repr()

//-----------------------------------------------------------------------------
Troff
Close Error File
Close Output File

// Load in the generated data and convert
Load s_in WIth File setup_file Text Lines
Load o_in With File out_file Text Lines
Set o_in To o_in.ReplaceStr("'", '"')
Load o_err With File err_file Text Lines
Set o_err To o_err.RemovePrefix("Print ").RemoveSuffix(".Repr()")
Set o_err To o_err.@dist(deparen)

Set example To
    (s_in +                   // Any setup strings
     o_err.CombineWith(o_in). // Combine the data sources
     @dist(arrow_join)).      // Join the statement and its output
    MdCodeBlock("vgr")        // Make into a code example
// See it as a preview for editing
Print As Markdown example
// And have it ready to paste
// NB: You probably need to install pyperclip for this to work
// We need to double up backslashes because the example will
// be pasted into docstrings
Terminal SetClipboard example.ReplaceStr("\\", "\\\\").AppendStr("\n")

ForEach fn in [setup_file, out_file, err_file]:
    Assert fn.RemoveFile().FirstItem() : "Could not delete {}", fn
End
