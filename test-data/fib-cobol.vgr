-----------------------------------------------------------------------
-- Calculate and display Fibonacci numbers from fib(0) to fib(8)
-- Had to add commas between items in Display
-----------------------------------------------------------------------

PERFORM VARYING I FROM 0 BY 1 UNTIL I > 8
    IF I < 2
        DISPLAY "fib(", I, ") = ", I
    ELSE
        MOVE 0 TO FIB0
        MOVE 1 TO FIB1
        PERFORM VARYING J FROM 2 BY 1 UNTIL J > I
            ADD FIB0 TO FIB1 GIVING T
            MOVE FIB1 TO FIB0
            MOVE T TO FIB1
        END-PERFORM
        DISPLAY "fib(", I, ") = ", FIB1
    END-IF
END-PERFORM
