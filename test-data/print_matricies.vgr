# In the Digiac-3060 tradition
# Printing math matricies

Set Zero to 0 # for readability

# Convert a value to a number, using zero as the default
# Since it is strictly transformational, use a arrow function
num_default(x) -> x.DefaultTo(Zero).ToNumber()

# Basic math operations in a dictionary
# These are short enough they could be defined as arrow functions
Define Function op.add(a, b):
    Return @num_default(a) + @num_default(b)
End
Define Function op.sub(a, b):
    Return @num_default(a) - @num_default(b)
End
Define Function op.mul(a, b):
    Return @num_default(a) * @num_default(b)
End
Define Function op.div(a,b):
    Set b = @num_default(b)
    Return b Is Zero ? math.inf : (@num_default(a) / b)
End

# Some more "advanced" math operations
Define Function adv_op.pow(a, b): return @num_default(a).Pow(@num_default(b)); End
Define Function adv_op.gcd(a, b):
    Set a = @num_default(a)
    Set b = @num_default(b)
    While b != 0:
        Set t = b
        Set b = a % b
        Set a = t
    End
    Return a
End
Define Function adv_op.lcm(a, b):
    Set a = @num_default(a)
    Set b = @num_default(b)
    Return (a * b) / @adv_op.gcd(a, b)
End

# TODO Define Proceedure print_matricies(operations, matrix_min, matrix_max):
# These become the args
Set operations = op
Set matrix_min = 0
Set matrix_max = 9

Assert operations.IsDictionary()
Assert operations.Length() > 0 : "No operations defined"
matrix_min = matrix_min.ToInt().DefaultTo(0).Clamp(0, 99)
matrix_max = matrix_max.ToInt().DefaultTo(9).Clamp(matrix_min, 99)

ForEach item in operations:
    # operations is dictionary, so ForEach returns a key-value pair for each item
    Set op_name to item.FirstItem()
    Set op_func to item.LastItem()
    Printf "\n{}:\n", op_name.TitleCase()
    For x = matrix_min To matrix_max:
        # Print the header for the matrix
        If x == matrix_min:
            Printf "   | "
            For y = 0 to 9:
                Printf "{:>2d} ", y
            Next
            Printf "\n---+-{}\n", "-" * (((matrix_max - matrix_min) + 1) * 3)
        End
        # Print a row's worth of calculations
        Printf "{:>2d} | ", x
        For y = matrix_min To matrix_max:
            Set rc = @op_func(x, y)
            If rc.IsFinite():
                Printf "{:>2d} ", rc.ToInt()
            Else:
                Printf " - "
            End
        Next
        Print
    Next
End
