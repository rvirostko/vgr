echo on

// Basic ASCII Latin letters
Set abc To 5
Assert (abc + 1) == 6

// Latin-1 Supplement (U+00C0–U+00FF), e.g., À-ÿ
Set ÌÝö To 10
Assert (ÌÝö * 2) == 20

// Latin Extended-A (U+0100–U+017F)
Set ĀĒŌ To 7
Assert (ĀĒŌ - 3) == 4

// Latin Extended-B (U+0180–U+024F)
Set ƀƃƌ To 12
Assert (ƀƃƌ / 2) == 6

// Latin Extended Additional (U+1E00–U+1EFF)
Set ḀḁḂ To 15
Assert (ḀḁḂ + 5) == 20

// Leading $ with basic Latin
Set $abc To 8
Assert ($abc * 3) == 24

// Leading $ with Latin-1 Supplement
Set $Éßç To 6
Assert ($Éßç - 2) == 4

// Leading $ with Latin Extended-A
Set $ĂĔŎ To 9
Assert ($ĂĔŎ + 1) == 10

// Leading $ followed by digit and non-digits
Set $1foo To 42
Assert ($1foo + 8) == 50

// Basic ASCII letters with numbers
Set bar2 To 10
Assert (bar2 * 3) == 30

// Snake-case variable name
Set my_var_name To 5
Assert (my_var_name - 2) == 3

// Kebab-case variable name (hyphen in middle)
Set another-var To 7
Assert (another-var / 2) == 3.5

// Greek characters
Set αβγ To 12
Assert (αβγ * 2) == 24

// Mathematical alphanumeric symbols
Set 𝐴𝐵𝐶 To 15
Assert (𝐴𝐵𝐶 + 5) == 20

// Optional prime suffix
Set x′ To 3
Assert (x′ * 4) == 12

// Optional double-prime suffix
Set y″ To 6
Assert (y″ - 1) == 5

// Optional triple-prime suffix
Set z‴ To 8
Assert (z‴ / 2) == 4

// Optional superscript/subscript digits
Set num₁ To 9
Assert (num₁ + 1) == 10

// Combined complex case: leading $, Greek, math symbol, hyphen, underscore, digit, and prime
Set $α-𝐵_3′ To 20
Assert ($α-𝐵_3′ * 2) == 40

echo off
