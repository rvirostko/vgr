?vault_statements: vault_connect
    | vault_disconnect
    | vault_default_ns
    | vault_create_ns
    | vault_read_ns
    | vault_update_ns
    | vault_delete_ns
    | vault_list_ns
    | vault_lock_ns
    | vault_unlock_ns
    | vault_create_mount
    | vault_read_mount
    | vault_update_mount
    | vault_delete_mount
    | vault_list_mounts
    | vault_create_kv_secret
    | vault_read_kv_secret
    | vault_read_kv_metadata
    | vault_update_kv_secret
    | vault_delete_kv_secret
    | vault_list_kv_secrets
    | vault_patch_kv_secret
    | vault_create_ldap_lib
    | vault_read_ldap_lib
    | vault_update_ldap_lib
    | vault_delete_ldap_lib
    | vault_list_ldap_libs
    | vault_create_ldap_secret
    | vault_read_ldap_secret
    | vault_update_ldap_secret
    | vault_delete_ldap_secret
    | vault_list_ldap_secrets
    | vault_rotate_ldap_secret
    | vault_api_get
    | vault_api_list
    | vault_api_delete
    | vault_api_post
    | vault_api_patch

// Connections
vault_connect   : "Vault"i "Connect"i (_COMMA? vault_conn_arg)* _SEMICOLON?
vault_disconnect: "Vault"i "Disconnect"i ("From"i? expr)? _SEMICOLON?
vault_conn_arg: "To"i "Host"i? expr -> conn_addr
    | ("With"i "Token"i? | "Token"i ("=" | "Is"i)) expr -> conn_token
    | "As"i expr -> conn_name

// Generic Vault API interactions
// The expr is the URL. Note that it may have to be URL encoded
// It should include everything except the host name and port
vault_api_get    : "Vault"i "APIGet"i expr vault_args _SEMICOLON?
vault_api_list   : "Vault"i "APIList"i expr vault_args _SEMICOLON?
vault_api_delete : "Vault"i "APIDelete"i expr vault_args _SEMICOLON?
vault_api_post   : "Vault"i "APIPost"i expr vault_args _SEMICOLON?
vault_api_patch  : "Vault"i "APIPatch"i expr vault_args _SEMICOLON?

// Namespaces
vault_default_ns : "Vault"i ("DefaultNamespace"i | "default_namespace"i) expr _SEMICOLON?
vault_create_ns  : "Vault"i ("CreateNamespace"i | "create_namespace"i) expr vault_args _SEMICOLON?
vault_read_ns    : "Vault"i ("ReadNamespace"i | "read_namespace"i) expr vault_args _SEMICOLON?
vault_update_ns  : "Vault"i ("UpdateNamespace"i | "update_namespace"i) expr vault_args _SEMICOLON?
vault_delete_ns  : "Vault"i ("DeleteNamespace"i | "delete_namespace"i) expr vault_args _SEMICOLON?
vault_list_ns    : "Vault"i ("ListNamespaces"i | "list_namespaces"i) expr? vault_args _SEMICOLON?
vault_lock_ns    : "Vault"i ("LockNamespace"i | "lock_namespace"i) expr vault_args _SEMICOLON?
vault_unlock_ns  : "Vault"i ("UnlockNamespace"i | "unlock_namespace"i) expr vault_args _SEMICOLON?

// Secret Engine Mount Points
vault_create_mount : "Vault"i ("CreateMount"i | "create_mount"i) expr vault_args _SEMICOLON?
vault_read_mount   : "Vault"i ("ReadMount"i | "read_mount"i) expr vault_args _SEMICOLON?
vault_update_mount : "Vault"i ("UpdateMount"i | "update_mount"i) expr vault_args _SEMICOLON?
vault_delete_mount : "Vault"i ("DeleteMount"i | "delete_mount"i) expr vault_args _SEMICOLON?
vault_list_mounts  : "Vault"i ("ListMounts"i | "list_mounts"i) expr? vault_args _SEMICOLON?

// KV2 Secrets
vault_create_kv_secret : "Vault"i ("CreateKvSecret"i | "create_kv_secret"i) expr vault_args _SEMICOLON?
vault_read_kv_secret   : "Vault"i ("ReadKvSecret"i | "read_kv_secret"i) expr vault_args _SEMICOLON?
vault_read_kv_metadata : "Vault"i ("ReadKvMetadata"i | "read_kv_metadata"i) expr vault_args _SEMICOLON?
vault_update_kv_secret : "Vault"i ("UpdateKvSecret"i | "update_kv_secret"i) expr vault_args _SEMICOLON?
vault_delete_kv_secret : "Vault"i ("DeleteKvSecret"i | "delete_kv_secret"i) expr vault_args _SEMICOLON?
vault_list_kv_secrets  : "Vault"i ("ListKvSecrets"i | "list_kv_secrets"i) expr vault_args _SEMICOLON?
vault_patch_kv_secret  : "Vault"i ("PatchKvSecret"i | "patch_kv_secret"i) expr vault_args _SEMICOLON?

// LDAP Libraries Secrets
vault_create_ldap_lib : "Vault"i ("CreateLdapLibrary"i | "create_ldap_library"i) expr vault_args _SEMICOLON?
vault_read_ldap_lib   : "Vault"i ("ReadLdapLibrary"i | "read_ldap_library"i) expr vault_args _SEMICOLON?
vault_update_ldap_lib : "Vault"i ("UpdateLdapLibrary"i | "update_ldap_library"i) expr vault_args _SEMICOLON?
vault_delete_ldap_lib : "Vault"i ("DeleteLdapLibrary"i | "delete_ldap_library"i) expr vault_args _SEMICOLON?
vault_list_ldap_libs  : "Vault"i ("ListLdapLibraries"i | "list_ldap_libraries"i) expr vault_args _SEMICOLON?

// LDAP Static Secrets
vault_create_ldap_secret : "Vault"i ("CreateLdapSecret"i | "create_ldap_secret"i) expr vault_args _SEMICOLON?
vault_read_ldap_secret   : "Vault"i ("ReadLdapSecret"i | "read_ldap_secret"i) expr vault_args _SEMICOLON?
vault_update_ldap_secret : "Vault"i ("UpdateLdapSecret"i | "update_ldap_secret"i) expr vault_args _SEMICOLON?
vault_delete_ldap_secret : "Vault"i ("DeleteLdapSecret"i | "delete_ldap_secret"i) expr vault_args _SEMICOLON?
vault_list_ldap_secrets  : "Vault"i ("ListLdapSecrets"i | "list_ldap_secrets"i) expr vault_args _SEMICOLON?
vault_rotate_ldap_secret : "Vault"i ("RotateLdapSecret"i | "rotate_ldap_secret"i) expr vault_args _SEMICOLON?

# NB: Expression are treated like tokens iff they are a single name component
#     and are undefined in the data dictionary
vault_args: (_COMMA? vault_option (_COMMA? vault_option)*)?
vault_option: "CAS"i ("=" | "Is"i)? expr -> vopt_cas
    | "CAS"i "From"i var_name -> vopt_cas
    | "Config"i ("=" | "Is"i)? expr -> vopt_config
    | "Config"i "From"i var_name -> vopt_config
    | "Data"i ("=" | "Is"i)? expr -> vopt_data
    | "Data"i "From"i var_name -> vopt_data
    | "Description"i ("=" | "Is"i)? expr -> vopt_description
    | "Description"i "From"i var_name -> vopt_description
    | "Key"i ("=" | "Is"i)? expr -> vopt_key
    | "Key"i "From" var_name -> vopt_key
    | ("Meta"i | "Metadata"i) ("=" | "Is"i)? expr -> vopt_metadata
    | ("Meta"i | "Metadata"i) "From"i var_name -> vopt_metadata
    | "Namespace"i ("=" | "Is"i)? expr -> vopt_namespace
    | "Namespace"i "From"i var_name -> vopt_namespace
    | ("Result"i | "Results"i) ("=" | "Is"i | "In"i)? var_name -> vopt_result
    | "Into"i var_name -> vopt_result
    | ("Secrets"i | "Secret"i) ("=" | "Is"i | "Are"i)? expr -> vopt_data # Alias for data
    | ("Secrets"i | "Secret"i) "From"i var_name -> vopt_data             # Alias for data
    | "Type"i ("=" | "Is"i)? expr -> vopt_type
    | "Type"i "From"i var_name -> vopt_type
    | "Using"i "Connection"i? expr -> vopt_using
    | ("Version"i | "Ver"i) ("=" | "Is"i)? expr -> vopt_version
    | ("Version"i | "Ver"i) "From"i var_name -> vopt_version
