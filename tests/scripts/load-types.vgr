
Set data To vgr.source.FirstItem().DirectoryName() + os.sep + "data" + os.sep

Define Function check_load_meta(meta, format, keys, records):
    Assert meta.Type() Is "dictionary"
    Assert meta Contains "filename"
    Assert meta Contains "format"
    Assert meta.format Is format
    Assert meta Contains "keys"
    Assert meta.keys.Type() Is "list"
    Assert meta.keys.Sort() Equals keys.Sort()
    Assert meta Contains "records"
    Assert meta.records.Type() Is "integer"
    Assert meta.records Equals records
End-Function

Set frog_tests To [
    { "ftype": "csv",  "dtype": "list",       "keys": ["name", "age"] },
    { "ftype": "json", "dtype": "dictionary", "keys": ["name", "age"] },
    { "ftype": "yaml", "dtype": "dictionary", "keys": ["name", "age"] },
    { "ftype": "ini",  "dtype": "dictionary", "keys": ["frog"] },
    { "ftype": "hcl",  "dtype": "dictionary", "keys": ["frog"] },
]

For Each test In frog_tests
    Load t From data + "frog." + test.ftype Giving meta
    Assert t.Type() Is test.dtype
    Assert meta Is Not None
    Call check_load_meta(meta, test.ftype, test.keys, 1)
    Assert meta.keys.Sort() Equals t.GetKeys().Sort()
    Printf "{} - {}, {} record{}\nkeys : {}\n{}\n\n",
        meta.filename, meta.format, meta.records, meta.records.Plural(),
        meta.keys.Sort().Repr(),
        t.FormatJson()
End-For
