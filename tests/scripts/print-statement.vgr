Define Function set-env(ofs, ors)
    Set env.OFS To ofs
    Set env.ORS To ors
End-Function

Define Function show-env()
    Printf "OFS : {!r}\n", env.OFS To Output
    Printf "ORS : {!r}\n", env.ORS To Output
End-Function

# Default behavior (env.OFS and env.ORS are None → space + newline)
Call show-env()
Print "alpha", "beta", "gamma"

# Set custom separators
Call set-env(",", "|")
Call show-env()
Print "alpha", "beta", "gamma"
Printf Newline

# Change only OFS
Call set-env(" | ", None)
Call show-env()
Print "x", "y", "z"                # x | y | z\n
Printf Newline

# Explicit destinations
Call set-env(Space, Newline)
Call show-env()
Print "out1", "out2" To Output
Print "err1", "err2" To Error
Print "# Title" As Markdown
Print "*one*", "**two**", "***three***" As Markdown
Print "* item1", Newline, "* item2" As Markdown

# Empty strings still emit ORS
Print ""
Print "", ""

# Mixed empty and non-empty
Print "alpha", "", "gamma"

# Reset to defaults by unsetting (None)
Call set-env()
Call show-env()
Print "reset", "to", "defaults"    # reset to defaults\n

# Error stream example
Print "warning:", "something happened" To Error

# Output aliases
Print "alpha" To stdout // Alias to Output
Print "alpha" To stderr // Alias to Error

# Immediate output flushing
Print "alpha" Flush // Default
Print "alpha" Flush Is True
Print "alpha" Flush Is False
Print "alpha" Flush Is None // use default behavior
Print "alpha" No-Flush
Print "alpha" No-Flush Is True
Print "alpha" No-Flush Is False
Print "alpha" No-Flush Is None // use default behavior

# Separators
Print "alpha", "beta" // use default separators
Print "alpha", "beta" OFS Is ", " ORS Is Newline
Print "alpha", "beta" ORS Is None // same as an empty string
Printf Newline
// Alternate long option names
Print "alpha", "beta" Field Separator Is ", " Record Separator Is Newline

# Multiple options, multiple lines
Print "alpha", "beta"
    To Error // destination comes first
    Field Separator Is ", "
    Record Separator Is Newline
    No-Flush
