
@Include DirectoryName(vgr.source.FirstItem()) + "/output-data.vgr"

Set env.OFS = ""

Print NewLine, "Debug Output", NewLine, bar
Debug On; Select $record From ["debug"] For Text; Debug Off;
Print bar

Print NewLine, "Include Headers", NewLine, bar
Select $rec-index As "№", $record As "Data", Type($record) As "Type" From data For Text Include Headers
Print bar

Print NewLine, "Exclude Headers", NewLine, bar
Select $rec-index As "№", $record As "Data", Type($record) As "Type" From data For Text Exclude Headers
Print bar
