// -------------------------------------------------------------------------
// http-param-tests.vgr — Parameter Test Script
// Tests parameter handling against httpbin.org /get endpoint
// All tests use GET — method coverage is in http-tests.vgr
// httpbin echoes parameters back under response.args
// -------------------------------------------------------------------------

Set host To "httpbin.org"
Set getter To "https://{}/get".Format(host)

Define Function AssertResult(test_no):
    Assert http.result.reason Is None : "Test {} failed: {}", test_no, http.result.reason
End

Define Function CheckParam(test_no, key, expected):
    Set received To http.result.response.args.GetKeyValue(ToString(key))
    Assert received == expected : "Test {}: For key {!r} expected {!r}, received {!r}", test_no, key, expected, received
End

Define Function PrintPassed(test_no):
    Print "Test", test_no, "passed"
End

Define Function CheckSingleParam(test_no, key, expected):
    Call AssertResult(test_no)
    Call CheckParam(test_no, key, expected)
    Call PrintPassed(test_no)
End

Set n To 1
// -------------------------------------------------------------------------
// String value in dict form
// -------------------------------------------------------------------------
Set key To "name"
Set expected To "alice"
Http Get getter Parameters { key: expected }
Call CheckSingleParam(n, key, expected)
Add 1 to n

// -------------------------------------------------------------------------
// Int value in dict form — should be str()'d before sending
// -------------------------------------------------------------------------
Set key To "count"
Set expected To 42
Http Get getter Parameters { key: expected }
Call CheckSingleParam(n, key, expected)
Add 1 to n

// -------------------------------------------------------------------------
// Float value in dict form — should be str()'d before sending
// -------------------------------------------------------------------------
Set key To "ratio"
Set expected To 3.14
Http Get getter Parameters { key: expected }
Call CheckSingleParam(n, key, expected)
Add 1 to n

// -------------------------------------------------------------------------
// Bool value in dict form — should be str()'d before sending
// -------------------------------------------------------------------------
Set key To "active"
Set expected To True
Http Get getter Parameters { key: expected }
Call CheckSingleParam(n, key, expected)
Add 1 to n

// -------------------------------------------------------------------------
// None value in dict form — expect empty string
// -------------------------------------------------------------------------
Set key To "empty"
Set expected To ""
Http Get getter Parameters { key: None }
Call CheckSingleParam(n, key, expected)
Add 1 to n

// -------------------------------------------------------------------------
// Non-string keys in dict form — keys should be str()'d
// -------------------------------------------------------------------------
Set key1 To 42
Set expected1 To "42"
Set key2 To True
Set expected2 To "yes"
Http Get getter Parameters { key1: expected1, key2: expected2 }
Call AssertResult(n)
Call CheckParam(n, key1, expected1)
Call CheckParam(n, key2, expected2)
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// Multiple keys in dict form with mixed types
// -------------------------------------------------------------------------
Set key1 To "name"
Set expected1 To "bob"
Set key2 To "age"
Set expected2 To 30
Set key3 To "active"
Set expected3 To False
Http Get getter Parameters { key1: expected1, key2: expected2, key3: expected3 }
Call AssertResult(n)
Call CheckParam(n, key1, expected1)
Call CheckParam(n, key2, expected2)
Call CheckParam(n, key3, expected3)
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// Individual Parameter form — value is always a string
// -------------------------------------------------------------------------
Set key To "name"
Set expected To "alice"
Http Get getter Parameter "{}={}".Format(key, expected)
Call CheckSingleParam(n, key, expected)
Add 1 to n

// -------------------------------------------------------------------------
// Key stripping — spaces around key stripped, value spaces preserved
// -------------------------------------------------------------------------
Set key to "a"
Set expected to " b "
Http Get getter Parameter "  {}  ={}".Format(key, expected)
Call CheckSingleParam(n, key, expected)
Add 1 to n

// -------------------------------------------------------------------------
// Dict value with leading/trailing spaces preserved
// -------------------------------------------------------------------------
Set key to "a"
Set expected to " b "
Http Get getter Parameters { key: expected }
Call CheckSingleParam(n, key, expected)
Add 1 to n

// -------------------------------------------------------------------------
// Last wins — Parameter then Parameter
// -------------------------------------------------------------------------
Set key To "a"
Set expected To "second"
Http Get getter
    Parameter "{}=not-{}".Format(key, expected)
    Parameter "{}={}".Format(key, expected)
Http Get getter Parameters { key: expected }
Call CheckSingleParam(n, key, expected)
Add 1 to n

// -------------------------------------------------------------------------
// Last wins — Parameters dict then Parameters dict
// -------------------------------------------------------------------------
Set key To "a"
Set expected To "second"
Http Get getter
    Parameters { key: "not-{}".Format(expected) }
    Parameters { key: expected }
Http Get getter Parameters { key: expected }
Call CheckSingleParam(n, key, expected)
Add 1 to n

// -------------------------------------------------------------------------
// Last wins — Parameter then Parameters dict
// -------------------------------------------------------------------------
Set key To "a"
Set expected To "second"
Http Get getter
    Parameter "{}=not-{}".Format(key, expected)
    Parameters { key: expected }
Http Get getter Parameters { key: expected }
Call CheckSingleParam(n, key, expected)
Add 1 to n

// -------------------------------------------------------------------------
// Last wins — Parameters dict then Parameter
// -------------------------------------------------------------------------
Set key To "a"
Set expected To "second"
Http Get getter
    Parameters { key: "not-{}".Format(expected) }
    Parameter "{}={}".Format(key, expected)
Http Get getter Parameters { key: expected }
Call CheckSingleParam(n, key, expected)
Add 1 to n

// -------------------------------------------------------------------------
// Last wins — mixed, uncontested key survives
// -------------------------------------------------------------------------
Set key1 To "a"
Set expected1 To "second"
Set key2 To "b"
Set expected2 To "keep"
Http Get getter
    Parameters { key1: "not-{}".Format(expected1), key2: expected2 }
    Parameter "{}={}".Format(key1, expected1)
Call AssertResult(n)
Call CheckParam(n, key1, expected1)
Call CheckParam(n, key2, expected2)
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// Connect/request union — disjoint keys both appear
// -------------------------------------------------------------------------
Set expected To "yes"
Set ckey To "connect-key"
Set rkey to "request-key"
Http Connect "https://{}".Format(host) As httpbin
    Parameter "{}={}".Format(ckey, expected)
Http Get "get" Using httpbin
    Parameter "{}={}".Format(rkey, expected)
Call AssertResult(n)
Call CheckParam(n, ckey, expected)
Call CheckParam(n, rkey, expected)
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// Connect/request — request param wins over connect URL param
// -------------------------------------------------------------------------
Set key To "shared-key"
Set expected To "request-val"
Http Connect "https://{}/?{}=not_{}".Format(host, key, expected) As httpbin
Http Get "get" Using httpbin
    Parameter "{}={}".Format(key, expected)
Call CheckSingleParam(n, key, expected)
Add 1 to n

Print "All parameter tests passed"
