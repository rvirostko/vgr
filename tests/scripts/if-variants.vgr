# Different "If" syntax

# VGR
If True Then # BASIC like
    Print "Hello"
End # keep untyped

If True: # keep colon
    Print "Hello"
End # keep untyped

If True
    Print "Hello"
End # keep untyped

If False
    Print "Goodbye"
Else: # keep colon
    Print "Hello"
End # keep untyped

If False
    Print "Goodbye"
Else
    Print "Hello"
End # keep untyped

If True: # keep colon
    Print "Hello"
End-If

If True
    Print "Hello"
End-If

If False
    Print "Goodbye"
Else: # keep colon
    Print "Hello"
End-If

If False
    Print "Goodbye"
Else
    Print "Hello"
End-If
