# Different "If" syntax

# VGR
If True Then # BASIC like
    Print "Hello"
End # keep untyped

If True: # keep colon
    Print "Hello"
End # keep untyped

If True
    Print "Hello"
End # keep untyped

If False
    Print "Goodbye"
Else: # keep colon
    Print "Hello"
End # keep untyped

If False
    Print "Goodbye"
Else
    Print "Hello"
End # keep untyped

If True: # keep colon
    Print "Hello"
End-If

If True
    Print "Hello"
End-If

If False
    Print "Goodbye"
Else: # keep colon
    Print "Hello"
End-If

If False
    Print "Goodbye"
Else
    Print "Hello"
End-If

# These check the syntax, not the execution
If False
    Print "Goodbye"
Else-If True # Hyphenated word
    Print "Hello"
End

If False
    Print "Goodbye"
ElseIf True Then # One word, never two
    Print "Hello"
End

If False
    Print "Goodbye"
Else-If False
    Print "Goodbye again"
Else-If True
    Print "Hello"
End

If False
    Print "Goodbye"
Else-If False
    Print "Goodbye again"
Else
    Print "Hello"
End
