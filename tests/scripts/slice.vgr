
Echo On
Constant s Is "abc"
Constant len Is s.StringLen()

Assert s.Slice() == s.Slice(None)
Assert s.Slice() == s.Slice(None, None)
Assert s.Slice() == s.Slice(None, None, None)

For i = 0 To s.StringLen()
    Assert s[i] == s.Slice(i, i + 1)
    Assert s.SubStr(i, 1) == s.Slice(i, i + 1)
    Assert s.RightStr(len - i) == s.Slice(i)
    Assert s.LeftStr(i) == s.Slice(0, i)
Next

For i = -1 To Negate(s.StringLen()) Step -1
    Assert s[i] == s.Slice(i, i - 1, -1)
    Assert s.SubStr(len + i, 1) == s.Slice(i, i - 1, -1)
    Assert s.RightStr(Abs(i)) == s.Slice(i)
    Assert s.LeftStr(len + i) == s.Slice(0, i)
Next

Constant data is [1, 2, 3]

Assert None.Head() == None
Assert 5.Head() == [5]
Assert data.Head() == data
Assert data.Head(0) == []
Assert data.Head(1) == [1]
Assert data.Head(2) == [1, 2]
Assert data.Head(-1) == [1, 2]

Assert None.Tail() == None
Assert 5.Tail() == [5]
Assert data.Tail() == data
Assert data.Tail(0) == []
Assert data.Tail(1) == [3]
Assert data.Tail(2) == [2, 3]
Assert data.Tail(-1) == [2, 3]
