
Echo On

Constant r Is r/a/
Constant s Is "abc"
Constant string_len Is s.StringLen()

# Nones
Assert Slice() == None
Assert None.Slice() == None
Assert None.Slice() == None
Assert None.Slice(0) == None

# Ordinal pass thru
Assert True.Slice(10) === True
Assert True[10] === True
Assert 1.Slice(20) === 1
Assert 1[20] === 1
Assert 1.2.Slice(30) === 1.2
Assert 1.2[30] === 1.2

# regex pass thru
Assert r.Slice(0) === r
Assert r[0] === r

# String slicing
Assert s.Slice() == s.Slice(None)
Assert s.Slice() == s.Slice(None, None)
Assert s.Slice() == s.Slice(None, None, None)

For i = 0 To string_len
    # Both the subscript notation and Slice() return strings
    Assert s[i]                       == s.Slice(i, i + 1)
    Assert s.LeftStr(i)               == s.Slice(0, i)
    Assert s.RightStr(string_len - i) == s.Slice(i)
    Assert s.SubStr(i, 1)             == s.Slice(i, i + 1)
Next

For i = -1 To Negate(string_len) Step -1
    Assert s[i]                        === s.Slice(i, i - 1, -1)
    Assert s.LeftStr(string_len + i)   === s.Slice(0, i)
    Assert s.RightStr(Abs(i))          === s.Slice(i)
    Assert s.SubStr(string_len + i, 1) === s.Slice(i, i - 1, -1)
Next

# Array slicing
Constant data Is [1, 2, 3]
Constant data_len Is data.Length()

For i = 0 To data_len
    # Subscript notation returns a single item where Slice() returns an array
    Assert data[i]                 === data.Slice(i, i + 1).FirstItem()
    Assert data.Tail(data_len - i) === data.Slice(i)
    Assert data.Head(i)            === data.Slice(0, i)
Next

For i = -1 To Negate(string_len) Step -1
    Assert data[i]               === data.Slice(i, i - 1, -1).FirstItem()
    Assert data.Head(i)          === data.Slice(0, i)
    Assert data.Tail(Abs(i))     === data.Slice(i)
Next

# Head: specialized version of slice
Assert None.Head() == None     # None check
Assert 5.Head() == [5]         # Ordinal becomes array
Assert data.Head() == data     # no length, all data
Assert data.Head(0) == []      # length of zero
Assert data.Head(1) == [1]     # length of one
Assert data.Head(2) == [1, 2]  # length of two
Assert data.Head(-1) == [1, 2] # length of N-1

# Tail: specialized version of slice
Assert None.Tail() == None # None check
Assert 5.Tail() == [5] # Ordinal becomes array
Assert data.Tail() == data     # no length, all data
Assert data.Tail(0) == []      # length of zero
Assert data.Tail(1) == [3]     # length of one
Assert data.Tail(2) == [2, 3]  # length of two
Assert data.Tail(-1) == [2, 3] # length of N-1
