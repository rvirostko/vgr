// -------------------------------------------------------------------------
// http_tests.vgr — HTTP Statement Test Script
// Tests parsing and execution against httpbin.org
// -------------------------------------------------------------------------

Define Function AssertResult(test_no):
    Call AssertReason(test_no, None)
    Call AssertStatus(test_no, http.status.ok)
End-Function

Define Function PrintPassed(test_no):
    Print "Test", test_no, "passed"
End-Function

Define Function AssertStatus(test_no, expected):
    Set received To http.result.status_code
    Print "Status Code"
    Print "\tReceived    :", Repr(received)
    Print "\tExpected    :", Repr(expected)
    Assert http.result.status_code == expected : "Test {}: Expected status code {!r}, got {!r}", test_no, expected, received
End-Function

Define Function AssertReason(test_no, expected):
    Set received To http.result.reason
    Print "Reason"
    Print "\tReceived    :", Repr(received)
    Print "\tExpected    :", Repr(expected)
    Assert received == expected : "Test {}: Expected reason {!r}, got {!r}", test_no, expected, received
End-Function

Define Function AssertAnyReason(test_no):
    Set received To http.result.reason
    Print "Reason"
    Print "\tReceived    :", Repr(received)
    Assert received Is Not None : "Test {}: Expected a reason, got {!r}", test_no, received
End-Function

Define Function CheckParam(test_no, key, expected):
    Set received To http.result.response.args.GetKeyValue(key)
    Print "Paramater", Repr(key)
    Print "\tReceived    :", Repr(received)
    Print "\tExpected    :", Repr(expected)
    Assert received == expected : "Test {}: For parameter {!r} expected {!r}, received {!r}", test_no, key, expected, received
End-Function

Define Function CheckHeader(test_no, key, expected):
    Set received To http.result.response.headers.GetKeyValue(key)
    Print "Header", Repr(key)
    Print "\tReceived    :", Repr(received)
    Print "\tExpected    :", Repr(expected)
    Assert received == expected : "Test {}: For header {!r} expected {!r}, received {!r}", test_no, key, expected, received
End-Function

Define Function CheckJson(test_no, key, expected):
    Set received To http.result.response.json.GetKeyValue(key)
    Print "Json", Repr(key)
    Print "\tReceived    :", Repr(received)
    Print "\tExpected    :", Repr(expected)
    Assert received == expected : "Test {}: For json key {!r} expected {!r}, received {!r}", test_no, key, expected, received
End-Function

Define Function CheckAuthenticated(test_no, expected):
    Set received To http.result.response.authenticated
    Print "Authenticated"
    Print "\tReceived    :", Repr(received)
    Print "\tExpected    :", Repr(expected)
    Assert received == expected : "Test {}: For authenticated expected {!r}, received {!r}", test_no, expected, received
End-Function

Set n To 1

// -------------------------------------------------------------------------
// Simple standalone GET
// -------------------------------------------------------------------------
Echo on
Http Get "https://httpbin.org/get"
Echo off
Call AssertResult(n)
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// GET with single parameters
// -------------------------------------------------------------------------
Echo on
Http Get "https://httpbin.org/get"
    Parameter "page=1"
    Parameter "q=hello world"
Echo off
Call AssertResult(n)
Call CheckParam(n, "page", "1")
Call CheckParam(n, "q", "hello world")
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// GET with bulk parameters
// -------------------------------------------------------------------------
Echo on
Http Get "https://httpbin.org/get"
    Parameters {
            "page": "2",
            "q": "bulk params"
    }
Echo off
Call AssertResult(n)
Call CheckParam(n, "page", "2")
Call CheckParam(n, "q", "bulk params")
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// GET with custom header — httpbin echoes headers back
// -------------------------------------------------------------------------
Echo on
Http Get "https://httpbin.org/headers" Header " X-Test-Header : HelloWorld "
Echo off
Call AssertResult(n)
Call CheckHeader(n, "X-Test-Header", "HelloWorld")
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// POST with JSON body
// -------------------------------------------------------------------------
Echo on
Http Post "https://httpbin.org/post" Body Is {"name": "alice", "role": "admin"} Header "Content-Type: application/json"
Echo off
Call AssertResult(n)
Call CheckJson(n, "name", "alice")
Call CheckJson(n, "role", "admin")
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// Basic auth
// -------------------------------------------------------------------------
Set user To "testuser"
Set password To "testpass"
Echo on
Http Get "https://httpbin.org/basic-auth/{}/{}".Format(user, password)
    User Is user
    Password Is password
    Auth Is Basic
Echo off
Call AssertResult(n)
Call CheckAuthenticated(n, True)
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// Basic auth - failure
// -------------------------------------------------------------------------
Set user To "testuser"
Set password To "testpass"
Echo on
Http Get "https://httpbin.org/basic-auth/{}/{}".Format(user, password)
    User Is user
    Password Is "BAD"
    # Auth Is Basic - this is the default
Echo off
Call AssertStatus(n, http.status.unauthorized)
Call CheckAuthenticated(n, None)
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// Digest auth
// -------------------------------------------------------------------------
Echo on
Http Get "https://httpbin.org/digest-auth/auth/{}/{}".Format(user, password)
    User Is user
    Password Is password
    Auth Is Digest
Echo off
Call AssertResult(n)
Call CheckAuthenticated(n, True)
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// Expected "not found" — reason should be set, script continues
// -------------------------------------------------------------------------
Echo on
Http Get URL Is "https://httpbin.org/status/404"
Echo off
Call AssertStatus(n, http.status.not_found)
Call AssertReason(n, "NOT FOUND")
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// Timeout — delay endpoint with short timeout
// expects transport failure result, not an exception
// -------------------------------------------------------------------------
Echo on
Http Get URL Is "https://httpbin.org/delay/5" Timeout Is 1
Echo off
Call AssertStatus(n, None)
Call AssertReason(n, "The read operation timed out")
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// Session connect, GET, disconnect
// -------------------------------------------------------------------------
Echo on
Http Connect "https://httpbin.org/" Timeout Is 10.0 As httpbin
Http Get URL Is "get" Using httpbin
Echo off
Call AssertResult(n)
Http Disconnect httpbin
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// Session with URL params — override one, keep one, add one
// -------------------------------------------------------------------------
Echo on
Http Connect "https://httpbin.org/?api_version=1&format=json"
    Timeout Is 10.0
    As httpbin
Http Get URL Is "get"
    Parameter "api_version=2"
    Parameter "page=1"
    Using httpbin
Echo off
Call AssertResult(n)
Call CheckParam(n, "format", "json") # From connect
Call CheckParam(n, "page", "1") # From request
Call CheckParam(n, "api_version", "2") # request overrides connect
Call PrintPassed(n)
Add 1 to n
Http Disconnect httpbin

// -------------------------------------------------------------------------
// Session with Basic auth
// -------------------------------------------------------------------------
Set user To "bob"
Set password To "secret"
Echo on
Http Connect "https://httpbin.org/"
    User Is user
    Password Is password
    Timeout Is 10.0
    As httpbin
# Credentials come from connect
Http Get "basic-auth/{}/{}".Format(user, password) Using httpbin
Echo off
Call AssertResult(n)
Call CheckAuthenticated(n, True)
Call PrintPassed(n)
Add 1 to n
Http Disconnect httpbin

// -------------------------------------------------------------------------
// Follow Redirects - off
// -------------------------------------------------------------------------
Echo on
Http Connect "https://httpbin.org/"
    Follow Redirects Is False
    As httpbin
Http Get "redirect/1" Using httpbin
Echo off
Call AssertStatus(n, http.status.found)
Call PrintPassed(n)
Add 1 to n
Http Disconnect httpbin

// -------------------------------------------------------------------------
// Follow Redirects - on, unlimited
// -------------------------------------------------------------------------
Echo on
Http Connect "https://httpbin.org/"
    Follow Redirects
    Timeout Is 30.0
    As httpbin
Http Get "redirect/3" Using httpbin
Echo off
Call AssertResult(n)
Call PrintPassed(n)
Add 1 to n
Http Disconnect httpbin

// -------------------------------------------------------------------------
// Follow Redirects - on, limited
// -------------------------------------------------------------------------
Echo on
Http Connect "https://httpbin.org/"
    Follow Redirects
    Timeout Is 30.0
    Max Redirects Is 3
    As httpbin
Http Get "redirect/4" Using httpbin
Echo off
Print http.result.FormatJson()
Call AssertStatus(n, None)
Call AssertReason(n, "Exceeded maximum allowed redirects")
Call PrintPassed(n)
Add 1 to n
Http Disconnect httpbin

// -------------------------------------------------------------------------
// DELETE
// -------------------------------------------------------------------------
Echo on
Http Delete URL Is "https://httpbin.org/delete"
Echo off
Call AssertResult(n)
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// PUT with body
// -------------------------------------------------------------------------
Echo on
Http Put URL Is "https://httpbin.org/put"
    Body Is { "key": "value" }
    Header "Content-Type: application/json"
Echo off
Call AssertResult(n)
Call CheckJson(n, "key", "value")
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// PATCH with body
// -------------------------------------------------------------------------
Echo on
Http Patch URL Is "https://httpbin.org/patch"
    Body Is { "status": "updated" }
    Header "Content-Type: application/json"
Echo off
Call AssertResult(n)
Call CheckJson(n, "status", "updated")
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// Giving tests - positive only
// -------------------------------------------------------------------------
# We can always restate the default and have it work
Echo on
Http Get "https://httpbin.org/get" Giving http.result
Echo off
Call AssertResult(n)
Call PrintPassed(n)
Add 1 to n

# We can specify our own writable var
Unset froboz
Assert froboz Is None
Echo on
Http Get "https://httpbin.org/get" Giving froboz
Echo off
Assert froboz Is Not None
Call PrintPassed(n)
Add 1 to n

// -------------------------------------------------------------------------
// HTTP version
// -------------------------------------------------------------------------
For-Each test_case in [[1, 1.1], [1.1, 1.1], [2, 2], [" 2 ", 2]]
    Assign test_case.FirstItem() To version
    Assign "HTTP/" + test_case.LastItem() To expected
    Echo on
    Http Connect "https://httpbin.org" HTTP-Version Is version As httpbin
    Http Get "get" Using httpbin
    Echo off
    Call AssertResult(n)
    Set received To http.result.http_version
    Print "HTTP version"
    Print "\tRequested   :", Repr(version)
    Print "\tReceived    :", Repr(received)
    Print "\tExpected    :", Repr(expected)
    Assert received == expected
    Call PrintPassed(n)
    Add 1 to n
End-For

// -------------------------------------------------------------------------
// Verify SSL
// -------------------------------------------------------------------------
For-Each host In [
        "expired.badssl.com",
        "self-signed.badssl.com",
        "wrong.host.badssl.com",
    ]:
    For-Each verify In [ True, False ]
        Echo on
        Http Connect "https://" + host Verify SSL Is verify Timeout Is 10.0 As ssl_test_conn
        Http Get URL Is "/" Using ssl_test_conn
        Echo off
        Printf "https://{} - Verify SSL is {}\n", host, verify
        If verify
            Call AssertStatus(n, None)
            Call AssertAnyReason(n)
        Else
            Call AssertStatus(n, http.status.ok)
            Call AssertReason(n, None)
        End-If
        Call PrintPassed(n)
        Add 1 to n
    End-For
End-For

Print "All tests passed"
