
Echo On
Assert Ord() Is None
Assert None.Ord() Is None
Assert -1.5.Ord() Is -1.5
Assert "cat".Ord() Is [99, 97, 116]
Assert ["c", "a", "t"].Ord() Is [99, 97, 116]
Assert Ord("cat") Is [99, 97, 116]
Assert Ord("c", "a", "t") Is [99, 97, 116]
Echo Off

Set d To {}
For Each c In ["c", "a", "t"]
    Set key c In d To c
End-For
Set e To d.Ord()
Print d.FormatJson() + Newline + e.FormatJson()

For Each k In e.GetKeys()
    Assert e.GetKeyValue(k).Chr() Is k
End-For

Set r To r/a/
Assert r.Ord() === r
