
Echo On

// Double quotes, standard escaping
Assert "".Length() == 0
Assert "abc".Length() == 3
Assert "a\"b".Length() == 3
Assert "a\\".Length() == 2
Assert "a\\\"b".Length() == 4
Assert "a\”b".Length() == 3 // non-standard escape

// Single quotes, standard escaping
Assert ''.Length() == 0
Assert 'abc'.Length() == 3
Assert 'a\'b'.Length() == 3
Assert 'a\\'.Length() == 2
Assert 'a\\\'b'.Length() == 4
Assert 'a\”b'.Length() == 3 // non-standard escape

// Double quotes, raw string
Assert r"".Length() == 0
Assert r"abc".Length() == 3
Assert r"abc\".Length() == 4
Assert r"a\b".Length() == 3
Assert r"a\”b".Length() == 4 // non-standard escape

// Single quotes, raw string
Assert r''.Length() == 0
Assert r'abc'.Length() == 3
Assert r'abc\'.Length() == 4
Assert r'a\b'.Length() == 3
Assert r'a\”b'.Length() == 4 // non-standard escape

// Double quotes, standard escaping
Assert """""".Length() == 0
Assert """abc""".Length() == 3
Assert """a\"b""".Length() == 3
Assert """a\\""".Length() == 2
Assert """a\\\"b""".Length() == 4
Assert """a
b""".Length() == 3
Assert """a\”b""".Length() == 3 // non-standard escape

// Single quotes, standard escaping
Assert ''''''.Length() == 0
Assert '''abc'''.Length() == 3
Assert '''a\"b'''.Length() == 3
Assert '''a\\'''.Length() == 2
Assert '''a\\\"b'''.Length() == 4
Assert '''a
b'''.Length() == 3
Assert '''a\”b'''.Length() == 3 // non-standard escape

# Double quotes, raw string
Assert r"""abc""".Length() == 3
Assert r"""""".Length() == 0
Assert r"""abc\""".Length() == 4
Assert r"""a\b""".Length() == 3
Assert r"""a
b\""".Length() == 4
Assert r"""a\”b""".Length() == 4 // non-standard escape

# Single quotes, raw string
Assert r'''abc'''.Length() == 3
Assert r''''''.Length() == 0
Assert r'''abc\'''.Length() == 4
Assert r'''a\b'''.Length() == 3
Assert r'''a
b\'''.Length() == 4
Assert r'''a\”b'''.Length() == 4 // non-standard escape

# Typographic double quotes
Assert “”.Length() == 0
Assert “abc”.Length() == 3
Assert “a\”b”.Length() == 3 // non-standard escape
Assert “a"b”.Length() == 3
Assert “a'b”.Length() == 3
Assert “a\\”.Length() == 2
Assert “a\\\”b”.Length() == 4 // non-stardard escape

Assert r“abc”.Length() == 3
Assert r“”.Length() == 0
Assert r“abc\”.Length() == 4
Assert r“a\b”.Length() == 3

# Typographic single quotes
Assert ‘’.Length() == 0
Assert ‘abc’.Length() == 3
Assert ‘a\’b’.Length() == 3 // non-stardard escape
Assert ‘a"b’.Length() == 3
Assert ‘a'b’.Length() == 3
Assert ‘a\\’.Length() == 2
Assert ‘a\\\’b’.Length() == 4 // non-stardard escape

Assert r‘abc’.Length() == 3
Assert r‘’.Length() == 0
Assert r‘abc\’.Length() == 4
Assert r‘a\b’.Length() == 3
