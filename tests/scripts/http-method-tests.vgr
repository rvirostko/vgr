// -------------------------------------------------------------------------
// http-method-tests.vgr — Method Test Script
// Tests all keyword methods and dynamic method handling
// Uses httpbin.org /anything which accepts any HTTP method
// and echoes back the method name under response.method
// -------------------------------------------------------------------------

Constant host Is "httpbin.org"
Constant anything_url Is "https://{}/anything".Format(host)

Constant TIMEOUT Is 30 # seconds
Constant DELAY Is 1/3 # seconds

Define Function CheckMethod(test_no, expected):
    If http.result.status_code Is http.status.method_not_allowed
        Set received To http.result.method
    Else
        Assert http.result.reason Is None : "Test {} failed: {}", test_no, http.result.reason
        Assert http.result.status_code == http.status.ok : "Test {}: Expected {}, got {}", test_no, http.status.ok, http.result.status_code
        Set received To http.result.response.method.DefaultTo(http.result.method)
    End-If
    Assert received == expected : "Test {}: Expected {!r}, received {!r}", test_no, expected, received
    Printf "Test {} passed: {}\n", test_no, expected
End-Function

// Using keywords
Set n To 1
Define Function NextTest()
    Add 1 To n
    Sleep DELAY
End-Function

/* 1 */
// Test Options AND remember what the server will allow */
Http Options anything_url Timeout Is TIMEOUT
Call CheckMethod(n, "OPTIONS")
Assign http.result.headers To headers
Constant allowed_methods Is DefaultTo(headers.Allow, headers.GetKeyValue("Access-Control-Allow-Methods")).Split(",").Strip().Upper()
Log Info "Allowed Methods: {}", allowed_methods
Assert allowed_methods Contains "OPTIONS" : "Test {}: Did not return OPTIONS", n
Call NextTest

/* 2 */
Assign "DELETE" To op
If op Is In allowed_methods
    Http Delete anything_url Timeout Is TIMEOUT
    Call CheckMethod(n, op)
Else
    Printf "Test {} skipped: {} not allowed\n", n, op
End-If
Call NextTest

/* 3 */
If "GET" Is In allowed_methods
    Http Get anything_url Timeout Is TIMEOUT
    Call CheckMethod(n, "GET")
Else
    Printf "Test {} skipped: {} not allowed\n", n, op
End-If
Call NextTest

/* 4 */
Assign "HEAD" To op
If op Is In allowed_methods
    Http Head "https://{}/get".Format(host) Timeout Is TIMEOUT
    Call CheckMethod(n, op)
Else
    Printf "Test {} skipped: {} not allowed\n", n, op
End-If
Call NextTest

/* 5 */
// NB: List is non-standard and hasn't been returned in allowed methods AND fails with a bad request
Assign "LIST" To op
If op Is In allowed_methods
    Http List anything_url Timeout Is TIMEOUT
    Call CheckMethod(n, op)
Else
    Printf "Test {} skipped: {} not allowed\n", n, op
End-If
Call NextTest

/* 6 */
Assign "PATCH" To op
If op Is In allowed_methods
    Http Patch anything_url Timeout Is TIMEOUT
    Call CheckMethod(n, op)
Else
    Printf "Test {} skipped: {} not allowed\n", n, op
End-If
Call NextTest

/* 7 */
Assign "POST" To op
If op Is In allowed_methods
    Http Post anything_url Timeout Is TIMEOUT
    Call CheckMethod(n, op)
Else
    Printf "Test {} skipped: {} not allowed\n", n, op
End-If
Call NextTest

/* 8 */
Assign "PUT" To op
If op Is In allowed_methods
    Http Put anything_url Timeout Is TIMEOUT
    Call CheckMethod(n, op)
Else
    Printf "Test {} skipped: {} not allowed\n", n, op
End-If
Call NextTest

/* 9 */
// NB: this hasn't been returned in allowed methods, BUT I've seen it work
Assign "TRACE" To op
If op Is In allowed_methods
    Http Trace anything_url Timeout Is TIMEOUT
    Call CheckMethod(n, op)
Else
    Printf "Test {} skipped: {} not allowed\n", n, op
End-If
Call NextTest

// Using dynamic specified methods

/* 10 */
// NB: This used to be "QUERY" which appears in allowed methods, BUT that method is a bad request
Assign "PUT" To op
If op Is In allowed_methods
    Http (Space + op + Space) anything_url Timeout Is TIMEOUT
    Call CheckMethod(n, op)
Else
    Printf "Test {} skipped: {} not allowed\n", n, op
End-If
Call NextTest

/* 11 */
Assign "GET" To op
If op Is In allowed_methods
    Http (Space + op.Lower()) anything_url Timeout Is TIMEOUT
    Call CheckMethod(n, op)
Else
    Printf "Test {} skipped: {} not allowed\n", n, op
End-If
Call NextTest

Print "All method tests passed"
