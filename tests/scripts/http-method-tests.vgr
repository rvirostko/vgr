// -------------------------------------------------------------------------
// http-method-tests.vgr — Method Test Script
// Tests all keyword methods and dynamic method handling
// Uses httpbin.org /anything which accepts any HTTP method
// and echoes back the method name under response.method
// -------------------------------------------------------------------------

Constant host Is "httpbin.org"
Constant anything_url Is "https://{}/anything".Format(host)

Constant TIMEOUT Is 30 # seconds
Constant DELAY Is 1/3 # seconds

Define Function CheckMethod(test_no, expected):
    If http.result.status_code Is http.status.method_not_allowed
        Set received To http.result.method
    Else
        Assert http.result.reason Is None : "Test {} failed: {}", test_no, http.result.reason
        Assert http.result.status_code == http.status.ok : "Test {}: Expected {}, got {}", test_no, http.status.ok, http.result.status_code
        Set received To http.result.response.method.DefaultTo(http.result.method)
    End-If
    Assert received == expected : "Test {}: Expected {!r}, received {!r}", test_no, expected, received
    Printf "Test {} passed: {}\n", test_no, expected
End-Function

// Using keywords
Set n To 1
Define Function NextTest()
    Add 1 To n
    Sleep DELAY
End-Function

Http Delete anything_url Timeout Is TIMEOUT                 Call CheckMethod(n, "DELETE")   Call NextTest
Http Get anything_url Timeout Is TIMEOUT                    Call CheckMethod(n, "GET")      Call NextTest
Http Head "https://{}/get".Format(host) Timeout Is TIMEOUT  Call CheckMethod(n, "HEAD")     Call NextTest
Http List anything_url Timeout Is TIMEOUT                   Call CheckMethod(n, "LIST")     Call NextTest
Http Options anything_url Timeout Is TIMEOUT                Call CheckMethod(n, "OPTIONS")
# Additional check
Assert http.result.headers.Allow.Split(",").Strip() Contains "OPTIONS" : "Test {}: Did not return OPTIONS", n  Call NextTest
Http Patch anything_url Timeout Is TIMEOUT                  Call CheckMethod(n, "PATCH")    Call NextTest
Http Post anything_url Timeout Is TIMEOUT                   Call CheckMethod(n, "POST")     Call NextTest
Http Put anything_url Timeout Is TIMEOUT                    Call CheckMethod(n, "PUT")      Call NextTest
Http Trace anything_url Timeout Is TIMEOUT                  Call CheckMethod(n, "TRACE")    Call NextTest

// Using dynamic methods
Http "purge" anything_url Timeout Is TIMEOUT                Call CheckMethod(n, "PURGE")    Call NextTest
Http " SEARCH " anything_url Timeout Is TIMEOUT             Call CheckMethod(n, "SEARCH")   Call NextTest
Http " get " anything_url Timeout Is TIMEOUT                Call CheckMethod(n, "GET")      Call NextTest

Print "All method tests passed"
