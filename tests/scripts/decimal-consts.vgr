Echo On

Define Function I(x) -> x.ExtractMatch(r/\d+/).match.ToInteger()
Define Function F(x) -> x.ExtractMatch(r/\d+/).match.ToFloat()

// Fullwidth
Assert １２３４５６７８９０ === 1234567890
Assert "１２３４５６７８９０" == 1234567890
Assert @I("１２３４５６７８９０") == 1234567890
Assert @F("１２３４５６７８９０") == 1234567890.0

// Arabic-Indic
Assert ١٢٣٤٥٦٧٨٩٠ === 1234567890
Assert "١٢٣٤٥٦٧٨٩٠" == 1234567890
Assert @I("١٢٣٤٥٦٧٨٩٠") === 1234567890
Assert @F("١٢٣٤٥٦٧٨٩٠") === 1234567890.0

// Extended Arabic-Indic
Assert ۱۲۳۴۵۶۷۸۹۰ === 1234567890
Assert "۱۲۳۴۵۶۷۸۹۰" == 1234567890
Assert @I("۱۲۳۴۵۶۷۸۹۰") === 1234567890
Assert @F("۱۲۳۴۵۶۷۸۹۰") === 1234567890.0

// Devanagari
Assert १२३४५६७८९० === 1234567890
Assert "१२३४५६७८९०" == 1234567890
Assert @I("१२३४५६७८९०") === 1234567890
Assert @F("१२३४५६७८९०") === 1234567890.0

