Assert "੧੨੩੪੫੬੭੮੯੦" == 1234567890
Assert @I("੧੨੩੪੫੬੭੮੯੦") === 1234567890
Assert @F("੧੨੩੪੫੬੭੮੯੦") === 1234567890.0

