Assert "૧૨૩૪૫૬૭૮૯૦" == 1234567890
Assert @I("૧૨૩૪૫૬૭૮૯૦") === 1234567890
Assert @F("૧૨૩૪૫૬૭૮૯૦") === 1234567890.0

