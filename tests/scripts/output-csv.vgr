
@Include DirectoryName(vgr.source.FirstItem()) + "/output-data.vgr"

Set env.OFS = ""

Print NewLine, "Debug Output", NewLine, bar
Debug On; Select $record From ["debug"] For CSV; Debug Off;
Print bar

Print NewLine, "Include Headers", NewLine, bar
Select $rec-index As "№", $record As "Data", Type($record) As "Type" From data For CSV Include Headers
Print bar

Print NewLine, "Exclude Headers", NewLine, bar
Select $rec-index As "№", $record As "Data", Type($record) As "Type" From data For CSV Exclude Headers
Print bar

For Each quoting_style In ["all", "minimal", "nonnumeric", "none",
    "default", // nonnumeric
    Space, // same as default
    None] // same as literal "none"
    Print NewLine, "Quoting Style {!r}".Format(quoting_style), NewLine, bar
    Select $rec-index As "№", $record As "Data", Type($record) As "Type" From data For CSV Quoting Style Is quoting_style
    Print bar
End-For
