// -------------------------------------------------------------------------
// http-body-tests.vgr — Body Test Script
// Tests body handling against httpbin.org /post endpoint
// httpbin echoes body under response.json (parsed) or response.data (raw)
// depending on content type
// -------------------------------------------------------------------------

Set host To "httpbin.org"
Set target_url To "https://{}/post".Format(host)

Define Function AssertResult(test_no):
    Assert http.result.reason Is None : "Test {} failed: {}", test_no, http.result.reason
    Assert http.result.status_code == http.status.ok : "Test {}: Expected {}, got {}", test_no, http.status.ok, http.result.status_code
End-Function

Define Function CheckDataResponse(test_no, expected, expected_type):
    Call AssertResult(test_no)
    Set received To http.result.response.data
    Set received_type To http.result.response.headers.GetKeyValue(http.header.content_type)
    Print "\tContent-Type:", Repr(received_type)
    Print "\tReceived    :", Repr(received)
    Print "\tExpected    :", Repr(expected)
    Assert received_type == expected_type : "Test {}: For data expected {!r} type, received {!r}", test_no, expected_type, received_type
    Assert received == expected : "Test {}: For data expected {!r}, received {!r}", test_no, expected, received
    Call PrintPassed(test_no)
    Return test_no + 1
End-Function

Define Function CheckJsonResponse(test_no, expected, expected_type):
    Call AssertResult(test_no)
    Set received To http.result.response.json
    Set received_type To http.result.response.headers.GetKeyValue(http.header.content_type)
    Print "\tContent-Type:", Repr(received_type)
    Print "\tReceived    :", Repr(received)
    Print "\tExpected    :", Repr(expected)
    Assert received_type == expected_type : "Test {}: For data expected {!r} type, received {!r}", test_no, expected_type, received_type
    Assert received == expected : "Test {}: For data expected {!r}, received {!r}", test_no, expected, received
    Call PrintPassed(test_no)
    Return test_no + 1
End-Function

Define Function PrintPassed(test_no):
    Print "Test", test_no, "passed"
End-Function

Set n To 1

// =========================================================================
// Ordinal types — no Content-Type specified
// All should default to text/plain, echo under response.data
// =========================================================================

// -------------------------------------------------------------------------
// Bool body — no Content-Type
// -------------------------------------------------------------------------
Set expected To True
Http Post target_url Body Is expected
Call CheckDataResponse(n, expected) Giving n

// -------------------------------------------------------------------------
// Int body — no Content-Type
// -------------------------------------------------------------------------
Set expected To 42
Http Post target_url Body Is expected
Call CheckDataResponse(n, expected) Giving n

// -------------------------------------------------------------------------
// Float body — no Content-Type
// -------------------------------------------------------------------------
Set expected To math.pi
Http Post target_url Body Is expected
Call CheckDataResponse(n, expected) Giving n

// -------------------------------------------------------------------------
// String body — no Content-Type
// -------------------------------------------------------------------------
Set expected To "Hello World!"
Http Post target_url Body Is expected
Call CheckDataResponse(n, expected) Giving n

// -------------------------------------------------------------------------
// Empty string body — no Content-Type
// -------------------------------------------------------------------------
Set expected To ""
Http Post target_url Body Is expected
Call CheckDataResponse(n, expected) Giving n

// -------------------------------------------------------------------------
// None body — no Content-Type, expect empty data
// -------------------------------------------------------------------------
Set expected To None
Http Post target_url Body Is expected
Call CheckDataResponse(n, "") Giving n

// =========================================================================
// JSON types — no Content-Type specified
// Should default to application/json, echo under response.json
// =========================================================================

// -------------------------------------------------------------------------
// Simple dict body — no Content-Type
// -------------------------------------------------------------------------
Set expected To { "name": "alice", "age": 30 }
Http Post target_url Body Is expected
Call CheckJsonResponse(n, expected) Giving n

// -------------------------------------------------------------------------
// Nested dict body — no Content-Type
// -------------------------------------------------------------------------
Set expected To { "a": { "b": 1 } }
Http Post target_url Body Is expected
Call CheckJsonResponse(n, expected) Giving n

// -------------------------------------------------------------------------
// Empty dict body — no Content-Type
// -------------------------------------------------------------------------
Set expected To { }
Http Post target_url Body Is expected
Call CheckJsonResponse(n, expected) Giving n

// -------------------------------------------------------------------------
// Simple list body — no Content-Type
// -------------------------------------------------------------------------
Set expected To [ "a", "b", "c" ]
Http Post target_url Body Is expected
Call CheckJsonResponse(n, expected) Giving n

// -------------------------------------------------------------------------
// Mixed list body — no Content-Type
// -------------------------------------------------------------------------
Set expected To [ 1, "two", True ]
Http Post target_url Body Is expected
Call CheckJsonResponse(n, expected) Giving n

// -------------------------------------------------------------------------
// Empty list body — no Content-Type
// -------------------------------------------------------------------------
Set expected To [ ]
Http Post target_url Body Is expected
Call CheckJsonResponse(n, expected) Giving n

// =========================================================================
// Section 3: Type conflict tests — explicit Content-Type overrides default
// =========================================================================

// -------------------------------------------------------------------------
// Dict body with text/plain — should dumps() and send as text
// -------------------------------------------------------------------------
# NB - because this is a string-like check, data needs to be kept simple
Set expected To { "key": "value" }
Set type To http.type.text
Http Post target_url Body Is expected Header "{}: {}".Format(http.header.content_type, type)
Call CheckDataResponse(n, expected.ToString(), type) Giving n

// -------------------------------------------------------------------------
// List body with text/plain — should dumps() and send as text
// -------------------------------------------------------------------------
Set expected To [1, 2, 3]
Set type To http.type.text
Http Post target_url Body Is expected Header "{}: {}".Format(http.header.content_type, type)
# Can't use "ToString()" here because it is distributive!
Call CheckDataResponse(n, expected.FormatJson(None), type) Giving n

// -------------------------------------------------------------------------
// None body with application/json — send "null", type stays JSON
// -------------------------------------------------------------------------
Set expected To None
Set type To http.type.json
Http Post target_url Body Is expected Header "{}: {}".Format(http.header.content_type, type)
Call CheckJsonResponse(n, expected, type) Giving n

// -------------------------------------------------------------------------
// Int body with application/json - retains int
// -------------------------------------------------------------------------
Set expected To 99
Set type To http.type.json
Http Post target_url Body Is expected Header "{}: {}".Format(http.header.content_type, type)
Call CheckJsonResponse(n, expected, type) Giving n

// -------------------------------------------------------------------------
// String body with application/octet-stream
// -------------------------------------------------------------------------
Set expected To ""
For c = 0 To 255: Set expected += Chr(c); Next
Assert expected.Length() == 256
Set type To http.type.binary
Http Post target_url Body Is expected Header "{}: {}".Format(http.header.content_type, type)
Call CheckDataResponse(n, expected, type) Giving n

// -------------------------------------------------------------------------
// Handle charset correctly and perform substitions for non-encodables
// -------------------------------------------------------------------------
Set body_value To "🎉 Hello World"
Set expected To body_value.ReplaceStr("🎉", "?")
For-Each charset In ["ascii", "latin-1", "cp1252"]
    Set type To http.type.text + "; charset=" + charset
    Http Post target_url Body Is body_value Header "{}: {}".Format(http.header.content_type, type)
    Call CheckDataResponse(n, expected, type) Giving n
End-For

Print "All body tests passed"
