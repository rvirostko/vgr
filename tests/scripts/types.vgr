
Set f(x) -> x

Assert None.Type() Is "none"
Assert "hello".Type() Is "string"
Assert 1.Type() Is "int"
Assert 1.0.Type() Is "float"
Assert [].Type() Is "list"
Assert {}.Type() Is "dictionary"
Assert CompilePattern("x").Type() Is "pattern"
Assert f.Type() Is "function"

Assert None.IsNone()
Assert None.IsNotNone() Is False
Assert "x".IsString()
Assert 1.IsInt()
Assert 1.0.IsFloat()
Assert 1.IsNumber() And 1.0.IsNumber()
Assert [].IsList()
Assert {}.IsDictionary()
Assert CompilePattern("x").IsPattern()
Assert f.IsFunction()
