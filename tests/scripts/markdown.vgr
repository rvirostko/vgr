
Echo On

Constant BLANK Is ""
Constant RE_TEXT = "abc"
Constant RE Is CompilePattern(RE_TEXT)
Constant EMPTY_LIST Is []
Constant EMPTY_DICT Is {}

Assert MdStrong() Is BLANK
Assert MdStrong(None) Is BLANK
Assert MdStrong(True) Is "**True**"
Assert MdStrong(5) Is "**5**"
Assert MdStrong(5.1) Is "**5.1**"
Assert MdStrong("frog") Is "**frog**"
Assert MdStrong(Space) Is BLANK
Assert MdStrong(RE) Is MdStrong(RE_TEXT)
Assert MdStrong(EMPTY_LIST) Is EMPTY_LIST
Assert MdStrong(["one", "two"]) Is ["**one**", "**two**"]
Assert MdStrong("one", "two") Is ["**one**", "**two**"]
Assert MdStrong(EMPTY_DICT) Is EMPTY_DICT
Assert MdStrong({"one": 1, "two": 2}) Is {"one": "**1**", "two": "**2**"}

Assert MdEmphasis() Is BLANK
Assert MdEmphasis(None) Is BLANK
Assert MdEmphasis(True) Is "*True*"
Assert MdEmphasis(5) Is "*5*"
Assert MdEmphasis(5.1) Is "*5.1*"
Assert MdEmphasis("frog") Is "*frog*"
Assert MdEmphasis(RE) Is MdEmphasis(RE_TEXT)
Assert MdEmphasis(Space) Is BLANK
Assert MdEmphasis(EMPTY_LIST) Is EMPTY_LIST
Assert MdEmphasis(["one", "two"]) Is ["*one*", "*two*"]
Assert MdEmphasis("one", "two") Is ["*one*", "*two*"]
Assert MdEmphasis(EMPTY_DICT) Is EMPTY_DICT
Assert MdEmphasis({"one": 1, "two": 2}) Is {"one": "*1*", "two": "*2*"}

Assert MdStrikeThrough() Is BLANK
Assert MdStrikeThrough(None) Is BLANK
Assert MdStrikeThrough(True) Is "~~True~~"
Assert MdStrikeThrough(5) Is "~~5~~"
Assert MdStrikeThrough(5.1) Is "~~5.1~~"
Assert MdStrikeThrough("frog") Is "~~frog~~"
Assert MdStrikeThrough(RE) Is MdStrikeThrough(RE_TEXT)
Assert MdStrikeThrough(Space) Is BLANK
Assert MdStrikeThrough(EMPTY_LIST) Is EMPTY_LIST
Assert MdStrikeThrough(["one", "two"]) Is ["~~one~~", "~~two~~"]
Assert MdStrikeThrough("one", "two") Is ["~~one~~", "~~two~~"]
Assert MdStrikeThrough(EMPTY_DICT) Is EMPTY_DICT
Assert MdStrikeThrough({"one": 1, "two": 2}) Is {"one": "~~1~~", "two": "~~2~~"}

Assert MdCode() Is BLANK
Assert MdCode(None) Is BLANK
Assert MdCode(True) Is "`True`"
Assert MdCode(5) Is "`5`"
Assert MdCode(5.1) Is "`5.1`"
Assert MdCode("frog") Is "`frog`"
Assert MdCode(RE) Is MdCode(RE_TEXT)
Assert MdCode(Space) Is BLANK
Assert MdCode(EMPTY_LIST) Is EMPTY_LIST
Assert MdCode(["one", "two"]) Is ["`one`", "`two`"]
Assert MdCode("one", "two") Is ["`one`", "`two`"]
Assert MdCode(EMPTY_DICT) Is EMPTY_DICT
Assert MdCode({"one": 1, "two": 2}) Is {"one": "`1`", "two": "`2`"}

# Default level of 1
Assert MdHeading() Is BLANK
Assert MdHeading(None) Is BLANK
Assert MdHeading(True) Is "# True\n"
Assert MdHeading(5) Is "# 5\n"
Assert MdHeading(5.1) Is "# 5.1\n"
Assert MdHeading("frog") Is "# frog\n"
Assert MdHeading(RE) Is "# " + RE_TEXT + Newline
Assert MdHeading(Space) Is BLANK
Assert MdHeading(EMPTY_LIST) Is EMPTY_LIST
Assert MdHeading(["one", "two"]) Is ["# one\n", "# two\n"]
Assert MdHeading("one", "two") Is ["# one\n", "# two\n"]
Assert MdHeading(EMPTY_DICT) Is EMPTY_DICT
Assert MdHeading({"one": 1, "two": 2}) Is {"one": "# 1\n", "two": "# 2\n"}

# Specific level
Assert MdHeading("frog", 3) Is "### frog\n"
Assert MdHeading("one", "two", 4) Is ["#### one\n", "#### two\n"]

# Level range (1 to 6) and conversions
Assert MdHeading("frog", 0) Is "# frog\n"
Assert MdHeading("frog", 17) Is "###### frog\n"
Assert MdHeading("frog", 2.6) Is "## frog\n"
Assert MdHeading("frog", False) Is "# frog\n"

Assert MdBlockQuote() Is BLANK
Assert MdBlockQuote(None) Is BLANK
Assert MdBlockQuote(True) Is "\n> True\n"
Assert MdBlockQuote(5) Is "\n> 5\n"
Assert MdBlockQuote(5.1) Is "\n> 5.1\n"
Assert MdBlockQuote("frog") Is "\n> frog\n"
Assert MdBlockQuote(RE) Is MdBlockQuote(RE_TEXT)
Assert MdBlockQuote(Space) Is BLANK
Assert MdBlockQuote(EMPTY_LIST) Is BLANK
Assert MdBlockQuote(["one", "two"]) Is "\n> one\n> two\n"
Assert MdBlockQuote("one", "two") Is "\n> one\n> two\n"
Assert MdBlockQuote("one\ntwo") Is "\n> one\n> two\n"
Assert MdBlockQuote(EMPTY_DICT) Is EMPTY_DICT
Assert MdBlockQuote({"one": 1, "two": 2}) Is {"one": "\n> 1\n", "two": "\n> 2\n"}

Assert MdUnorderedList() Is BLANK
Assert MdUnorderedList(None) Is BLANK
Assert MdUnorderedList(True) Is "\n- True\n"
Assert MdUnorderedList(5) Is "\n- 5\n"
Assert MdUnorderedList(5.1) Is "\n- 5.1\n"
Assert MdUnorderedList("frog") Is "\n- frog\n"
Assert MdUnorderedList(RE) Is MdUnorderedList(RE_TEXT)
Assert MdUnorderedList(Space) Is BLANK
Assert MdUnorderedList(EMPTY_LIST) Is BLANK
Assert MdUnorderedList(["one", "two"]) Is "\n- one\n- two\n"
Assert MdUnorderedList("one", "two") Is "\n- one\n- two\n"
Assert MdUnorderedList("one\ntwo") Is "\n- one\n- two\n"
Assert MdUnorderedList(EMPTY_DICT) Is EMPTY_DICT
Assert MdUnorderedList({"one": 1, "two": 2}) Is {"one": "\n- 1\n", "two": "\n- 2\n"}

Assert MdOrderedList() Is BLANK
Assert MdOrderedList(None) Is BLANK
Assert MdOrderedList(True) Is "\n1. True\n"
Assert MdOrderedList(5) Is "\n1. 5\n"
Assert MdOrderedList(5.1) Is "\n1. 5.1\n"
Assert MdOrderedList("frog") Is "\n1. frog\n"
Assert MdOrderedList(RE) Is MdOrderedList(RE_TEXT)
Assert MdOrderedList(Space) Is BLANK
Assert MdOrderedList(EMPTY_LIST) Is BLANK
Assert MdOrderedList(["one", "two"]) Is "\n1. one\n1. two\n"
Assert MdOrderedList("one", "two") Is "\n1. one\n1. two\n"
Assert MdOrderedList("one\ntwo") Is "\n1. one\n1. two\n"
Assert MdOrderedList(EMPTY_DICT) Is EMPTY_DICT
Assert MdOrderedList({"one": 1, "two": 2}) Is {"one": "\n1. 1\n", "two": "\n1. 2\n"}

Assert MdCodeBlock() Is BLANK
Assert MdCodeBlock(None) Is BLANK
Assert MdCodeBlock(True) Is "\n```\nTrue\n```\n\n"
Assert MdCodeBlock(5) Is "\n```\n5\n```\n\n"
Assert MdCodeBlock(5.1) Is "\n```\n5.1\n```\n\n"
Assert MdCodeBlock("frog") Is "\n```\nfrog\n```\n\n"
Assert MdCodeBlock(RE) Is MdCodeBlock(RE_TEXT)
Assert MdCodeBlock(Space) Is BLANK
Assert MdCodeBlock(EMPTY_LIST) Is BLANK
Assert MdCodeBlock(["one", "two"]) Is
    "\n```\none\ntwo\n```\n\n"
Assert MdCodeBlock(None, "one", "two") Is  # NB: A bit ugly...
    "\n```\none\ntwo\n```\n\n"
Assert MdCodeBlock(1, "two") Is
    "\n```\n1\ntwo\n```\n\n"
Assert MdCodeBlock("one\ntwo") Is
    "\n```\none\ntwo\n```\n\n"
Assert MdCodeBlock(EMPTY_DICT) Is EMPTY_DICT
Assert MdCodeBlock({"one": 1, "two": 2}) Is
    {"one": "\n```\n1\n```\n\n", "two": "\n```\n2\n```\n\n"}

# Sample Uses
Echo off

Printf Newline
For level = 1 To 6
    Print MdHeading("Heading " + level, level) As Markdown
Next

# ToDo MdLink() - Format the text in Markdown as a link

Printf Newline
Print "Strong".MdStrong() As Markdown
Print "Emphasis".MdEmphasis() As Markdown
Print "Strike through".MdStrikeThrough() As Markdown
Print "Code".MdCode() As Markdown

Set colors = ["red", "green", "blue"]

Printf Newline
Print "Colors".MdCode(), "-", MdEmphasis(colors).Join(", ") As Markdown
Printf Newline
Print MdEmphasis("Colors Code block") + Newline +
    MdCodeBlock("vgr", "Set colors = " + colors.Repr()) As Markdown
Print MdEmphasis("Colors Unordered List") + Newline + MdUnorderedList(colors.TitleCase()) As Markdown
Printf Newline
Print MdEmphasis("Colors Ordered List") + Newline + MdOrderedList(Sort(colors.TitleCase())) As Markdown
Printf Newline
Print MdEmphasis("Colors Block Quote") + Newline + MdBlockQuote(colors.TitleCase()) As Markdown
Printf Newline
