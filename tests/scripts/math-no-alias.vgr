
# Test: when you attempt to get an alias to
# an immutable variable, you actually get
# a mutable copy

Exhibit math

# t is a mutable copy
Set t To math
Exhibit t
For Each k In t.GetKeys()
    Assert t.GetKeyValue(k) Equals math.GetKeyValue(k)
End-For

Echo On
Unset t.pi
Set t.new_var To "frog"
Echo Off
Exhibit t
Echo On
Assert math.pi Is Defined
Assert math.new_var Is Undefined
Assert t.pi is Undefined
Assert t.new_var Is Defined
