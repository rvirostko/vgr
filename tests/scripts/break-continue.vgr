
# Test general and specific "break" and "continue" usage
# in all control loops. These are all positive tests.
# Assertions are placed in "dead code" locations to make
# sure the statements take the correct action.

Declare continued, broke

Define Function start_test(name):
    Print name
    Set continued To False
    Set broke To False
End-Function

Define Function end_test():
    Assert continued : "Test never hit Continue"
    Assert broke : "Test never hit Break"
End-Function

Call start_test("For Next (BASIC, block=For)")
For x = 1 To 3
    If $loop.first
        Set continued To True
        Continue-For
        Assert False: "Continue-For failed"
    Else
        Set broke To True
        Break-For
        Assert False: "Break-For failed"
    End-If
    Assert False: "Reached unexpected location"
Next
Call end_test()

Call start_test("For Each (Basic, block=for)")
For Each x In [1, 2, 3]
    If $loop.first
        Set continued To True
        Continue-For
        Assert False: "Continue-For failed"
    Else
        Set broke To True
        Break-For
        Assert False: "Break For failed"
    End-If
    Assert False: "Reached unexpected location"
Next
Call end_test()

Call start_test("For Next (VGR)")
For x = 1 To 3
    If $loop.first
        Set continued To True
        Continue
        Assert False: "Continue failed"
    Else
        Set broke To True
        Break
        Assert False: "Break failed"
    End-If
    Assert False: "Reached unexpected location"
Next
Call end_test()

Call start_test("Repeat Times (VGR)")
Repeat 3 Times:
    If $loop.first
        Set continued To True
        Continue
        Assert False: "Continue failed"
    Else
        Set broke To True
        Break
        Assert False: "Break failed"
    End-If
    Assert False: "Reached unexpected location"
End-Repeat
Call end_test()

Call start_test("Until (VGR)")
Until False
    If $loop.first
        Set continued To True
        Continue
        Assert False: "Continue failed"
    Else
        Set broke To True
        Break
        Assert False: "Break failed"
    End-If
    Assert False: "Reached unexpected location"
End-Until
Call end_test()

Call start_test("While (VGR)")
While True
    If $loop.first
        Set continued To True
        Continue
        Assert False: "Continue failed"
    Else
        Set broke To True
        Break
        Assert False: "Break failed"
    End-If
    Assert False: "Reached unexpected location"
End-While
Call end_test()

Call start_test("While (VGR, block=While)")
While True
    If $loop.first
        Set continued To True
        Continue-While
        Assert False: "Continue While failed"
    Else
        Set broke To True
        Break-While
        Assert False: "Break-While failed"
    End-If
    Assert False: "Reached unexpected location"
End-While
Call end_test()

Call start_test("For-Each (VGR)")
For-Each x In [1, 2, 3] : # keep single keyword form
    If $loop.first
        Set continued To True
        Continue
        Assert False: "Continue failed"
    Else
        Set broke To True
        Break
        Assert False: "Break failed"
    End-If
    Assert False: "Reached unexpected location"
End # keep untyped
Call end_test()

Call start_test("For-Each (VGR, block=for)")
For-Each x In [1, 2, 3]
    If $loop.first
        Set continued To True
        Continue-For
        Assert False: "Continue-For failed"
    Else
        Set broke To True
        Break-For
        Assert False: "Break-For failed"
    End-If
    Assert False: "Reached unexpected location"
End-For
Call end_test()
