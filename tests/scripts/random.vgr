
//-----------------------------------------------------------------------------
Assert Random().IsFloat()
Assert Random(2).IsInteger()
Assert Random(2, 3).IsInteger()

Constant i_array = [1, 2, 3, 4]
Repeat 100 Times
    Assert Random().IsBetween(0, 1)
    Assert Random(3).IsBetween(0, 3)
    Assert Random(1, 3).IsBetween(1, 3)
    Assert Random(3, 1).IsBetween(1, 3)
    Set r_array = Random(i_array, i_array[-1])
    For i = 0 To r_array.Length()
        Assert r_array[i].IsBetween(i_array[i], i_array[-1])
    End-For
    // An "unrolled" version, which is reconstituted into an array
    Set r_array = Random(i_array[0], i_array[1], i_array[2], i_array[3], i_array[-1])
    For i = 0 To r_array.Length()
        Assert r_array[i].IsBetween(i_array[i], i_array[-1])
    End-For
End-Repeat

//-----------------------------------------------------------------------------
Assert RandomChoice() Is None
Assert RandomChoice(None) Is None
Assert RandomChoice("frog") Is "frog"
Assert RandomChoice({}) Is None
Assert RandomChoice([]) Is None

Repeat 100 Times
    Assert RandomChoice(1, 2).IsBetween(1, 2)
    Assert RandomChoice([1, 2]).IsBetween(1, 2)
    Set d = RandomChoice({"a": 1, "b": 2})
    Assert d[0].IsBetween("a", "b")
    Assert d[1].IsBetween(1, 2)
End-Repeat

//-----------------------------------------------------------------------------
Assert RandomSample() Is None
Assert RandomSample(None) Is None
Assert RandomSample("frog") Is "frog"
Assert RandomSample({}) Is []
Assert RandomSample([]) Is []
Assert RandomSample(["hello"]) Is ["hello"]
Assert RandomSample(["goodbye"], "1") Is ["goodbye"]

//-----------------------------------------------------------------------------
// Set up data for RandomSample() testing
Set population To []
Repeat 100 Times
    Set t To {}
    For Each color In ["red", "green", "blue"]
        Set Key color In t To Random(0, 255)
    End-For
    Append t To population
End-Repeat
Constant population
Constant population_size Is population.Length()

Define Constant Function validate_sample(sample)
    Assert sample.IsList()
    For Each item In sample
        Assert item.IsDictionary()
        Assert item.ContainsAll(["red", "green", "blue"])
        Assert item Is In population
    End-For
End-Function

//-----------------------------------------------------------------------------
# Request a fraction of population size
Set sample_size To Pred(1.0)
While sample_size > -.05
    # This mimics the internal math
    Set expected_sample_size To Max(0, Ceil(population_size * sample_size).ToInteger())
    Printf "Requested {:.2f}%, expected {}\n", sample_size * 100, expected_sample_size
    Set sample To population.RandomSample(sample_size)
    Call validate_sample(sample)
    Assert sample.Length() == expected_sample_size
    Assert (sample === population) Is False
    Assert population_size == population.Length()
    Subtract Random() / 17 From sample_size
End-While

//-----------------------------------------------------------------------------
# Request a fixed size sample
# Under and overflow included in the sizes
Set sample_size To population.Length() + 1
While sample_size >= -3
    Set expected_sample_size To sample_size.Clamp(0, population_size)
    Printf "Requested {}, expected {}\n", sample_size, expected_sample_size
    Set sample To population.RandomSample(sample_size)
    Call validate_sample(sample)
    Assert sample.Length() == expected_sample_size
    Assert (sample === population) Is False
    Assert population_size == population.Length()
    Subtract Random(1, 3) From sample_size
End-While
