
# Test out various syntax options for BASIC loops

Tron

# Do While
Let x = 0
While x < 1: # keep colon
    Let x = x + 1
End

Let x = 0
While x < 1
    Let x = x + 1
End  # keep untyped

# Do Until
Let x = 0
Until x == 1: # keep colon
    Let x = x + 1
End

Let x = 0
Until x == 1
    Let x = x + 1
End  # keep untyped

# For-Next
For x = 0 To 1: # keep colon
    NOP
Next

For x = 0 To 1
    NOP
Next

For x = 0 To 1
    NOP
End  # keep untyped

# For-Next w/By
For x = 0 To 1 Step 1: # keep colon
    NOP
Next

For x = 0 To 1 Step 1
    NOP
Next

For x = 0 To 1 Step 1
    NOP
End  # keep untyped

# For-Each
For-Each x In [1, 2]: # keep colon
    NOP
Next

For-Each x In [1, 2]
    NOP
Next

For-Each x In [1, 2]
    NOP
End # keep as end
