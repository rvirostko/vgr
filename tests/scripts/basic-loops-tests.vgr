
# Test out various syntax options for loops

Echo On

# While
Set x To Zero
While x < 1: # colon optional
    Set x To x + 1
End

Set x To Zero
While x < 1
    Set x To x + 1
End  # keep untyped

# Until
Set x To Zero
Until x == 1: # colon optional
    Set x To x + 1
End

Set x To Zero
Until x == 1
    Set x To x + 1
End  # keep untyped

# For Next
For x = Zero To 1: # colon optional
    NOP
Next

For x = Zero To 1
    NOP
Next

For x = Zero To 1
    NOP
End  # keep untyped

# For Next w/By
For x = Zero To 1 Step 1: # colon optional
    NOP
Next

For x = Zero To 1 Step 1
    NOP
Next

For x = Zero To 1 Step 1
    NOP
End  # keep untyped

# For Each
For Each x In [1, 2]: # colon optional
    NOP
Next

For Each x In [1, 2]
    NOP
Next

For Each x In [1, 2] # keep as for-each
    NOP
End # keep as end
