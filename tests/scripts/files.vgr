
Constant EMPTY_LIST Is []
Constant RE_TEXT Is "ab/c"
Constant RE Is CompilePattern(RE_TEXT)

# Assumes we are running from dev root
Constant SAMPLES_DIR = "samples"
Constant SAMPLE_10PRINT = SAMPLES_DIR + os.sep + "10print.vgr"

Echo On

Constant CWD Is GetCurrentDirectory()
Print CWD
Assert CWD Is Not None And CWD.IsString() And CWD.IsNotEmpty()
# Variable arguments allowed, but ignored
Assert GetCurrentDirectory(None) Equals GetCurrentDirectory("anything", "something")

Assert ExpandPath() Is None
Assert ExpandPath(None) Is None
Assert ExpandPath(True) Is CWD + os.sep + True.Repr()
Assert ExpandPath(Zero) Is CWD + os.sep + Zero.Repr()
Assert ExpandPath(5.1) Is CWD + os.sep + 5.1.Repr()
Assert ExpandPath("") Is CWD
Assert ExpandPath("frog") Is CWD + os.sep + "frog"
Assert ExpandPath("a_dir/frog") Is CWD + os.sep + "a_dir/frog"
Assert ExpandPath(EMPTY_LIST) Is EMPTY_LIST
Assert ExpandPath("one", "two") Is [CWD + os.sep + "one", CWD + os.sep + "two"]
Assert ExpandPath(["one", "two"]) Is [CWD + os.sep + "one", CWD + os.sep + "two"]
Assert ExpandPath(RE) Is CWD + os.sep + RE_TEXT

Assert BaseName() Is None
Assert BaseName(None) Is None
Assert BaseName(True) Is True.Repr()
Assert BaseName(Zero) Is Zero.Repr()
Assert BaseName(5.1) Is 5.1.Repr()
Assert Basename("") Is ""
Assert BaseName("frog") Is "frog"
Assert BaseName("a_dir/frog") Is "frog"
Assert BaseName(EMPTY_LIST) Is EMPTY_LIST
Assert BaseName("one", "two") Is ["one", "two"]
Assert BaseName(["one", "two"]) Is ["one", "two"]
Assert BaseName(RE) Is RE_TEXT.Split("/").LastItem()

Assert DirectoryName() Is None
Assert DirectoryName(None) Is None
Assert DirectoryName(True) Is CWD
Assert DirectoryName(Zero) Is CWD
Assert DirectoryName(5.1) Is CWD
Assert DirectoryName("") Is CWD.RSplit("/", 1).FirstItem()
Assert DirectoryName("frog") Is CWD
Assert DirectoryName("a_dir/frog") Is CWD + os.sep + "a_dir"
Assert DirectoryName(EMPTY_LIST) Is EMPTY_LIST
Assert DirectoryName("one", "two") Is [CWD, CWD]
Assert DirectoryName(["one", "two"]) Is [CWD, CWD]
Assert DirectoryName(RE) Is CWD + os.sep + RE_TEXT.Split("/").FirstItem()

Assert PathExists() Is None
Assert PathExists(None) Is None
Assert PathExists(True) Is False
Assert PathExists(Zero) Is False
Assert PathExists(5.1) Is False
Assert PathExists("") Is True # same as CWD
Assert PathExists(".") Is True
Assert PathExists(SAMPLES_DIR) Is True
Assert PathExists(SAMPLE_10PRINT) Is True
Assert PathExists(EMPTY_LIST) Is EMPTY_LIST
Assert PathExists("one", "two") Is [False, False]
Assert PathExists(["one", "two"]) Is [False, False]
Assert PathExists(RE) Is False

Assert IsFile() Is None
Assert IsFile(None) Is None
Assert IsFile(True) Is False
Assert IsFile(Zero) Is False
Assert IsFile(5.1) Is False
Assert IsFile("") Is False # same as CWD
Assert IsFile(".") Is False
Assert IsFile(SAMPLES_DIR) Is False
Assert IsFile(SAMPLE_10PRINT) Is True
Assert IsFile(EMPTY_LIST) Is EMPTY_LIST
Assert IsFile("one", "two") Is [False, False]
Assert IsFile(["one", "two"]) Is [False, False]
Assert IsFile(RE) Is False

Assert IsDirectory() Is None
Assert IsDirectory(None) Is None
Assert IsDirectory(True) Is False
Assert IsDirectory(Zero) Is False
Assert IsDirectory(5.1) Is False
Assert IsDirectory("") Is True # same as CWD
Assert IsDirectory(".") Is True
Assert IsDirectory(SAMPLES_DIR) Is True
Assert IsDirectory(SAMPLE_10PRINT) Is False
Assert IsDirectory(EMPTY_LIST) Is EMPTY_LIST
Assert IsDirectory("one", "two") Is [False, False]
Assert IsDirectory(["one", "two"]) Is [False, False]
Assert IsDirectory(RE) Is False

Assert RemoveFile() Is None
Assert RemoveFile(None) Is None
Assert RemoveFile(True)[0] Is False
Assert RemoveFile(Zero)[0] Is False
Assert RemoveFile(5.1)[0] Is False
Assert RemoveFile("")[0] Is False # same as CWD
Assert RemoveFile(".")[0] Is False
Set fname To "./RemoveFileTest-{:x}.dat".Format(Random(500_000))
Open Output File fname; Print fname; Close Output
Assert RemoveFile(fname)[0] Is True
Assert RemoveFile(EMPTY_LIST) Is EMPTY_LIST
Assert RemoveFile("one", "two").IsList()
Assert RemoveFile(["one", "two"]).IsList()
Assert RemoveFile(RE)[0] Is False

Assert GetFileInfo() Is None
Assert GetFileInfo(None) Is None
Assert GetFileInfo(True).found Is False
Assert GetFileInfo(Zero).found Is False
Assert GetFileInfo(5.1).found Is False
Set info To GetFileInfo("")  # same as CWD
Assert info.found Is True
Assert info.type Is "directory"
Assert info.path Is CWD
Set info To GetFileInfo(".")
Assert info.found Is True
Assert info.type Is "directory"
Assert info.path Is CWD
Set info To GetFileInfo(SAMPLE_10PRINT)
Assert info.found Is True
Assert info.type Is "file"
Assert info.suffix Is ".vgr"
Assert GetFileInfo(EMPTY_LIST) Is EMPTY_LIST
# Do not have to exist to be parsed
Set info To GetFileInfo("A:command.com")
Assert info.found Is False
Assert info.type Is None
Assert info.suffix Is ".com"
Set info To GetFileInfo("foo.tar.gz")
Assert info.found Is False
Assert info.type Is None
Assert info.suffixes Is [".tar", ".gz"]
Assert GetFileInfo("one", "two").IsList()
Assert GetFileInfo(["one", "two"]).IsList()
Assert GetFileInfo(RE).found Is False
